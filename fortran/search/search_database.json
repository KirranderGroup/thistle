inant-pair\nalgorithm (one 64-bit word per spin).  d1, d2 are C-ordered [p,q] and [p,q,r,s]. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: ndet integer(kind=c_int), intent(in), value :: norb integer(kind=c_int), intent(in), value :: nw integer(kind=c_int64_t), intent(in) :: wa (nw,ndet) integer(kind=c_int64_t), intent(in) :: wb (nw,ndet) real(kind=c_double), intent(in) :: c (ndet) integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: d1 (norb,norb) real(kind=c_double), intent(out) :: d2 (norb,norb,norb,norb) integer(kind=c_int), intent(out) :: ierr Variables Type Visibility Attributes Name Initial integer, public :: nt integer, public :: e Source Code subroutine pyxscat_rdm12_bitwise ( ndet , norb , nw , wa , wb , c , nthreads , d1 , d2 , ierr ) & bind ( C , name = 'pyxscat_rdm12_bitwise' ) integer ( c_int ), value , intent ( in ) :: ndet , norb , nw , nthreads integer ( c_int64_t ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( c_double ), intent ( in ) :: c ( ndet ) real ( c_double ), intent ( out ) :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer ( c_int ), intent ( out ) :: ierr integer :: nt , e nt = nthreads if ( nt <= 0 ) nt = omp_get_max_threads () call rdm12_bitwise ( int ( ndet ), int ( norb ), int ( nw ), wa , wb , c , d1 , d2 , nt , e ) ierr = e end subroutine pyxscat_rdm12_bitwise","tags":"","url":"proc/pyxscat_rdm12_bitwise.html"},{"title":"pyxscat_rdm12_bitwise_groups – PyXSCAT kernels","text":"public  subroutine pyxscat_rdm12_bitwise_groups(ndet, norb, nw, wa, wb, c, nint, ng, gstart, grp, nnb, nbstart, nb, nthreads, d1, d2, ierr) bind(C, name='pyxscat_rdm12_bitwise_groups') rdm12_bitwise restricted to candidate pairs: determinants sorted into ng groups with the\nneighbour lists nb (see xs_rdm); dm2 elements with all four orbitals >= nint are skipped. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: ndet integer(kind=c_int), intent(in), value :: norb integer(kind=c_int), intent(in), value :: nw integer(kind=c_int64_t), intent(in) :: wa (nw,ndet) integer(kind=c_int64_t), intent(in) :: wb (nw,ndet) real(kind=c_double), intent(in) :: c (ndet) integer(kind=c_int), intent(in), value :: nint integer(kind=c_int), intent(in), value :: ng integer(kind=c_int), intent(in) :: gstart (ng+1) integer(kind=c_int), intent(in) :: grp (ndet) integer(kind=c_int), intent(in), value :: nnb integer(kind=c_int), intent(in) :: nbstart (ng+1) integer(kind=c_int), intent(in) :: nb (nnb) integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: d1 (norb,norb) real(kind=c_double), intent(out) :: d2 (norb,norb,norb,norb) integer(kind=c_int), intent(out) :: ierr Variables Type Visibility Attributes Name Initial integer, public :: nt integer, public :: e Source Code subroutine pyxscat_rdm12_bitwise_groups ( ndet , norb , nw , wa , wb , c , nint , ng , gstart , grp , nnb , nbstart , nb , & nthreads , d1 , d2 , ierr ) bind ( C , name = 'pyxscat_rdm12_bitwise_groups' ) integer ( c_int ), value , intent ( in ) :: ndet , norb , nw , nint , ng , nnb , nthreads integer ( c_int64_t ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( c_double ), intent ( in ) :: c ( ndet ) integer ( c_int ), intent ( in ) :: gstart ( ng + 1 ), grp ( ndet ), nbstart ( ng + 1 ), nb ( nnb ) real ( c_double ), intent ( out ) :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer ( c_int ), intent ( out ) :: ierr integer :: nt , e nt = nthreads if ( nt <= 0 ) nt = omp_get_max_threads () call rdm12_bitwise_groups ( int ( ndet ), int ( norb ), int ( nw ), wa , wb , c , int ( nint ), int ( ng ), gstart , grp , & int ( nnb ), nbstart , nb , d1 , d2 , nt , e ) ierr = e end subroutine pyxscat_rdm12_bitwise_groups","tags":"","url":"proc/pyxscat_rdm12_bitwise_groups.html"},{"title":"pyxscat_build_info – PyXSCAT kernels","text":"public  subroutine pyxscat_build_info(buf, n) bind(C, name='pyxscat_build_info') Compiler and options the library was built with (for bug reports): copied into buf. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(out) :: buf (n) integer(kind=c_int), intent(in), value :: n Variables Type Visibility Attributes Name Initial character(len=:), public, allocatable :: s integer, public :: i Source Code subroutine pyxscat_build_info ( buf , n ) bind ( C , name = 'pyxscat_build_info' ) integer ( c_int ), value , intent ( in ) :: n character ( kind = c_char ), intent ( out ) :: buf ( n ) character ( len = :), allocatable :: s integer :: i s = compiler_version () // ' | ' // compiler_options () buf = c_null_char do i = 1 , min ( len ( s ), n - 1 ) buf ( i ) = s ( i : i ) end do end subroutine pyxscat_build_info","tags":"","url":"proc/pyxscat_build_info.html"},{"title":"bessels0rr – PyXSCAT kernels","text":"public  subroutine bessels0rr(h_sum, order, mu, H, h_saved) Radial sum of the quartet kernel for one pair distance H and every q in mu: h_sum(q) = sum_b h_saved(b+1) j_b(H q) (q/H)&#94;b, with closed forms for order <= 3 and Miller's backward recurrence (dphrec_opt) above. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), dimension(size(mu)) :: h_sum integer(kind=ikind), intent(in) :: order real(kind=dp), intent(in), dimension(:), allocatable :: mu real(kind=dp), intent(in) :: H real(kind=dp), intent(in), dimension(:) :: h_saved Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: beta integer(kind=ikind), public :: nq integer(kind=ikind), public :: lrec integer(kind=ikind), public :: i real(kind=dp), public, dimension(size(mu)) :: pmu real(kind=dp), public, dimension(size(mu)) :: sinpmu real(kind=dp), public, dimension(size(mu)) :: cospmu real(kind=dp), public, dimension(size(mu)) :: invpmu real(kind=dp), public, dimension(size(mu)) :: h_1 real(kind=dp), public, dimension(size(mu)) :: h_2 real(kind=dp), public, dimension(size(mu)) :: h_3 real(kind=dp), public, dimension(:,:), allocatable :: allbessels real(kind=dp), public, dimension(:), allocatable :: h_scaled real(kind=dp), public :: invpmu_power Source Code subroutine bessels0rr ( h_sum , order , mu , H , h_saved ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) integer ( kind = ikind ), intent ( in ) :: order real ( kind = dp ), dimension (:), intent ( in ) :: h_saved real ( kind = dp ), dimension (:), intent ( in ), allocatable :: mu real ( kind = dp ), intent ( in ) :: H real ( kind = dp ), dimension ( size ( mu )), intent ( out ) :: h_sum integer ( kind = ikind ) :: beta , nq , lrec , i real ( kind = dp ), dimension ( size ( mu )) :: pmu , sinpmu , cospmu , invpmu real ( kind = dp ), dimension ( size ( mu )) :: h_1 , h_2 , h_3 real ( kind = dp ), dimension (:,:), allocatable :: allbessels real ( kind = dp ), dimension (:), allocatable :: h_scaled real ( kind = dp ) :: invpmu_power nq = size ( mu ) Pmu = H * mu sinpmu = sin ( pmu ) cospmu = cos ( pmu ) ! ---------------------------------------------------------- ! Guard against Pmu ~ 0  (q -> 0 limit) ! j_0(x) -> 1 - x&#94;2/6 + ... ! For higher orders, j_l(x) -> x&#94;l / (2l+1)!! which is tiny ! ---------------------------------------------------------- h_sum = 0.0_dp do i = 1 , nq if ( abs ( pmu ( i )) < 1.0e-15_dp ) then ! Only j_0 contributes; higher orders are ~0 h_sum ( i ) = h_saved ( 1 ) else h_sum ( i ) = ( sinpmu ( i ) / pmu ( i )) * h_saved ( 1 ) end if end do if ( order == 0 ) return ! invpmu = mu/H  (scaling factor, NOT 1/Pmu) ! Used as: invpmu&#94;beta = (mu/H)&#94;beta if ( abs ( H ) > 1.0e-30_dp ) then invpmu = mu / H else invpmu = 0.0_dp end if ! ---------------------------------------------------------- ! Low-order explicit formulas (order 1-3) ! These avoid the dphrec overhead for the most common cases ! ---------------------------------------------------------- if ( order == 1 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_sum = h_sum + h_saved ( 2 ) * h_1 return else if ( order == 2 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_2 = (( 3.0_dp / Pmu ** 3 - 1.0_dp / Pmu ) * sinpmu & - 3.0_dp / Pmu ** 2 * cospmu ) * invpmu ** 2 h_sum = h_sum + h_saved ( 2 ) * h_1 + h_saved ( 3 ) * h_2 return else if ( order == 3 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_2 = (( 3.0_dp / Pmu ** 3 - 1.0_dp / Pmu ) * sinpmu & - 3.0_dp / Pmu ** 2 * cospmu ) * invpmu ** 2 h_3 = ( pmu * ( - 1 5.0_dp + pmu ** 2 ) * cospmu & + 3.0_dp * ( 5.0_dp - 2.0_dp * pmu ** 2 ) * sinpmu ) & / pmu ** 4 * invpmu ** 3 h_sum = h_sum + h_saved ( 2 ) * h_1 + h_saved ( 3 ) * h_2 & + h_saved ( 4 ) * h_3 return end if ! ---------------------------------------------------------- ! General case: order >= 4 ! Use right-sized backward recurrence ! ---------------------------------------------------------- ! Miller's algorithm requires l_start > max(|x|) + buffer. ! The argument x = Pmu = H*mu can be large for distant pairs ! at high q. The standard criterion for double precision is: !   l_start >= max(|x|) + C * max(|x|)&#94;(1/3) + 15 ! where C ~ 4-5. We use a conservative formula. ! The original code used 100, which fails for |Pmu| > ~85. ! ---------------------------------------------------------- block real ( kind = dp ) :: xmax xmax = maxval ( abs ( pmu )) lrec = max ( int ( xmax + 5.0_dp * xmax ** ( 1.0_dp / 3.0_dp ) + 20 ), order + 20 ) ! Safety floor: never go below original 100 for large arguments if ( xmax > 5 0.0_dp ) lrec = max ( lrec , 120 ) ! Safety ceiling: cap to prevent absurd allocation lrec = min ( lrec , 500 ) end block allocate ( allbessels ( lrec , nq )) call dphrec_opt ( pmu , allbessels , lrec , order + 1 , nq ) ! ---------------------------------------------------------- ! Final summation: h_sum += Sum_{beta=1}&#94;{order} !   allbessels(beta+1, :) * invpmu&#94;beta * h_saved(beta+1) ! ! Restructure as matrix-vector multiply: !   Scale each row of allbessels by invpmu&#94;beta * h_saved(beta+1) !   Then sum rows -> h_sum ! ! For moderate order (4-16) and nq (50-200), explicit loop ! with pre-scaled coefficients is faster than DGEMV overhead. ! ---------------------------------------------------------- do beta = 1 , order ! h_saved(beta+1) * invpmu&#94;beta applied element-wise h_sum = h_sum + allbessels ( beta + 1 , :) * invpmu ** beta * h_saved ( beta + 1 ) end do deallocate ( allbessels ) end subroutine bessels0rr","tags":"","url":"proc/bessels0rr.html"},{"title":"dphrec_opt – PyXSCAT kernels","text":"public  subroutine dphrec_opt(x, rbes, leps1, lmax1, nq) Right-sized backward recurrence for spherical Bessel functions Miller's algorithm: start backward recurrence from l = leps1,\nnormalise against known values of cos(x) and the Wronskian. The caller must ensure leps1 >= max(|x|) + buffer for all\nx values in the array. A buffer of ~20 + 5*|x|&#94;(1/3) gives\ndouble-precision accuracy. leps1 is the starting order of the backward recurrence and lmax1 the number of Bessel\nfunctions returned (j_0 ... j_{lmax1-1}). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in), dimension(nq) :: x real(kind=dp), intent(out), dimension(leps1, nq) :: rbes integer, intent(in) :: leps1 integer, intent(in) :: lmax1 integer, intent(in) :: nq Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) real(kind=dp), public, dimension(nq) :: xx real(kind=dp), public, dimension(nq) :: cx real(kind=dp), public, dimension(nq) :: sx real(kind=dp), public, dimension(nq) :: a_norm real(kind=dp), public, dimension(nq) :: cu real(kind=dp), public :: w integer, public :: k integer, public :: lu Source Code subroutine dphrec_opt ( x , rbes , leps1 , lmax1 , nq ) implicit none INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) integer , intent ( in ) :: leps1 , lmax1 , nq real ( kind = dp ), dimension ( nq ), intent ( in ) :: x real ( kind = dp ), dimension ( leps1 , nq ), intent ( out ) :: rbes real ( kind = dp ), dimension ( nq ) :: xx , cx , sx , a_norm , cu real ( kind = dp ) :: w integer :: k , lu xx = x * x rbes = 0.0_dp ! Seed values for backward recurrence rbes ( leps1 , :) = 1.0_dp if ( leps1 > 1 ) rbes ( leps1 - 1 , :) = 1.0_dp cx = cos ( x ) sx = sin ( x ) ! Backward recurrence (Miller's algorithm) do k = 3 , leps1 lu = leps1 - k + 2 rbes ( lu - 1 , :) = rbes ( lu , :) - xx / ( 4.0_dp * lu * lu - 1.0_dp ) * rbes ( lu + 1 , :) end do ! Normalisation using Wronskian: f(0)*g(1) - x&#94;2/3 * f(1)*cos(x) ! where g(1) = cos(x) + x*sin(x) a_norm = rbes ( 1 , :) * ( cx + x * sx ) - xx / 3.0_dp * rbes ( 2 , :) * cx do k = 1 , leps1 rbes ( k , :) = rbes ( k , :) / a_norm end do ! Scale by x&#94;l / (2l+1)!! to convert to actual j_l(x) cu = 1.0_dp / x do k = 1 , lmax1 w = 2.0_dp * ( k - 1 ) cu = x / ( w + 1.0_dp ) * cu rbes ( k , :) = cu * rbes ( k , :) end do end subroutine dphrec_opt","tags":"","url":"proc/dphrec_opt.html"},{"title":"rrdj0 – PyXSCAT kernels","text":"public  subroutine rrdj0(lmax, x, a) Expansion coefficients for one Cartesian coordinate. Early return for lmax = 0 (s-shell, very common). Arguments Type Intent Optional Attributes Name integer, intent(in) :: lmax real(kind=dp), intent(in) :: x real(kind=dp), intent(out), dimension(BDIM_MAX, BDIM_MAX) :: a Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = selected_real_kind(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: l integer(kind=ikind), public :: p Source Code subroutine rrdj0 ( lmax , x , a ) integer , parameter :: dp = selected_real_kind ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) integer , intent ( in ) :: lmax integer ( kind = ikind ) :: l , p real ( kind = dp ), intent ( in ) :: x real ( kind = dp ), dimension ( BDIM_MAX , BDIM_MAX ), intent ( out ) :: a a = 0.0_dp a ( 1 , 1 ) = 1.0_dp ! Early exit for s-type (lmax=0) if ( lmax == 0 ) return a ( 2 , 2 ) = - x ! p=0 column do l = 2 , lmax a ( l + 1 , 1 ) = - ( l - 1 ) * a ( l - 1 , 1 ) end do ! General recurrence do l = 2 , lmax do p = 1 , l a ( l + 1 , p + 1 ) = - ( l - 1 ) * a ( l - 1 , p + 1 ) - x * a ( l , p ) end do end do end subroutine rrdj0","tags":"","url":"proc/rrdj0.html"},{"title":"BesselDeriv – PyXSCAT kernels","text":"public  subroutine BesselDeriv(BD, LL, MM, NN, a, b, c, LLmax) Combines the three coordinate expansions. Unchanged from original (already well-screened).\nThe screening on C1, C2 avoids unnecessary inner iterations. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(LLmax + 1) :: BD integer(kind=ikind), intent(in) :: LL integer(kind=ikind), intent(in) :: MM integer(kind=ikind), intent(in) :: NN real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: a real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: b real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: c integer(kind=ikind), intent(in) :: LLmax Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: ii integer(kind=ikind), public :: jj integer(kind=ikind), public :: kk integer(kind=ikind), public :: hOrder integer(kind=ikind), public :: temp integer(kind=ikind), public :: ceil real(kind=dp), public :: C1 real(kind=dp), public :: C2 real(kind=dp), public :: C3 real(kind=dp), public :: Ct2 real(kind=dp), public :: Ct3 Source Code subroutine BesselDeriv ( BD , LL , MM , NN , a , b , c , LLmax ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( kind = ikind ), INTENT ( in ) :: LL , MM , NN , LLmax REAL ( kind = dp ), INTENT ( out ), DIMENSION ( LLmax + 1 ) :: BD REAL ( kind = dp ), INTENT ( in ), DIMENSION ( BDIM_MAX , BDIM_MAX ) :: a , b , c INTEGER ( kind = ikind ) :: ii , jj , kk , hOrder , temp , ceil REAL ( kind = dp ) :: C1 , C2 , C3 , Ct2 , Ct3 BD = 0.0_dp do ii = 0 , LL C1 = a ( LL + 1 , ii + 1 ) if ( abs ( C1 ) < 1.0E-30 ) cycle do jj = 0 , MM Ct2 = b ( MM + 1 , jj + 1 ) if ( abs ( Ct2 ) < 1.0E-30 ) cycle C2 = C1 * Ct2 do kk = 0 , NN Ct3 = c ( NN + 1 , kk + 1 ) if ( abs ( Ct3 ) < 1.0E-30 ) cycle C3 = C2 * Ct3 temp = LL + MM + NN - ii - jj - kk ceil = temp / 2_ikind + mod ( temp , 2_ikind ) hOrder = ceil + ii + jj + kk BD ( hOrder + 1 ) = BD ( hOrder + 1 ) + C3 end do end do end do end subroutine BesselDeriv","tags":"","url":"proc/besselderiv.html"},{"title":"BesselSum – PyXSCAT kernels","text":"public  subroutine BesselSum(h_sum, mu, H, LLmax, h_saved) Forward recurrence variant of bessels0rr (kept for compatibility). Warning: forward recurrence for j_l(x) is numerically unstable\nfor l > x. Use bessels0rr (backward recurrence) for production. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(size(mu)) :: h_sum real(kind=dp), intent(in), DIMENSION(:), allocatable :: mu real(kind=dp), intent(in) :: H integer(kind=ikind), intent(in) :: LLmax real(kind=dp), intent(in), DIMENSION(LLmax + 1) :: h_saved Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) real(kind=dp), public, DIMENSION(size(mu)) :: Pmu real(kind=dp), public, DIMENSION(size(mu)) :: h_0 real(kind=dp), public, DIMENSION(size(mu)) :: h_1 real(kind=dp), public, DIMENSION(size(mu)) :: h_r real(kind=dp), public, DIMENSION(size(mu)) :: muOH real(kind=dp), public :: coeff integer(kind=ikind), public :: ra Source Code subroutine BesselSum ( h_sum , mu , H , LLmax , h_saved ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( kind = dp ), INTENT ( in ), DIMENSION (:), allocatable :: mu REAL ( kind = dp ), INTENT ( in ) :: H INTEGER ( kind = ikind ), INTENT ( in ) :: LLmax REAL ( kind = dp ), INTENT ( in ), DIMENSION ( LLmax + 1 ) :: h_saved REAL ( kind = dp ), INTENT ( out ), DIMENSION ( size ( mu )) :: h_sum REAL ( kind = dp ), DIMENSION ( size ( mu )) :: Pmu , h_0 , h_1 , h_r , muOH REAL ( kind = dp ) :: coeff INTEGER ( kind = ikind ) :: ra Pmu = H * mu h_0 = sin ( Pmu ) / Pmu coeff = h_saved ( 1 ) h_sum = h_0 * coeff if ( LLmax == 1 ) then h_1 = ( sin ( Pmu ) / Pmu ** 2 - cos ( Pmu ) / Pmu ) * mu / H coeff = h_saved ( 2 ) h_sum = h_sum + coeff * h_1 else if ( LLmax > 1 ) then muOH = mu / H h_1 = ( sin ( Pmu ) / Pmu ** 2 - cos ( Pmu ) / Pmu ) * muOH coeff = h_saved ( 2 ) h_sum = h_sum + coeff * h_1 do ra = 2 , LLmax coeff = h_saved ( ra + 1 ) h_r = (( 2 * ra - 1 ) / ( Pmu ) * h_1 - h_0 * muOH ) * muOH h_sum = h_sum + h_r * coeff h_0 = h_1 h_1 = h_r end do end if end subroutine BesselSum","tags":"","url":"proc/besselsum.html"},{"title":"dfact – PyXSCAT kernels","text":"public pure function dfact(n) Double factorial n!! as a real (1 for n <= 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: n Return Value real(kind=dp) Variables Type Visibility Attributes Name Initial integer(kind=ikind), public :: k","tags":"","url":"proc/dfact.html"},{"title":"two_electron_j0 – PyXSCAT kernels","text":"public  subroutine two_electron_j0(nprim, ncontr, nq, x, y, z, ga, l, m, n, group, contr, coeff, qin, mode, zbig, da, db, wc, wx, nkc, ac, bc, nkx, ax, bx, dgemm_ptr, cutoffcentre, cutoffz, cutoffmd, screen_tol, lorder, tsi, stats, ierr) The two-electron term I2(q) at every q of qin (lorder = 0), or its j2 P2 moment (lorder = 2),\nfor the density provider selected by mode (see the module description).  tsi receives the\nresult, stats the screening counts (shell quartets total/kept, primitive quartets total/kept);\nierr = 0 on success, 1-8 for an inconsistent input (sizes, modes, l beyond the Bessel tables,\nnon-contiguous groups). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: ncontr integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: qin (nq) integer(kind=ikind), intent(in) :: mode real(kind=dp), intent(in), pointer :: zbig (:,:,:,:) real(kind=dp), intent(in) :: da (ncontr,ncontr) real(kind=dp), intent(in) :: db (ncontr,ncontr) real(kind=dp), intent(in) :: wc real(kind=dp), intent(in) :: wx integer(kind=ikind), intent(in) :: nkc real(kind=dp), intent(in) :: ac (nkc,ncontr,ncontr) real(kind=dp), intent(in) :: bc (nkc,ncontr,ncontr) integer(kind=ikind), intent(in) :: nkx real(kind=dp), intent(in) :: ax (nkx,ncontr,ncontr) real(kind=dp), intent(in) :: bx (nkx,ncontr,ncontr) type(c_funptr), intent(in) :: dgemm_ptr real(kind=dp), intent(in) :: cutoffcentre real(kind=dp), intent(in) :: cutoffz real(kind=dp), intent(in) :: cutoffmd real(kind=dp), intent(in) :: screen_tol integer(kind=ikind), intent(in) :: lorder real(kind=dp), intent(out) :: tsi (nq) real(kind=dp), intent(out) :: stats (4) integer(kind=ikind), intent(out) :: ierr Variables Type Visibility Attributes Name Initial real(kind=dp), public, allocatable :: q (:) real(kind=dp), public, allocatable :: p0matrix (:,:,:,:) real(kind=dp), public, allocatable, target :: ddx (:,:,:,:,:) real(kind=dp), public, allocatable, target :: ddy (:,:,:,:,:) real(kind=dp), public, allocatable, target :: ddz (:,:,:,:,:) real(kind=dp), public, allocatable :: px (:,:) real(kind=dp), public, allocatable :: py (:,:) real(kind=dp), public, allocatable :: pz (:,:) real(kind=dp), publi