 N + 1 ) = ( 14 3.0_dp / 3009949984698909 0.0_dp ) * q ** 4 6.0_dp else print * , \"Limits of derivatives of j_2 P_2 are only implemented up to g-functions.\" , L , M , N stop endif !P0=P0*sqrt(5.0_dp/pi) END SUBROUTINE P_LMN_j2","tags":"","url":"proc/p_lmn_j2.html"},{"title":"Bubble_Sort – PyXSCAT kernels","text":"public  subroutine Bubble_Sort(a) Sorts the integer array a in ascending order (bubble sort, early exit when already sorted). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(inout), DIMENSION(:) :: a Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: temp integer, public :: i integer, public :: j logical, public :: swapped Source Code SUBROUTINE Bubble_Sort ( a ) implicit none INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( kind = ikind ), INTENT ( inout ), DIMENSION (:) :: a INTEGER ( kind = ikind ) :: temp INTEGER :: i , j LOGICAL :: swapped DO j = SIZE ( a ) - 1 , 1 , - 1 swapped = . FALSE . DO i = 1 , j IF ( a ( i ) > a ( i + 1 )) THEN temp = a ( i ) a ( i ) = a ( i + 1 ) a ( i + 1 ) = temp swapped = . TRUE . END IF END DO IF (. NOT . swapped ) EXIT END DO END SUBROUTINE Bubble_Sort","tags":"","url":"proc/bubble_sort.html"},{"title":"hermite_pair – PyXSCAT kernels","text":"public pure subroutine hermite_pair(la, lb, pa, pb, p, e) Hermite coefficients E(t; i, j) for one primitive pair and one direction (Gaussian\nprefactor excluded, E(0;0,0) = 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: la integer(kind=ikind), intent(in) :: lb real(kind=dp), intent(in) :: pa real(kind=dp), intent(in) :: pb real(kind=dp), intent(in) :: p real(kind=dp), intent(out) :: e (0:la+lb+1,0:la,0:lb) Variables Type Visibility Attributes Name Initial real(kind=dp), public :: w (-1:la+lb+2,0:la,0:lb) integer(kind=ikind), public :: i integer(kind=ikind), public :: j integer(kind=ikind), public :: t real(kind=dp), public :: a2 Source Code pure subroutine hermite_pair ( la , lb , pa , pb , p , e ) integer ( kind = ikind ), intent ( in ) :: la , lb real ( kind = dp ), intent ( in ) :: pa , pb , p real ( kind = dp ), intent ( out ) :: e ( 0 : la + lb + 1 , 0 : la , 0 : lb ) ! work array padded in t (see xs_hermite: no guarded loads in the recurrence) real ( kind = dp ) :: w ( - 1 : la + lb + 2 , 0 : la , 0 : lb ) integer ( kind = ikind ) :: i , j , t real ( kind = dp ) :: a2 a2 = 0.5_dp / p w = 0.0_dp w ( 0 , 0 , 0 ) = 1.0_dp do i = 0 , la - 1 do t = 0 , i + 1 w ( t , i + 1 , 0 ) = a2 * w ( t - 1 , i , 0 ) + pa * w ( t , i , 0 ) + real ( t + 1 , dp ) * w ( t + 1 , i , 0 ) end do end do do j = 0 , lb - 1 do i = 0 , la do t = 0 , i + j + 1 w ( t , i , j + 1 ) = a2 * w ( t - 1 , i , j ) + pb * w ( t , i , j ) + real ( t + 1 , dp ) * w ( t + 1 , i , j ) end do end do end do e = w ( 0 : la + lb + 1 , :, :) end subroutine hermite_pair","tags":"","url":"proc/hermite_pair.html"},{"title":"pair_transform – PyXSCAT kernels","text":"public  subroutine pair_transform(nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, qv, screen, f, ierr) F(q, mu, nu) for every scattering vector qv(:, iq) and every pair of contracted functions,\ninto the complex array f(nq, nao, nao).  Primitive-shell pairs whose Gaussian prefactor\n(times the largest coefficients) is below screen are skipped; ierr = 0 on success. Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: nao integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: qv (3,nq) real(kind=dp), intent(in) :: screen complex(kind=dp), intent(out) :: f (nq,nao,nao) integer(kind=ikind), intent(out) :: ierr Variables Type Visibility Attributes Name Initial integer(kind=ikind), public :: ng integer(kind=ikind), public :: g integer(kind=ikind), public :: i integer(kind=ikind), public :: a integer(kind=ikind), public :: b integer(kind=ikind), public :: gi integer(kind=ikind), public :: gj integer(kind=ikind), public :: lmax integer(kind=ikind), public :: iq integer(kind=ikind), public :: t integer(kind=ikind), public :: u integer(kind=ikind), public :: v integer(kind=ikind), public :: ca integer(kind=ikind), public :: cb integer(kind=ikind), public, allocatable :: gstart (:) integer(kind=ikind), public, allocatable :: gcount (:) integer(kind=ikind), public, allocatable :: lg (:) real(kind=dp), public, allocatable :: cmax (:) real(kind=dp), public :: pi real(kind=dp), public :: p real(kind=dp), public :: px real(kind=dp), public :: py real(kind=dp), public :: pz real(kind=dp), public :: kab real(kind=dp), public :: pref real(kind=dp), public :: cc real(kind=dp), public, allocatable :: ex (:,:,:) real(kind=dp), public, allocatable :: ey (:,:,:) real(kind=dp), public, allocatable :: ez (:,:,:) complex(kind=dp), public, allocatable :: g0 (:) complex(kind=dp), public, allocatable :: iqx (:,:) complex(kind=dp), public, allocatable :: iqy (:,:) complex(kind=dp), public, allocatable :: iqz (:,:) complex(kind=dp), public, allocatable :: acc (:) complex(kind=dp), public :: ci Source Code subroutine pair_transform ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , qv , & screen , f , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: qv ( 3 , nq ), screen complex ( kind = dp ), intent ( out ) :: f ( nq , nao , nao ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , iq , t , u , v , ca , cb integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:) real ( kind = dp ), allocatable :: cmax (:) real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc real ( kind = dp ), allocatable :: ex (:, :, :), ey (:, :, :), ez (:, :, :) complex ( kind = dp ), allocatable :: g0 (:), iqx (:, :), iqy (:, :), iqz (:, :), acc (:) complex ( kind = dp ) :: ci ierr = 0 f = ( 0.0_dp , 0.0_dp ) pi = acos ( - 1.0_dp ) ci = ( 0.0_dp , 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return end if end do allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), cmax ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) end if gcount ( g ) = gcount ( g ) + 1 end do do g = 1 , ng cmax ( g ) = maxval ( abs ( coeff ( gstart ( g ): gstart ( g ) + gcount ( g ) - 1 ))) end do lmax = maxval ( lg ) ! powers (i q)&#94;t for every q allocate ( iqx ( nq , 0 : 2 * lmax ), iqy ( nq , 0 : 2 * lmax ), iqz ( nq , 0 : 2 * lmax )) iqx (:, 0 ) = 1.0_dp ; iqy (:, 0 ) = 1.0_dp ; iqz (:, 0 ) = 1.0_dp do t = 1 , 2 * lmax iqx (:, t ) = iqx (:, t - 1 ) * ci * qv ( 1 , :) iqy (:, t ) = iqy (:, t - 1 ) * ci * qv ( 2 , :) iqz (:, t ) = iqz (:, t - 1 ) * ci * qv ( 3 , :) end do ! Threads split the primitive-shell pairs; several pairs feed the same contracted ! element, so the accumulation into f is serialised (it is a small part of the work). !$OMP PARALLEL default(shared) private(gi, gj, a, b, p, px, py, pz, kab, pref, ex, ey, ez, & !$OMP& g0, acc, t, u, v, ca, cb, cc, iq) allocate ( ex ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ey ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ez ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax )) allocate ( g0 ( nq ), acc ( nq )) !$OMP DO schedule(dynamic) do gi = 1 , ng do gj = gi , ng a = gstart ( gi ); b = gstart ( gj ) p = ga ( a ) + ga ( b ) kab = exp ( - ga ( a ) * ga ( b ) / p * (( x ( a ) - x ( b )) ** 2 + ( y ( a ) - y ( b )) ** 2 + ( z ( a ) - z ( b )) ** 2 )) pref = ( pi / p ) ** 1.5_dp * kab if ( pref * cmax ( gi ) * cmax ( gj ) * ( 1.0_dp + real ( lg ( gi ) + lg ( gj ), dp )) < screen ) cycle px = ( ga ( a ) * x ( a ) + ga ( b ) * x ( b )) / p py = ( ga ( a ) * y ( a ) + ga ( b ) * y ( b )) / p pz = ( ga ( a ) * z ( a ) + ga ( b ) * z ( b )) / p call hermite_pair ( lg ( gi ), lg ( gj ), px - x ( a ), px - x ( b ), p , ex ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), py - y ( a ), py - y ( b ), p , ey ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), pz - z ( a ), pz - z ( b ), p , ez ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) do iq = 1 , nq g0 ( iq ) = pref * exp ( - ( qv ( 1 , iq ) ** 2 + qv ( 2 , iq ) ** 2 + qv ( 3 , iq ) ** 2 ) / ( 4.0_dp * p )) & * exp ( ci * ( qv ( 1 , iq ) * px + qv ( 2 , iq ) * py + qv ( 3 , iq ) * pz )) end do do a = gstart ( gi ), gstart ( gi ) + gcount ( gi ) - 1 do b = gstart ( gj ), gstart ( gj ) + gcount ( gj ) - 1 cc = coeff ( a ) * coeff ( b ) acc = ( 0.0_dp , 0.0_dp ) do t = 0 , l ( a ) + l ( b ) do u = 0 , m ( a ) + m ( b ) do v = 0 , n ( a ) + n ( b ) acc = acc + ( ex ( t , l ( a ), l ( b )) * ey ( u , m ( a ), m ( b )) * ez ( v , n ( a ), n ( b ))) & * iqx (:, t ) * iqy (:, u ) * iqz (:, v ) end do end do end do acc = acc * g0 * cc ca = contr ( a ); cb = contr ( b ) !$OMP CRITICAL (pairft_acc) f (:, ca , cb ) = f (:, ca , cb ) + acc if ( gi /= gj ) f (:, cb , ca ) = f (:, cb , ca ) + acc !$OMP END CRITICAL (pairft_acc) end do end do end do end do !$OMP END DO deallocate ( ex , ey , ez , g0 , acc ) !$OMP END PARALLEL end subroutine pair_transform","tags":"","url":"proc/pair_transform.html"},{"title":"upward_threshold – PyXSCAT kernels","text":"public pure function upward_threshold(kk) The upward recurrence g(m+1) = [(2m+1) g(m) - g(m-1)] / x&#94;2 is stable only while the\norder stays below x (above it the irregular solution y_m takes over, and rounding errors\ngrow like (2m-1)!! (2m+1)!! / x&#94;(2m+1)).  It is therefore used only when x > kk + 1, for\nall orders at once; below that, jn_over_xn propagates downward (series + downward\nrecurrence for x < 1, Miller's normalised backward recurrence for 1 <= x <= kk + 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: kk Return Value real(kind=dp)","tags":"","url":"proc/upward_threshold.html"},{"title":"jn_over_xn – PyXSCAT kernels","text":"public pure subroutine jn_over_xn(x, nmax, g) g(n) = j_n(x) / x&#94;n, n = 0..nmax, accurate for every x >= 0. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: x integer(kind=ikind), intent(in) :: nmax real(kind=dp), intent(out) :: g (0:nmax) Variables Type Visibility Attributes Name Initial integer(kind=ikind), public :: n integer(kind=ikind), public :: k integer(kind=ikind), public :: nstart integer(kind=ikind), public :: nup real(kind=dp), public :: term real(kind=dp), public :: s real(kind=dp), public :: x2 real(kind=dp), public :: dfac real(kind=dp), public :: jm real(kind=dp), public :: j0 real(kind=dp), public :: jp real(kind=dp), public :: j1 real(kind=dp), public :: scale real(kind=dp), public :: jj (0:NJJ) real(kind=dp), public :: jd (0:NJJ) Source Code pure subroutine jn_over_xn ( x , nmax , g ) real ( kind = dp ), intent ( in ) :: x integer ( kind = ikind ), intent ( in ) :: nmax real ( kind = dp ), intent ( out ) :: g ( 0 : nmax ) integer ( kind = ikind ) :: n , k , nstart , nup real ( kind = dp ) :: term , s , x2 , dfac , jm , j0 , jp , j1 , scale real ( kind = dp ) :: jj ( 0 : NJJ ), jd ( 0 : NJJ ) x2 = x * x if ( x < 1.0_dp ) then ! power series for the two highest orders, sum_k (-x&#94;2/2)&#94;k / (k! (2n+2k+1)!!), ! then the downward recurrence g(n-1) = (2n+1) g(n) - x&#94;2 g(n+1), stable for x < n dfac = 1.0_dp do n = 0 , nmax dfac = dfac * real ( 2 * n + 1 , dp ) ! (2n+1)!! end do do n = nmax , nmax + 1 if ( n == nmax + 1 ) dfac = dfac * real ( 2 * n + 1 , dp ) term = 1.0_dp / dfac s = term do k = 1 , 30 term = - term * x2 / ( 2.0_dp * k * ( 2 * n + 2 * k + 1 )) s = s + term if ( abs ( term ) < 1.0e-17_dp * abs ( s )) exit end do if ( n == nmax ) then g ( nmax ) = s else jp = s ! g(nmax + 1) end if end do do n = nmax , 1 , - 1 if ( n == nmax ) then g ( n - 1 ) = real ( 2 * n + 1 , dp ) * g ( n ) - x2 * jp else g ( n - 1 ) = real ( 2 * n + 1 , dp ) * g ( n ) - x2 * g ( n + 1 ) end if end do return end if j0 = sin ( x ) / x if ( x > real ( nmax , dp ) + 1.0_dp ) then ! upward recurrence: stable while n < x g ( 0 ) = j0 if ( nmax == 0 ) return j1 = sin ( x ) / x2 - cos ( x ) / x jm = j0 ; j0 = j1 g ( 1 ) = j1 / x scale = x do n = 1 , nmax - 1 jp = real ( 2 * n + 1 , dp ) / x * j0 - jm jm = j0 ; j0 = jp scale = scale * x g ( n + 1 ) = jp / scale end do return end if ! 1 <= x <= nmax + 1: combine both directions.  Upward (from j0, j1) for the orders ! n <= x, where it is stable; Miller's backward recurrence for the orders above x, where ! only the downward direction is stable, started high enough above nmax that its error ! (which falls by x&#94;2/(4m&#94;2 - 1) <= 1/4 per order) is below 1e-17 and matched to the upward value at ! the junction (at nup or nup - 1, whichever is farther from a zero of j_n). nup = min ( int ( x , kind = ikind ), nmax ) jj ( 0 ) = j0 jj ( 1 ) = sin ( x ) / x2 - cos ( x ) / x do n = 1 , nup - 1 jj ( n + 1 ) = real ( 2 * n + 1 , dp ) / x * jj ( n ) - jj ( n - 1 ) end do if ( nmax > nup ) then ! start where the neglected minimal solution is below 1e-17 relative at order nmax: ! its weight drops by x&#94;2/(4m&#94;2 - 1) per order above nmax nstart = nmax s = 1.0_dp do while ( s > 1.0e-17_dp . and . nstart < NJJ - 2 ) nstart = nstart + 1 s = s * x2 / real ( 4 * nstart * nstart - 1 , dp ) end do nstart = nstart + 2 jd ( nstart + 1 ) = 0.0_dp jd ( nstart ) = 1.0e-30_dp do n = nstart , nup , - 1 jd ( n - 1 ) = real ( 2 * n + 1 , dp ) / x * jd ( n ) - jd ( n + 1 ) if ( abs ( jd ( n - 1 )) > 1.0e200_dp ) jd ( n - 1 : nstart ) = jd ( n - 1 : nstart ) * 1.0e-200_dp end do if ( abs ( jj ( nup )) >= abs ( jj ( nup - 1 ))) then scale = jj ( nup ) / jd ( nup ) else scale = jj ( nup - 1 ) / jd ( nup - 1 ) end if do n = nup + 1 , nmax jj ( n ) = jd ( n ) * scale end do end if s = 1.0_dp do n = 0 , nmax g ( n ) = jj ( n ) / s s = s * x end do end subroutine jn_over_xn","tags":"","url":"proc/jn_over_xn.html"},{"title":"hermite_radial_coeffs – PyXSCAT kernels","text":"public pure subroutine hermite_radial_coeffs(lmax, a) a(T, i) for T <= lmax, i <= T/2 Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: lmax real(kind=dp), intent(out) :: a (0:lmax,0:lmax/2) Variables Type Visibility Attributes Name Initial integer(kind=ikind), public :: t integer(kind=ikind), public :: i Source Code pure subroutine hermite_radial_coeffs ( lmax , a ) integer ( kind = ikind ), intent ( in ) :: lmax real ( kind = dp ), intent ( out ) :: a ( 0 : lmax , 0 : lmax / 2 ) integer ( kind = ikind ) :: t , i a = 0.0_dp do t = 0 , lmax a ( t , 0 ) = 1.0_dp do i = 1 , t / 2 ! a(t,i) = a(t,i-1) * (t-2i+2)(t-2i+1) / (2 i) a ( t , i ) = a ( t , i - 1 ) * real (( t - 2 * i + 2 ) * ( t - 2 * i + 1 ), dp ) / real ( 2 * i , dp ) end do end do end subroutine hermite_radial_coeffs","tags":"","url":"proc/hermite_radial_coeffs.html"},{"title":"radial_series – PyXSCAT kernels","text":"public  subroutine radial_series(nq, q, h, order, coef, out) The radial sum of the quartet kernel, out(iq) = sum_{b=0}&#94;{order} coef(b+1) q&#94;(2b) j_b(q h)/(q h)&#94;b\n         = sum_b coef(b+1) j_b(q h) (q/h)&#94;b, accurate for every q and h (including q h -> 0, where the closed forms of j_1, j_2, j_3\nlose 2, 4, 6 powers of q h to cancellation). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: q (nq) real(kind=dp), intent(in) :: h integer(kind=ikind), intent(in) :: order real(kind=dp), intent(in) :: coef (order+1) real(kind=dp), intent(out) :: out (nq) Variables Type Visibility Attributes Name Initial real(kind=dp), public :: g (0:order) real(kind=dp), public :: x real(kind=dp), public :: rx2 real(kind=dp), public :: s real(kind=dp), public :: c real(kind=dp), public :: q2 real(kind=dp), public :: qp real(kind=dp), public :: xup integer(kind=ikind), public :: iq integer(kind=ikind), public :: b Source Code subroutine radial_series ( nq , q , h , order , coef , out ) integer ( kind = ikind ), intent ( in ) :: nq , order real ( kind = dp ), intent ( in ) :: q ( nq ), h , coef ( order + 1 ) real ( kind = dp ), intent ( out ) :: out ( nq ) real ( kind = dp ) :: g ( 0 : order ), x , rx2 , s , c , q2 , qp , xup integer ( kind = ikind ) :: iq , b xup = upward_threshold ( order ) do iq = 1 , nq x = q ( iq ) * h if ( x > xup ) then s = sin ( x ); c = cos ( x ) g ( 0 ) = s / x rx2 = 1.0_dp / ( x * x ) if ( order >= 1 ) g ( 1 ) = ( g ( 0 ) - c ) * rx2 do b = 1 , order - 1 g ( b + 1 ) = ( real ( 2 * b + 1 , dp ) * g ( b ) - g ( b - 1 )) * rx2 end do else call jn_over_xn ( x , order , g ) end if q2 = q ( iq ) * q ( iq ) qp = 1.0_dp s = 0.0_dp do b = 0 , order s = s + coef ( b + 1 ) * qp * g ( b ) qp = qp * q2 end do out ( iq ) = s end do end subroutine radial_series","tags":"","url":"proc/radial_series.html"},{"title":"pyxscat_max_threads – PyXSCAT kernels","text":"public  function pyxscat_max_threads() bind(C, name='pyxscat_max_threads') Number of OpenMP threads the library uses when nthreads <= 0 is passed (omp_get_max_threads). Arguments None Return Value integer(kind=c_int) Source Code integer ( c_int ) function pyxscat_max_threads () bind ( C , name = 'pyxscat_max_threads' ) pyxscat_max_threads = omp_get_max_threads () end function pyxscat_max_threads","tags":"","url":"proc/pyxscat_max_threads.html"},{"title":"pyxscat_two_electron_j0 – PyXSCAT kernels","text":"public  subroutine pyxscat_two_electron_j0(nprim, ncontr, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, mode, dm2, da, db, wc, wx, nkc, fac, fbc, nkx, fax, fbx, dgemm_ptr, cutoffcentre, cutoffz, cutoffmd, screen_tol, lorder, nthreads, res, stats, ierr) bind(C, name='pyxscat_two_electron_j0') Rotationally averaged two-electron scattering. mode 1 : dm2 is an (ncontr)&#94;4 array with 8-fold symmetry; da, db unused\n mode 2 : dm2 is ignored (pass NULL); da, db are symmetric (ncontr, ncontr) ierr = 0 on success (see xs_kernel_j0 for the codes). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nprim integer(kind=c_int), intent(in), value :: ncontr integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: x (nprim) real(kind=c_double), intent(in) :: y (nprim) real(kind=c_double), intent(in) :: z (nprim) real(kind=c_double), intent(in) :: ga (nprim) integer(kind=c_int), intent(in) :: l (nprim) integer(kind=c_int), intent(in) :: m (nprim) integer(kind=c_int), intent(in) :: n (nprim) integer(kind=c_int), intent(in) :: group (nprim) integer(kind=c_int), intent(in) :: contr (nprim) real(kind=c_double), intent(in) :: coeff (nprim) real(kind=c_double), intent(in) :: q (nq) integer(kind=c_int), intent(in), value :: mode type(c_ptr), intent(in), value :: dm2 real(kind=c_double), intent(in) :: da (ncontr,ncontr) real(kind=c_double), intent(in) :: db (ncontr,ncontr) real(kind=c_double), intent(in), value :: wc real(kind=c_double), intent(in), value :: wx integer(kind=c_int), intent(in), value :: nkc type(c_ptr), intent(in), value :: fac type(c_ptr), intent(in), value :: fbc integ