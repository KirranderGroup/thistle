 cutoffmd , screen_tol real ( c_double ), intent ( out ) :: res ( nq ), stats ( 4 ) integer ( c_int ), intent ( out ) :: ierr real ( c_double ), pointer :: zbig (:, :, :, :), ac (:, :, :), bc (:, :, :), ax (:, :, :), bx (:, :, :) real ( c_double ), target :: none3 ( 1 , 1 , 1 ) integer :: nt_old , mkc , mkx nullify ( zbig ) if ( mode == 1 . and . c_associated ( dm2 )) call c_f_pointer ( dm2 , zbig , [ ncontr , ncontr , ncontr , ncontr ]) ! factored densities (mode 3): arrays (k, i, j) with k fastest; absent ones -> a dummy mkc = 0 ; mkx = 0 ac => none3 ; bc => none3 ; ax => none3 ; bx => none3 if ( mode == 3 ) then if ( nkc > 0 . and . c_associated ( fac ) . and . c_associated ( fbc )) then mkc = nkc call c_f_pointer ( fac , ac , [ nkc , ncontr , ncontr ]) call c_f_pointer ( fbc , bc , [ nkc , ncontr , ncontr ]) end if if ( nkx > 0 . and . c_associated ( fax ) . and . c_associated ( fbx )) then mkx = nkx call c_f_pointer ( fax , ax , [ nkx , ncontr , ncontr ]) call c_f_pointer ( fbx , bx , [ nkx , ncontr , ncontr ]) end if end if nt_old = omp_get_max_threads () if ( nthreads > 0 ) call omp_set_num_threads ( nthreads ) if ( mode == 3 ) then call two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & mode , zbig , da , db , wc , wx , mkc , ac , bc , mkx , ax , bx , dgemm_ptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , res , stats , ierr ) else call two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & mode , zbig , da , db , wc , wx , 0 , none3 , none3 , 0 , none3 , none3 , c_null_funptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , res , stats , ierr ) end if if ( nthreads > 0 ) call omp_set_num_threads ( nt_old ) end subroutine pyxscat_two_electron_j0","tags":"","url":"proc/pyxscat_two_electron_j0.html"},{"title":"pyxscat_hermite_table – PyXSCAT kernels","text":"public  subroutine pyxscat_hermite_table(ng, maxl, lg, xg, ag, dd) bind(C, name='pyx