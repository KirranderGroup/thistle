var tipuesearch = {"pages":[{"title":" PyXSCAT kernels ","text":"PyXSCAT kernels The Fortran kernels of THISTLE : the shared library libpyxscat that the\nPython package pyxscat calls through the C entry points of module xs_capi (ctypes;\nsee the Python API ).  Apache License 2.0. Documentation comments use the FORD conventions: !> in the line(s) before a module,\nprocedure or variable, or !! on the line(s) after its declaration.  Plain ! comments\nare not collected. graph: false above is because the call graphs need Graphviz ( dot );\nswitch it on where that is installed. Developer Info Andrés Moreno Carrascosa, Mats Simmermacher, Patrick Yuheng Wang, Eirik Moen Liane, Joseph Cooper, Nikola Zotev, Thomas Northey and Adam Kirrander","tags":"home","url":"index.html"},{"title":"accum – PyXSCAT kernels ","text":"type, private :: accum Components Type Visibility Attributes Name Initial logical, public :: atomic = .false. integer, public :: nint = -1 real(kind=dp), public, pointer :: a1 (:,:) => null() real(kind=dp), public, pointer :: a2 (:,:,:,:) => null() Source Code type :: accum logical :: atomic = . false . integer :: nint = - 1 ! >= 0: skip dm2 elements with all four orbitals >= nint real ( dp ), pointer :: a1 (:, :) => null () real ( dp ), pointer :: a2 (:, :, :, :) => null () end type accum","tags":"","url":"type/accum.html"},{"title":"dgemm_iface – PyXSCAT kernels","text":"interface public  subroutine dgemm_iface(transa, transb, m, n, k, alpha, a, lda, b, ldb, beta, c, ldc) bind(C) Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in) :: transa character(kind=c_char, len=1), intent(in) :: transb integer(kind=c_int), intent(in) :: m integer(kind=c_int), intent(in) :: n integer(kind=c_int), intent(in) :: k real(kind=c_double), intent(in) :: alpha real(kind=c_double), intent(in) :: a (*) integer(kind=c_int), intent(in) :: lda real(kind=c_double), intent(in) :: b (*) integer(kind=c_int), intent(in) :: ldb real(kind=c_double), intent(in) :: beta real(kind=c_double), intent(inout) :: c (*) integer(kind=c_int), intent(in) :: ldc Description BLAS dgemm in its Fortran calling convention (everything by reference)","tags":"","url":"interface/dgemm_iface.html"},{"title":"set_P0 – PyXSCAT kernels","text":"public  subroutine set_P0(P0, lmax4, q) Fills P0(:, L+1, M+1, N+1) = <qx&#94;L qy&#94;M qz&#94;N> (j0 case) for all L, M, N <= lmax4 with L+M+N <= 16. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:), allocatable :: q Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: i integer(kind=ikind), public :: j integer(kind=ikind), public :: k Source Code SUBROUTINE set_P0 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 ! Fill the current LMN if (( i + j + k ) <= 16 ) then CALL P_LMN ( P0 , i , j , k , q ) endif end do end do end do END SUBROUTINE set_P0","tags":"","url":"proc/set_p0.html"},{"title":"set_P0_j2 – PyXSCAT kernels","text":"public  subroutine set_P0_j2(P0, lmax4, q) The same table for the j2 P2 term, scaled by sqrt(5/pi). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:) :: q Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: i integer(kind=ikind), public :: j integer(kind=ikind), public :: k Source Code SUBROUTINE set_P0_j2 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:) :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k p0 = 0.0_dp ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 if (( i + j + k ) < 16 ) then ! Fill the current LMN CALL P_LMN_j2 ( P0 , k , j , i , q ) end if end do end do end do P0 = P0 * sqrt ( 5.0_dp / dacos ( - 1.0_dp )) END SUBROUTINE set_P0_j2","tags":"","url":"proc/set_p0_j2.html"},{"title":"set_P0_j1 – PyXSCAT kernels","text":"public  subroutine set_P0_j1(P0, lmax4, q) The same table for the j1 term, scaled by sqrt(3/pi). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:), allocatable :: q Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public :: i integer(kind=ikind), public :: j integer(kind=ikind), public :: k Source Code SUBROUTINE set_P0_j1 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k p0 = 0.0_dp ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 if (( i + j + k ) <= 16 ) then ! Fill the current LMN CALL P_LMN_j1 ( P0 , k , j , i , q ) end if end do end do end do P0 = P0 * sqrt ( 3.0_dp / dacos ( - 1.0_dp )) END SUBROUTINE set_P0_j1","tags":"","url":"proc/set_p0_j1.html"},{"title":"P_LMN – PyXSCAT kernels","text":"public  subroutine P_LMN(P0, L, M, N, q) One entry (L, M, N) of the j0 table at every q: the closed-form cases. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(inout), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: L integer(kind=ikind), intent(in) :: M integer(kind=ikind), intent(in) :: N real(kind=dp), intent(in), DIMENSION(:), allocatable :: q Variables Type Visibility Attributes Name Initial integer, public, parameter :: dp = SELECTED_REAL_KIND(15) integer, public, parameter :: ikind = SELECTED_INT_KIND(8) integer(kind=ikind), public, DIMENSION(1:3) :: A Source Code SUBROUTINE P_LMN ( P0 , L , M , N , q ) ! the three values of the angular momentum INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( KIND = ikind ), INTENT ( IN ) :: L , M , N ! The value of <qx&#94;L*qy&#94;M*qz&#94;N> REAL ( KIND = dp ), INTENT ( INOUT ), DIMENSION (:,:,:,:) :: P0 ! The radial part of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! For ordering INTEGER ( KIND = ikind ), DIMENSION ( 1 : 3 ) :: A ! helper variable !INTEGER(KIND=ikind) :: i ! Order L, M and N A ( 1 ) = L A ( 2 ) = M A ( 3 ) = N CALL Bubble_Sort ( A ) ! These are analytical solutions to the limits of the derivatives of j_0. ! They were generated in Wolfram Mathematica 13.1 by Mats Simmermacher in July 2023. if ( mod ( L , 2 ) /= 0 . or . mod ( M , 2 ) /= 0 . or . mod ( N , 2 ) /= 0 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = 0.0_dp elseif ( sum ( A ) == 0 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = 1.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 2 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 3.0_dp ) * q ** 2.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 2 . and . A ( 3 ) == 2 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 1 5.0_dp ) * q ** 4.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 5.0_dp ) * q ** 4.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 2 . and . A ( 3 ) == 2 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 10 5.0_dp ) * q ** 6.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 2 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 3 5.0_dp ) * q ** 6.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 2 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 31 5.0_dp ) * q ** 8.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 4 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 10 5.0_dp ) * q ** 8.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 4 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 115 5.0_dp ) * q ** 1 0.0_dp elseif ( A ( 1 ) == 4 . and . A ( 2 ) == 4 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 500 5.0_dp ) * q ** 1 2.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 7.0_dp ) * q ** 6.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 2 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 6 3.0_dp ) * q ** 8.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 9.0_dp ) * q ** 8.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 2 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 69 3.0_dp ) * q ** 1 0.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 4 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 23 1.0_dp ) * q ** 1 0.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 2 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 9 9.0_dp ) * q ** 1 0.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 4 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 300 3.0_dp ) * q ** 1 2.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 6 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 5.0_dp / 300 3.0_dp ) * q ** 1 2.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 2 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 128 7.0_dp ) * q ** 1 2.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 4 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 42 9.0_dp ) * q ** 1 2.0_dp elseif ( A ( 1 ) == 4 . and . A ( 2 ) == 4 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 1501 5.0_dp ) * q ** 1 4.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 6 . and . A ( 3 ) == 6 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 900 9.0_dp ) * q ** 1 4.0_dp elseif ( A ( 1 ) == 2 . and . A ( 2 ) == 4 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 643 5.0_dp ) * q ** 1 4.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 6 . and . A ( 3 ) == 8 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 128 7.0_dp ) * q 