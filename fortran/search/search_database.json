CTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( kind = ikind ), INTENT ( inout ), DIMENSION (:) :: a INTEGER ( kind = ikind ) :: temp INTEGER :: i , j LOGICAL :: swapped DO j = SIZE ( a ) - 1 , 1 , - 1 swapped = . FALSE . DO i = 1 , j IF ( a ( i ) > a ( i + 1 )) THEN temp = a ( i ) a ( i ) = a ( i + 1 ) a ( i + 1 ) = temp swapped = . TRUE . END IF END DO IF (. NOT . swapped ) EXIT END DO END SUBROUTINE Bubble_Sort End Module p0_cases","tags":"","url":"sourcefile/xs_p0.f90.html"},{"title":"xs_pairft.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - Fourier transforms of basis-function products at fixed q !> !>      F(q, mu, nu) = int chi_mu(r) chi_nu(r) exp(+i q.r) dr !> !> for an arbitrary list of scattering vectors (no orientational average). !> Everything that depends on the molecular orientation (aligned or !> oriented molecules, detector images) follows from these by contraction !> with density matrices, because the plane wave factorises: !> !>      elastic      F(q)  = sum D_mu,nu F_mu,nu(q) !>      two-electron I2(q) = sum Gamma_{mu nu, la si} F_mu,nu(q) F_la,si(q)&#94;* !> !> Each primitive pair is expanded in Hermite Gaussians at the pair centre P; !> the transform of a Hermite Gaussian is analytic: !> !>      int Lambda_tuv(r-P) exp(iq.r) = (pi/p)&#94;{3/2} exp(-q&#94;2/4p) exp(iq.P) !>                                      (i qx)&#94;t (i qy)&#94;u (i qz)&#94;v !> !> so there is no Bessel expansion and no special treatment of coincident !> centres. !----------------------------------------------------------------------- module xs_pairft use iso_fortran_env , only : int64 implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) contains !> Hermite coefficients E(t; i, j) for one primitive pair and one direction (Gaussian !> prefactor excluded, E(0;0,0) = 1). pure subroutine hermite_pair ( la , lb , pa , pb , p , e ) integer ( kind = ikind ), intent ( in ) :: la , lb real ( kind = dp ), intent ( in ) :: pa , pb , p real ( kind = dp ), intent ( out ) :: e ( 0 : la + lb + 1 , 0 : la , 0 : lb ) ! work array padded in t (see xs_hermite: no guarded loads in the recurrence) real ( kind = dp ) :: w ( - 1 : la + lb + 2 , 0 : la , 0 : lb ) integer ( kind = ikind ) :: i , j , t real ( kind = dp ) :: a2 a2 = 0.5_dp / p w = 0.0_dp w ( 0 , 0 , 0 ) = 1.0_dp do i = 0 , la - 1 do t = 0 , i + 1 w ( t , i + 1 , 0 ) = a2 * w ( t - 1 , i , 0 ) + pa * w ( t , i , 0 ) + real ( t + 1 , dp ) * w ( t + 1 , i , 0 ) end do end do do j = 0 , lb - 1 do i = 0 , la do t = 0 , i + j + 1 w ( t , i , j + 1 ) = a2 * w ( t - 1 , i , j ) + pb * w ( t , i , j ) + real ( t + 1 , dp ) * w ( t + 1 , i , j ) end do end do end do e = w ( 0 : la + lb + 1 , :, :) end subroutine hermite_pair !> F(q, mu, nu) for every scattering vector qv(:, iq) and every pair of contracted functions, !> into the complex array f(nq, nao, nao).  Primitive-shell pairs whose Gaussian prefactor !> (times the largest coefficients) is below screen are skipped; ierr = 0 on success. subroutine pair_transform ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , qv , & screen , f , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: qv ( 3 , nq ), screen complex ( kind = dp ), intent ( out ) :: f ( nq , nao , nao ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , iq , t , u , v , ca , cb integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:) real ( kind = dp ), allocatable :: cmax (:) real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc real ( kind = dp ), allocatable :: ex (:, :, :), ey (:, :, :), ez (:, :, :) complex ( kind = dp ), allocatable :: g0 (:), iqx (:, :), iqy (:, :), iqz (:, :), acc (:) complex ( kind = dp ) :: ci ierr = 0 f = ( 0.0_dp , 0.0_dp ) pi = acos ( - 1.0_dp ) ci = ( 0.0_dp , 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return end if end do allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), cmax ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) end if gcount ( g ) = gcount ( g ) + 1 end do do g = 1 , ng cmax ( g ) = maxval ( abs ( coeff ( gstart ( g ): gstart ( g ) + gcount ( g ) - 1 ))) end do lmax = maxval ( lg ) ! powers (i q)&#94;t for every q allocate ( iqx ( nq , 0 : 2 * lmax ), iqy ( nq , 0 : 2 * lmax ), iqz ( nq , 0 : 2 * lmax )) iqx (:, 0 ) = 1.0_dp ; iqy (:, 0 ) = 1.0_dp ; iqz (:, 0 ) = 1.0_dp do t = 1 , 2 * lmax iqx (:, t ) = iqx (:, t - 1 ) * ci * qv ( 1 , :) iqy (:, t ) = iqy (:, t - 1 ) * ci * qv ( 2 , :) iqz (:, t ) = iqz (:, t - 1 ) * ci * qv ( 3 , :) end do ! Threads split the primitive-shell pairs; several pairs feed the same contracted ! element, so the accumulation into f is serialised (it is a small part of the work). !$OMP PARALLEL default(shared) private(gi, gj, a, b, p, px, py, pz, kab, pref, ex, ey, ez, & !$OMP& g0, acc, t, u, v, ca, cb, cc, iq) allocate ( ex ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ey ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ez ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax )) allocate ( g0 ( nq ), acc ( nq )) !$OMP DO schedule(dynamic) do gi = 1 , ng do gj = gi , ng a = gstart ( gi ); b = gstart ( gj ) p = ga ( a ) + ga ( b ) kab = exp ( - ga ( a ) * ga ( b ) / p * (( x ( a ) - x ( b )) ** 2 + ( y ( a ) - y ( b )) ** 2 + ( z ( a ) - z ( b )) ** 2 )) pref = ( pi / p ) ** 1.5_dp * kab if ( pref * cmax ( gi ) * cmax ( gj ) * ( 1.0_dp + real ( lg ( gi ) + lg ( gj ), dp )) < screen ) cycle px = ( ga ( a ) * x ( a ) + ga ( b ) * x ( b )) / p py = ( ga ( a ) * y ( a ) + ga ( b ) * y ( b )) / p pz = ( ga ( a ) * z ( a ) + ga ( b ) * z ( b )) / p call hermite_pair ( lg ( gi ), lg ( gj ), px - x ( a ), px - x ( b ), p , ex ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), py - y ( a ), py - y ( b ), p , ey ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), pz - z ( a ), pz - z ( b ), p , ez ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) do iq = 1 , nq g0 ( iq ) = pref * exp ( - ( qv ( 1 , iq ) ** 2 + qv ( 2 , iq ) ** 2 + qv ( 3 , iq ) ** 2 ) / ( 4.0_dp * p )) & * exp ( ci * ( qv ( 1 , iq ) * px + qv ( 2 , iq ) * py + qv ( 3 , iq ) * pz )) end do do a = gstart ( gi ), gstart ( gi ) + gcount ( gi ) - 1 do b = gstart ( gj ), gstart ( gj ) + gcount ( gj ) - 1 cc = coeff ( a ) * coeff ( b ) acc = ( 0.0_dp , 0.0_dp ) do t = 0 , l ( a ) + l ( b ) do u = 0 , m ( a ) + m ( b ) do v = 0 , n ( a ) + n ( b ) acc = acc + ( ex ( t , l ( a ), l ( b )) * ey ( u , m ( a ), m ( b )) * ez ( v , n ( a ), n ( b ))) & * iqx (:, t ) * iqy (:, u ) * iqz (:, v ) end do end do end do acc = acc * g0 * cc ca = contr ( a ); cb = contr ( b ) !$OMP CRITICAL (pairft_acc) f (:, ca , cb ) = f (:, ca , cb ) + acc if ( gi /= gj ) f (:, cb , ca ) = f (:, cb , ca ) + acc !$OMP END CRITICAL (pairft_acc) end do end do end do end do !$OMP END DO deallocate ( ex , ey , ez , g0 , acc ) !$OMP END PARALLEL end subroutine pair_transform end module xs_pairft","tags":"","url":"sourcefile/xs_pairft.f90.html"},{"title":"xs_radial.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - radial functions shared by the one- and two-centre j0 kernels !> !>      g_n(x) = j_n(x) / x&#94;n                       (stable for every x >= 0) !>      a(T, i) = T! / (i! (T-2i)! 2&#94;i)               (Cartesian derivatives of a function of h&#94;2/2) !> !> For any radial function f(|h|) with f_n = (1/h d/dh)&#94;n f, !> !>      d&#94;T/dhx&#94;T d&#94;U/dhy&#94;U d&#94;V/dhz&#94;V f = sum_ijk a(T,i) a(U,j) a(V,k) hx&#94;(T-2i) hy&#94;(U-2j) hz&#94;(V-2k) !>                                        f_(T+U+V-i-j-k), !> !> and for f = j0(q h):  f_n = (-q&#94;2)&#94;n g_n(q h). !----------------------------------------------------------------------- module xs_radial implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) integer , parameter , private :: NJJ = 128 contains !> g(n) = j_n(x) / x&#94;n, n = 0..nmax, accurate for every x >= 0. pure subroutine jn_over_xn ( x , nmax , g ) real ( kind = dp ), intent ( in ) :: x integer ( kind = ikind ), intent ( in ) :: nmax real ( kind = dp ), intent ( out ) :: g ( 0 : nmax ) integer ( kind = ikind ) :: n , k , nstart , nup real ( kind = dp ) :: term , s , x2 , dfac , jm , j0 , jp , j1 , scale real ( kind = dp ) :: jj ( 0 : NJJ ), jd ( 0 : NJJ ) x2 = x * x if ( x < 1.0_dp ) then ! power series for the two highest orders, sum_k (-x&#94;2/2)&#94;k / (k! (2n+2k+1)!!), ! then the downward recurrence g(n-1) = (2n+1) g(n) - x&#94;2 g(n+1), stable for x < n dfac = 1.0_dp do n = 0 , nmax dfac = dfac * real ( 2 * n + 1 , dp ) ! (2n+1)!! end do do n = nmax , nmax + 1 if ( n == nmax + 1 ) dfac = dfac * real ( 2 * n + 1 , dp ) term = 1.0_dp / dfac s = term do k = 1 , 30 term = - term * x2 / ( 2.0_dp * k * ( 2 * n + 2 * k + 1 )) s = s + term if ( abs ( term ) < 1.0e-17_dp * abs ( s )) exit end do if ( n == nmax ) then g ( nmax ) = s else jp = s ! g(nmax + 1) end if end do do n = nmax , 1 , - 1 if ( n == nmax ) then g ( n - 1 ) = real ( 2 * n + 1 , dp ) * g ( n ) - x2 * jp else g ( n - 1 ) = real ( 2 * n + 1 , dp ) * g ( n ) - x2 * g ( n + 1 ) end if end do return end if j0 = sin ( x ) / x if ( x > real ( nmax , dp ) + 1.0_dp ) then ! upward recurrence: stable while n < x g ( 0 ) = j0 if ( nmax == 0 ) return j1 = sin ( x ) / x2 - cos ( x ) / x jm = j0 ; j0 = j1 g ( 1 ) = j1 / x scale = x do n = 1 , nmax - 1 jp = real ( 2 * n + 1 , dp ) / x * j0 - jm jm = j0 ; j0 = jp scale = scale * x g ( n + 1 ) = jp / scale end do return end if ! 1 <= x <= nmax + 1: combine both directions.  Upward (from j0, j1) for the orders ! n <= x, where it is stable; Miller's backward recurrence for the orders above x, where ! only the downward direction is stable, started high enough above nmax that its error ! (which falls by x&#94;2/(4m&#94;2 - 1) <= 1/4 per order) is below 1e-17 and matched to the upward value at ! the junction (at nup or nup - 1, whichever is farther from a zero of j_n). nup = min ( int ( x , kind = ikind ), nmax ) jj ( 0 ) = j0 jj ( 1 ) = sin ( x ) / x2 - cos ( x ) / x do n = 1 , nup - 1 jj ( n + 1 ) = real ( 2 * n + 1 , dp ) / x * jj ( n ) - jj ( n - 1 ) end do if ( nmax > nup ) then ! start where the neglected minimal solution is below 1e-17 relative at order nmax: ! its weight drops by x&#94;2/(4m&#94;2 - 1) per order above nmax nstart = nmax s = 1.0_dp do while ( s > 1.0e-17_dp . and . nstart < NJJ - 2 ) nstart = nstart + 1 s = s * x2 / real ( 4 * nstart * nstart - 1 , dp ) end do nstart = nstart + 2 jd ( nstart + 1 ) = 0.0_dp jd ( nstart ) = 1.0e-30_dp do n = nstart , nup , - 1 jd ( n - 1 ) = real ( 2 * n + 1 , dp ) / x * jd ( n ) - jd ( n + 1 ) if ( abs ( jd ( n - 1 )) > 1.0e200_dp ) jd ( n - 1 : nstart ) = jd ( n - 1 : nstart ) * 1.0e-200_dp end do if ( abs ( jj ( nup )) >= abs ( jj ( nup - 1 ))) then scale = jj ( nup ) / jd ( nup ) else scale = jj ( nup - 1 ) / jd ( nup - 1 ) end if do n = nup + 1 , nmax jj ( n ) = jd ( n ) * scale end do end if s = 1.0_dp do n = 0 , nmax g ( n ) = jj ( n ) / s s = s * x end do end subroutine jn_over_xn !> a(T, i) for T <= lmax, i <= T/2 pure subroutine hermite_radial_coeffs ( lmax , a ) integer ( kind = ikind ), intent ( in ) :: lmax real ( kind = dp ), intent ( out ) :: a ( 0 : lmax , 0 : lmax / 2 ) integer ( kind = ikind ) :: t , i a = 0.0_dp do t = 0 , lmax a ( t , 0 ) = 1.0_dp do i = 1 , t / 2 ! a(t,i) = a(t,i-1) * (t-2i+2)(t-2i+1) / (2 i) a ( t , i ) = a ( t , i - 1 ) * real (( t - 2 * i + 2 ) * ( t - 2 * i + 1 ), dp ) / real ( 2 * i , dp ) end do end do end subroutine hermite_radial_coeffs !> The upward recurrence g(m+1) = [(2m+1) g(m) - g(m-1)] / x&#94;2 is stable only while the !> order stays below x (above it the irregular solution y_m takes over, and rounding errors !> grow like (2m-1)!! (2m+1)!! / x&#94;(2m+1)).  It is therefore used only when x > kk + 1, for !> all orders at once; below that, jn_over_xn propagates downward (series + downward !> recurrence for x < 1, Miller's normalised backward recurrence for 1 <= x <= kk + 1). pure real ( kind = dp ) function upward_threshold ( kk ) integer ( kind = ikind ), intent ( in ) :: kk upward_threshold = real ( kk , dp ) + 1.0_dp end function upward_threshold !> The radial sum of the quartet kernel, !> !>      out(iq) = sum_{b=0}&#94;{order} coef(b+1) q&#94;(2b) j_b(q h)/(q h)&#94;b !>              = sum_b coef(b+1) j_b(q h) (q/h)&#94;b, !> !> accurate for every q and h (including q h -> 0, where the closed forms of j_1, j_2, j_3 !> lose 2, 4, 6 powers of q h to cancellation). subroutine radial_series ( nq , q , h , order , coef , out ) integer ( kind = ikind ), intent ( in ) :: nq , order real ( kind = dp ), intent ( in ) :: q ( nq ), h , coef ( order + 1 ) real ( kind = dp ), intent ( out ) :: out ( nq ) real ( kind = dp ) :: g ( 0 : order ), x , rx2 , s , c , q2 , qp , xup integer ( kind = ikind ) :: iq , b xup = upward_threshold ( order ) do iq = 1 , nq x = q ( iq ) * h if ( x > xup ) then s = sin ( x ); c = cos ( x ) g ( 0 ) = s / x rx2 = 1.0_dp / ( x * x ) if ( order >= 1 ) g ( 1 ) = ( g ( 0 ) - c ) * rx2 do b = 1 , order - 1 g ( b + 1 ) = ( real ( 2 * b + 1 , dp ) * g ( b ) - g ( b - 1 )) * rx2 end do else call jn_over_xn ( x , order , g ) end if q2 = q ( iq ) * q ( iq ) qp = 1.0_dp s = 0.0_dp do b = 0 , order s = s + coef ( b + 1 ) * qp * g ( b ) qp = qp * q2 end do out ( iq ) = s end do end subroutine radial_series end module xs_radial","tags":"","url":"sourcefile/xs_radial.f90.html"},{"title":"xs_capi.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - C-compatible entry points (called from Python through ctypes) !> !> One bind(C) wrapper per kernel; the ctypes signatures on the Python side are declared in !> python/pyxscat/_lib.py.  Scalars are passed by value, arrays by reference in Fortran order, !> optional arrays as NULL pointers; nthreads > 0 sets the OpenMP thread count for the call. !----------------------------------------------------------------------- module xs_capi use iso_c_binding use iso_fortran_env , only : compiler_version , compiler_options use xs_kernel_j0 use xs_pairft use xs_nuclear use xs_elastic use xs_radial , only : radial_series use xs_rdm , only : rdm12_bitwise , rdm12_bitwise_groups use omp_lib implicit none contains !> Rotationally averaged two-electron scattering. !> !>      mode 1 : dm2 is an (ncontr)&#94;4 array with 8-fold symmetry; da, db unused !>      mode 2 : dm2 is ignored (pass NULL); da, db are symmetric (ncontr, ncontr) !> !> ierr = 0 on success (see xs_kernel_j0 for the codes). subroutine pyxscat_two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & mode , dm2 , da , db , wc , wx , nkc , fac , fbc , nkx , fax , fbx , dgemm_ptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , nthreads , & res , stats , ierr ) bind ( C , name = 'pyxscat_two_electron_j0' ) integer ( c_int ), value , intent ( in ) :: nprim , ncontr , nq , mode , nthreads , lorder , nkc , nkx real ( c_double ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( c_int ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) type ( c_ptr ), value , intent ( in ) :: dm2 , fac , fbc , fax , fbx type ( c_funptr ), value , intent ( in ) :: dgemm_ptr real ( c_double ), intent ( in ) :: da ( ncontr , ncontr ), db ( ncontr , ncontr ) real ( c_double ), value , intent ( in ) :: wc , wx , cutoffcentre , cutoffz , cutoffmd , screen_tol real ( c_double ), intent ( out ) :: res ( nq ), stats ( 4 ) integer ( c_int ), intent ( out ) :: ierr real ( c_double ), pointer :: zbig (:, :, :, :), ac (:, :, :), bc (:, :, :), ax (:, :, :), bx (:, :, :) real ( c_double ), target :: none3 ( 1 , 1 , 1 ) integer :: nt_old , mkc , mkx nullify ( zbig ) if ( mode == 1 . and . c_associated ( dm2 )) call c_f_pointer ( dm2 , zbig , [ ncontr , ncontr , ncontr , ncontr ]) ! factored densities (mode 3): arrays (k, i, j) with k fastest; absent ones -> a dummy mkc = 0 ; mkx = 0 ac => none3 ; bc => none3 ; ax => none3 ; bx => none3 if ( mode == 3 ) then if ( nkc > 0 . and . c_associated ( fac ) . and . c_associated ( fbc )) then mkc = nkc call c_f_pointer ( fac , ac , [ nkc , ncontr , ncontr ]) call c_f_pointer ( fbc , bc , [ nkc , ncontr , ncontr ]) end if if ( nkx > 0 . and . c_associated ( fax ) . and . c_associated ( fbx )) then mkx = nkx call c_f_pointer ( fax , ax , [ nkx , ncontr , ncontr ]) call c_f_pointer ( fbx , bx , [ nkx , ncontr , ncontr ]) end if end if nt_old = omp_get_max_threads () if ( nthreads > 0 ) call omp_set_num_threads ( nthreads ) if ( mode == 3 ) then call two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & mode , zbig , da , db , wc , wx , mkc , ac , bc , mkx , ax , bx , dgemm_ptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , res , stats , ierr ) else call two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & mode , zbig , da , db , wc , wx , 0 , none3 , none3 , 0 , none3 , none3 , c_null_funptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , res , stats , ierr ) end if if ( nthreads > 0 ) call omp_set_num_threads ( nt_old ) end subroutine pyxscat_two_electron_j0 !> Hermite coefficients for one Cartesian direction (exposed for unit tests). subroutine pyxscat_hermite_table ( ng , maxl , lg , xg , ag , dd ) bind ( C , name = 'pyxscat_hermite_table' ) integer ( c_int ), value , intent ( in ) :: ng , maxl integer ( c_int ), intent ( in ) :: lg ( ng ) real ( c_double ), intent ( in ) :: xg ( ng ), ag ( ng ) real ( c_double ), intent ( out ) :: dd ( 2 * maxl + 1 , maxl + 1 , maxl + 1 , ng , ng ) call hermite_table ( ng , maxl , lg , xg , ag , dd ) end subroutine pyxscat_hermite_table !> Fourier transforms of basis-function products, F(q, mu, nu), at fixed scattering vectors. subroutine pyxscat_pair_transform ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , qv , & screen , nthreads , f , ierr ) bind ( C , name = 'pyxscat_pair_transform' ) integer ( c_int ), value , intent ( in ) :: nprim , nao , nq , nthreads real ( c_double ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), qv ( 3 , nq ) integer ( c_int ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( c_double ), value , intent ( in ) :: screen complex ( c_double_complex ), intent ( out ) :: f ( nq , nao , nao ) integer ( c_int ), intent ( out ) :: ierr integer :: nt_old nt_old = omp_get_max_threads () if ( nthreads > 0 ) call omp_set_num_threads ( nthreads ) call pair_transform ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , qv , screen , f , ierr ) if ( nthreads > 0 ) call omp_set_num_threads ( nt_old ) end subroutine pyxscat_pair_transform !> Electron-nucleus term of electron scattering (rotational average, l = 0 or 2). subroutine pyxscat_electron_nucleus ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & natom , zat , rat , dm , lorder , screen , nthreads , res , ierr ) bind ( C , name = 'pyxscat_electron_nucleus' ) integer ( c_int ), value , intent ( in ) :: nprim , nao , nq , natom , lorder , nthreads real ( c_double ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( c_int ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( c_double ), intent ( in ) :: zat ( natom ), rat ( 3 , natom ), dm ( nao , nao ) real ( c_double ), value , intent ( in ) :: screen real ( c_double ), intent ( out ) :: res ( nq ) integer ( c_int ), intent ( out ) :: ierr integer :: nt_old nt_old = omp_get_max_threads () if ( nthreads > 0 ) call omp_set_num_threads ( nthreads ) call electron_nucleus ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & natom , zat , rat , dm , lorder , screen , res , ierr ) if ( nthreads > 0 ) call omp_set_num_threads ( nt_old ) end subroutine pyxscat_electron_nucleus !> Elastic (and coherent mixed) scattering by density-weighted pairs (l = 0 or 2). subroutine pyxscat_elastic_pairs ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & da , db , lorder , screen , nthreads , res , stats , ierr ) bind ( C , name = 'pyxscat_elastic_pairs' ) integer ( c_int ), value , intent ( in ) :: nprim , nao , nq , lorder , nthreads real ( c_double ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( c_int ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( c_double ), intent ( in ) :: da ( nao , nao ), db ( nao , nao ) real ( c_double ), value , intent ( in ) :: screen real ( c_double ), intent ( out ) :: res ( nq ), stats ( 2 ) integer ( c_int ), intent ( out ) :: ierr integer :: nt_old nt_old = omp_get_max_threads () if ( nthreads > 0 ) call omp_set_num_threads ( nthreads ) call elastic_pairs ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & da , db , lorder , screen , res , stats , ierr ) if ( nthreads > 0 ) call omp_set_num_threads ( nt_old ) end subroutine pyxscat_elastic_pairs !> sum_b coef(b+1) j_b(q h) (q/h)&#94;b for a list of q (exposed for unit tests). subroutine pyxscat_radial_series ( nq , q , h , order , coef , res ) bind ( C , name = 'pyxscat_radial_series' ) integer ( c_int ), value , intent ( in ) :: nq , order real ( c_double ), intent ( in ) :: q ( nq ), coef ( order + 1 ) real ( c_double ), value , intent ( in ) :: h real ( c_double ), intent ( out ) :: res ( nq ) call radial_series ( int ( nq , kind = 4 ), q , h , int ( order , kind = 4 ), coef , res ) end subroutine pyxscat_radial_series !> Spin-summed 1- and 2-RDMs of a determinant expansion by the bitwise determinant-pair !> algorithm (one 64-bit word per spin).  d1, d2 are C-ordered [p,q] and [p,q,r,s]. subroutine pyxscat_rdm12_bitwise ( ndet , norb , nw , wa , wb , c , nthreads , d1 , d2 , ierr ) & bind ( C , name = 'pyxscat_rdm12_bitwise' ) integer ( c_int ), value , intent ( in ) :: ndet , norb , nw , nthreads integer ( c_int64_t ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( c_double ), intent ( in ) :: c ( ndet ) real ( c_double ), intent ( out ) :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer ( c_int ), intent ( out ) :: ierr integer :: nt , e nt = nthreads if ( nt <= 0 ) nt = omp_get_max_threads () call rdm12_bitwise ( int ( ndet ), int ( norb ), int ( nw ), wa , wb , c , d1 , d2 , nt , e ) ierr = e end subroutine pyxscat_rdm12_bitwise !> rdm12_bitwise restricted to candidate pairs: determinants sorted into ng groups with the !> neighbour lists nb (see xs_rdm); dm2 elements with all four orbitals >= nint are skipped. subroutine pyxscat_rdm12_bitwise_groups ( ndet , norb , nw , wa , wb , c , nint , ng , gstart , grp , nnb , nbstart , nb , & nthreads , d1 , d2 , ierr ) bind ( C , name = 'pyxscat_rdm12_bitwise_groups' ) integer ( c_int ), value , intent ( in ) :: ndet , norb , nw , nint , ng , nnb , nthreads integer ( c_int64_t ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( c_double ), intent ( in ) :: c ( ndet ) integer ( c_int ), intent ( in ) :: gstart ( ng + 1 ), grp ( ndet ), nbstart ( ng + 1 ), nb ( nnb ) real ( c_double ), intent ( out ) :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer ( c_int ), intent ( out ) :: ierr integer :: nt , e nt = nthreads if ( nt <= 0 ) nt = omp_get_max_threads () call rdm12_bitwise_groups ( int ( ndet ), int ( norb ), int ( nw ), wa , wb , c , int ( nint ), int ( ng ), gstart , grp , & int ( nnb ), nbstart , nb , d1 , d2 , nt , e ) ierr = e end subroutine pyxscat_rdm12_bitwise_groups !> Compiler and options the library was built with (for bug reports): copied into buf. subroutine pyxscat_build_info ( buf , n ) bind ( C , name = 'pyxscat_build_info' ) integer ( c_int ), value , intent ( in ) :: n character ( kind = c_char ), intent ( out ) :: buf ( n ) character ( len = :), allocatable :: s integer :: i s = compiler_version () // ' | ' // compiler_options () buf = c_null_char do i = 1 , min ( len ( s ), n - 1 ) buf ( i ) = s ( i : i ) end do end subroutine pyxscat_build_info !> Number of OpenMP threads the library uses when nthreads <= 0 is passed (omp_get_max_threads). integer ( c_int ) function pyxscat_max_threads () bind ( C , name = 'pyxscat_max_threads' ) pyxscat_max_threads = omp_get_max_threads () end function pyxscat_max_threads end module xs_capi","tags":"","url":"sourcefile/xs_capi.f90.html"},{"title":"xs_bessel_j0.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander ! ========================================================================= !> Bessels_j0_opt.f90 !> !> Optimised version of the Bessel module for X-ray scattering. !> !> Changes vs original: !> !> MATH: !> !>      1. dphrec_opt: backward recurrence starts from order+15 instead of !>         hardcoded 100. For order=4 this is 5x less work. For order=8 !>         still 4x less. Numerically identical (Miller's algorithm is !>         stable regardless of starting point, provided sufficient buffer). !> !>      2. bessels0rr: final summation restructured as DGEMV when order>=4, !>         with invpmu&#94;beta scaling pre-absorbed. Eliminates the explicit !>         beta loop with element-wise operations. !> !>      3. Pmu=0 guard: if any q-point gives |Pmu|<1e-15, use the !>         Taylor expansion j_0(x)=1, j_l(x)~x&#94;l/(2l+1)!! instead of !>         dividing by zero. !> !> CODING: !> !>      4. rrdj0: early exit when lmax=0 (s-shell quartets, very common). !>         Avoids filling the full 20x20 matrix. !> !>      5. BesselDeriv: screening on products C1, C2 moved to reduce !>         multiplications (already present in original, kept here). !> !>      6. allbessels array right-sized to (order+16, nq) instead of !>         (100, nq), reducing stack usage from 160KB to ~25KB typical. !> !>      7. bessels0rr_dim: new variant that takes h_saved as dim-length !>         vector (matching the caller's usage) to avoid assumed-shape !>         overhead. !> !> Link with: -lblas (for DGEMV) ! ========================================================================= module Bessels_j0 implicit none !> largest derivative order + 1 of the j0 expansions: 4 l_max + 2 (j2) + 1 = 23 for h functions integer , parameter :: BDIM_MAX = 32 contains !> Radial sum of the quartet kernel for one pair distance H and every q in mu: !> !>      h_sum(q) = sum_b h_saved(b+1) j_b(H q) (q/H)&#94;b, !> !> with closed forms for order <= 3 and Miller's backward recurrence (dphrec_opt) above. subroutine bessels0rr ( h_sum , order , mu , H , h_saved ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) integer ( kind = ikind ), intent ( in ) :: order real ( kind = dp ), dimension (:), intent ( in ) :: h_saved real ( kind = dp ), dimension (:), intent ( in ), allocatable :: mu real ( kind = dp ), intent ( in ) :: H real ( kind = dp ), dimension ( size ( mu )), intent ( out ) :: h_sum integer ( kind = ikind ) :: beta , nq , lrec , i real ( kind = dp ), dimension ( size ( mu )) :: pmu , sinpmu , cospmu , invpmu real ( kind = dp ), dimension ( size ( mu )) :: h_1 , h_2 , h_3 real ( kind = dp ), dimension (:,:), allocatable :: allbessels real ( kind = dp ), dimension (:), allocatable :: h_scaled real ( kind = dp ) :: invpmu_power nq = size ( mu ) Pmu = H * mu sinpmu = sin ( pmu ) cospmu = cos ( pmu ) ! ---------------------------------------------------------- ! Guard against Pmu ~ 0  (q -> 0 limit) ! j_0(x) -> 1 - x&#94;2/6 + ... ! For higher orders, j_l(x) -> x&#94;l / (2l+1)!! which is tiny ! ---------------------------------------------------------- h_sum = 0.0_dp do i = 1 , nq if ( abs ( pmu ( i )) < 1.0e-15_dp ) then ! Only j_0 contributes; higher orders are ~0 h_sum ( i ) = h_saved ( 1 ) else h_sum ( i ) = ( sinpmu ( i ) / pmu ( i )) * h_saved ( 1 ) end if end do if ( order == 0 ) return ! invpmu = mu/H  (scaling factor, NOT 1/Pmu) ! Used as: invpmu&#94;beta = (mu/H)&#94;beta if ( abs ( H ) > 1.0e-30_dp ) then invpmu = mu / H else invpmu = 0.0_dp end if ! ---------------------------------------------------------- ! Low-order explicit formulas (order 1-3) ! These avoid the dphrec overhead for the most common cases ! ---------------------------------------------------------- if ( order == 1 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_sum = h_sum + h_saved ( 2 ) * h_1 return else if ( order == 2 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_2 = (( 3.0_dp / Pmu ** 3 - 1.0_dp / Pmu ) * sinpmu & - 3.0_dp / Pmu ** 2 * cospmu ) * invpmu ** 2 h_sum = h_sum + h_saved ( 2 ) * h_1 + h_saved ( 3 ) * h_2 return else if ( order == 3 ) then h_1 = ( sinpmu / Pmu ** 2 - cospmu / Pmu ) * invpmu h_2 = (( 3.0_dp / Pmu ** 3 - 1.0_dp / Pmu ) * sinpmu & - 3.0_dp / Pmu ** 2 * cospmu ) * invpmu ** 2 h_3 = ( pmu * ( - 1 5.0_dp + pmu ** 2 ) * cospmu & + 3.0_dp * ( 5.0_dp - 2.0_dp * pmu ** 2 ) * sinpmu ) & / pmu ** 4 * invpmu ** 3 h_sum = h_sum + h_saved ( 2 ) * h_1 + h_saved ( 3 ) * h_2 & + h_saved ( 4 ) * h_3 return end if ! ---------------------------------------------------------- ! General case: order >= 4 ! Use right-sized backward recurrence ! ---------------------------------------------------------- ! Miller's algorithm requires l_start > max(|x|) + buffer. ! The argument x = Pmu = H*mu can be large for distant pairs ! at high q. The standard criterion for double precision is: !   l_start >= max(|x|) + C * max(|x|)&#94;(1/3) + 15 ! where C ~ 4-5. We use a conservative formula. ! The original code used 100, which fails for |Pmu| > ~85. ! ---------------------------------------------------------- block real ( kind = dp ) :: xmax xmax = maxval ( abs ( pmu )) lrec = max ( int ( xmax + 5.0_dp * xmax ** ( 1.0_dp / 3.0_dp ) + 20 ), order + 20 ) ! Safety floor: never go below original 100 for large arguments if ( xmax > 5 0.0_dp ) lrec = max ( lrec , 120 ) ! Safety ceiling: cap to prevent absurd allocation lrec = min ( lrec , 500 ) end block allocate ( allbessels ( lrec , nq )) call dphrec_opt ( pmu , allbessels , lrec , order + 1 , nq ) ! ---------------------------------------------------------- ! Final summation: h_sum += Sum_{beta=1}&#94;{order} !   allbessels(beta+1, :) * invpmu&#94;beta * h_saved(beta+1) ! ! Restructure as matrix-vector multiply: !   Scale each row of allbessels by invpmu&#94;beta * h_saved(beta+1) !   Then sum rows -> h_sum ! ! For moderate order (4-16) and nq (50-200), explicit loop ! with pre-scaled coefficients is faster than DGEMV overhead. ! ---------------------------------------------------------- do beta = 1 , order ! h_saved(beta+1) * invpmu&#94;beta applied element-wise h_sum = h_sum + allbessels ( beta + 1 , :) * invpmu ** beta * h_saved ( beta + 1 ) end do deallocate ( allbessels ) end subroutine bessels0rr ! ================================================================== !> Right-sized backward recurrence for spherical Bessel functions !> !> Miller's algorithm: start backward recurrence from l = leps1, !> normalise against known values of cos(x) and the Wronskian. !> !> The caller must ensure leps1 >= max(|x|) + buffer for all !> x values in the array. A buffer of ~20 + 5*|x|&#94;(1/3) gives !> double-precision accuracy. !> !> `leps1` is the starting order of the backward recurrence and `lmax1` the number of Bessel !> functions returned (j_0 ... j_{lmax1-1}). ! ================================================================== subroutine dphrec_opt ( x , rbes , leps1 , lmax1 , nq ) implicit none INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) integer , intent ( in ) :: leps1 , lmax1 , nq real ( kind = dp ), dimension ( nq ), intent ( in ) :: x real ( kind = dp ), dimension ( leps1 , nq ), intent ( out ) :: rbes real ( kind = dp ), dimension ( nq ) :: xx , cx , sx , a_norm , cu real ( kind = dp ) :: w integer :: k , lu xx = x * x rbes = 0.0_dp ! Seed values for backward recurrence rbes ( leps1 , :) = 1.0_dp if ( leps1 > 1 ) rbes ( leps1 - 1 , :) = 1.0_dp cx = cos ( x ) sx = sin ( x ) ! Backward recurrence (Miller's algorithm) do k = 3 , leps1 lu = leps1 - k + 2 rbes ( lu - 1 , :) = rbes ( lu , :) - xx / ( 4.0_dp * lu * lu - 1.0_dp ) * rbes ( lu + 1 , :) end do ! Normalisation using Wronskian: f(0)*g(1) - x&#94;2/3 * f(1)*cos(x) ! where g(1) = cos(x) + x*sin(x) a_norm = rbes ( 1 , :) * ( cx + x * sx ) - xx / 3.0_dp * rbes ( 2 , :) * cx do k = 1 , leps1 rbes ( k , :) = rbes ( k , :) / a_norm end do ! Scale by x&#94;l / (2l+1)!! to convert to actual j_l(x) cu = 1.0_dp / x do k = 1 , lmax1 w = 2.0_dp * ( k - 1 ) cu = x / ( w + 1.0_dp ) * cu rbes ( k , :) = cu * rbes ( k , :) end do end subroutine dphrec_opt ! ================================================================== !> Expansion coefficients for one Cartesian coordinate. !> !> Early return for lmax = 0 (s-shell, very common). ! ================================================================== subroutine rrdj0 ( lmax , x , a ) integer , parameter :: dp = selected_real_kind ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) integer , intent ( in ) :: lmax integer ( kind = ikind ) :: l , p real ( kind = dp ), intent ( in ) :: x real ( kind = dp ), dimension ( BDIM_MAX , BDIM_MAX ), intent ( out ) :: a a = 0.0_dp a ( 1 , 1 ) = 1.0_dp ! Early exit for s-type (lmax=0) if ( lmax == 0 ) return a ( 2 , 2 ) = - x ! p=0 column do l = 2 , lmax a ( l + 1 , 1 ) = - ( l - 1 ) * a ( l - 1 , 1 ) end do ! General recurrence do l = 2 , lmax do p = 1 , l a ( l + 1 , p + 1 ) = - ( l - 1 ) * a ( l - 1 , p + 1 ) - x * a ( l , p ) end do end do end subroutine rrdj0 ! ================================================================== !> Combines the three coordinate expansions. !> !> Unchanged from original (already well-screened). !> The screening on C1, C2 avoids unnecessary inner iterations. ! ================================================================== subroutine BesselDeriv ( BD , LL , MM , NN , a , b , c , LLmax ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( kind = ikind ), INTENT ( in ) :: LL , MM , NN , LLmax REAL ( kind = dp ), INTENT ( out ), DIMENSION ( LLmax + 1 ) :: BD REAL ( kind = dp ), INTENT ( in ), DIMENSION ( BDIM_MAX , BDIM_MAX ) :: a , b , c INTEGER ( kind = ikind ) :: ii , jj , kk , hOrder , temp , ceil REAL ( kind = dp ) :: C1 , C2 , C3 , Ct2 , Ct3 BD = 0.0_dp do ii = 0 , LL C1 = a ( LL + 1 , ii + 1 ) if ( abs ( C1 ) < 1.0E-30 ) cycle do jj = 0 , MM Ct2 = b ( MM + 1 , jj + 1 ) if ( abs ( Ct2 ) < 1.0E-30 ) cycle C2 = C1 * Ct2 do kk = 0 , NN Ct3 = c ( NN + 1 , kk + 1 ) if ( abs ( Ct3 ) < 1.0E-30 ) cycle C3 = C2 * Ct3 temp = LL + MM + NN - ii - jj - kk ceil = temp / 2_ikind + mod ( temp , 2_ikind ) hOrder = ceil + ii + jj + kk BD ( hOrder + 1 ) = BD ( hOrder + 1 ) + C3 end do end do end do end subroutine BesselDeriv ! ================================================================== !> Forward recurrence variant of bessels0rr (kept for compatibility). !> !> **Warning:** forward recurrence for j_l(x) is numerically unstable !> for l > x. Use bessels0rr (backward recurrence) for production. ! ================================================================== subroutine BesselSum ( h_sum , mu , H , LLmax , h_saved ) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( kind = dp ), INTENT ( in ), DIMENSION (:), allocatable :: mu REAL ( kind = dp ), INTENT ( in ) :: H INTEGER ( kind = ikind ), INTENT ( in ) :: LLmax REAL ( kind = dp ), INTENT ( in ), DIMENSION ( LLmax + 1 ) :: h_saved REAL ( kind = dp ), INTENT ( out ), DIMENSION ( size ( mu )) :: h_sum REAL ( kind = dp ), DIMENSION ( size ( mu )) :: Pmu , h_0 , h_1 , h_r , muOH REAL ( kind = dp ) :: coeff INTEGER ( kind = ikind ) :: ra Pmu = H * mu h_0 = sin ( Pmu ) / Pmu coeff = h_saved ( 1 ) h_sum = h_0 * coeff if ( LLmax == 1 ) then h_1 = ( sin ( Pmu ) / Pmu ** 2 - cos ( Pmu ) / Pmu ) * mu / H coeff = h_saved ( 2 ) h_sum = h_sum + coeff * h_1 else if ( LLmax > 1 ) then muOH = mu / H h_1 = ( sin ( Pmu ) / Pmu ** 2 - cos ( Pmu ) / Pmu ) * muOH coeff = h_saved ( 2 ) h_sum = h_sum + coeff * h_1 do ra = 2 , LLmax coeff = h_saved ( ra + 1 ) h_r = (( 2 * ra - 1 ) / ( Pmu ) * h_1 - h_0 * muOH ) * muOH h_sum = h_sum + h_r * coeff h_0 = h_1 h_1 = h_r end do end if end subroutine BesselSum end module Bessels_j0","tags":"","url":"sourcefile/xs_bessel_j0.f90.html"},{"title":"xs_kernel_j0.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - rotationally averaged (j0) two-electron scattering kernel !> !>      I2(q) = sum_{ijkr} Z(ij,kr) < chi_i chi_j | j0(q r12) | chi_k chi_r > !> !> chi are contracted Cartesian Gaussians and Z is a pair density in that !> basis.  The routine knows nothing about how Z was obtained: it is !> supplied by a \"density provider\" !> !>      mode 1 : explicit four-index array Z (8-fold symmetric) !>      mode 2 : built on the fly from two symmetric one-particle matrices !>      mode 3 : a sum of products of one-particle matrices (factored densities, e.g. CCSD): !>                 Z(a,b,c,d) = sum_k Ac_k(a,b) Bc_k(c,d)  [Coulomb pairing, Ac/Bc symmetric] !>                            + sum_k Ax_k(a,c) Bx_k(b,d)  [exchange pairing, any matrices], !>               symmetrised over the 8 index permutations inside the kernel !>                 Z(ij,kr) = wc/2 [A_ij B_kr + B_ij A_kr] !>                          + wx   [A_ik A_jr + A_ir A_jk] !>               wc = 1, wx = 0     -> elastic (A = B = D) or coherent mixed !>               wc = 0, wx = -1/4  -> closed-shell exchange !>               wc = 1, wx = -1/4  -> closed-shell mean field (Hartree-Fock) !> !> Algorithm: canonical loop over contracted-shell quartets with primitive !> quartets inside, shell-pair screening, thread-local buffers.  It is the !> \"one loop\" kernel of Moreno Carrascosa and co-workers, taking its input !> in memory instead of from files. !> !> Basis description (all arrays over primitive Cartesian functions): !> !>      x, y, z, ga   centre and exponent !>      l, m, n       Cartesian powers !>      group         primitive shell (same centre, exponent and l+m+n); !>                    numbered 1..ng, members contiguous !>      contr         index of the contracted function the primitive belongs to !>      coeff         contraction coefficient times normalisation !----------------------------------------------------------------------- module xs_kernel_j0 use Bessels_j0 use p0_cases use xs_hermite use xs_radial , only : radial_series use iso_fortran_env , only : int64 use iso_c_binding , only : c_char , c_int , c_double , c_funptr , c_associated , c_f_procpointer implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) integer ( kind = ikind ), parameter , private :: bdim = BDIM_MAX ! from the Bessel module (h functions) abstract interface !> BLAS dgemm in its Fortran calling convention (everything by reference) subroutine dgemm_iface ( transa , transb , m , n , k , alpha , a , lda , b , ldb , beta , c , ldc ) bind ( C ) import :: c_char , c_int , c_double character ( kind = c_char ), intent ( in ) :: transa , transb integer ( c_int ), intent ( in ) :: m , n , k , lda , ldb , ldc real ( c_double ), intent ( in ) :: alpha , beta real ( c_double ), intent ( in ) :: a ( * ), b ( * ) real ( c_double ), intent ( inout ) :: c ( * ) end subroutine dgemm_iface end interface contains !> The two-electron term I2(q) at every q of qin (lorder = 0), or its j2 P2 moment (lorder = 2), !> for the density provider selected by mode (see the module description).  tsi receives the !> result, stats the screening counts (shell quartets total/kept, primitive quartets total/kept); !> ierr = 0 on success, 1-8 for an inconsistent input (sizes, modes, l beyond the Bessel tables, !> non-contiguous groups). subroutine two_electron_j0 ( nprim , ncontr , nq , x , y , z , ga , l , m , n , group , contr , coeff , qin , & mode , zbig , da , db , wc , wx , nkc , ac , bc , nkx , ax , bx , dgemm_ptr , & cutoffcentre , cutoffz , cutoffmd , screen_tol , lorder , tsi , stats , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , ncontr , nq , mode , lorder , nkc , nkx type ( c_funptr ), intent ( in ) :: dgemm_ptr ! BLAS dgemm (Fortran ABI) or null: matmul real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), qin ( nq ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), pointer , intent ( in ) :: zbig (:, :, :, :) real ( kind = dp ), intent ( in ) :: da ( ncontr , ncontr ), db ( ncontr , ncontr ) real ( kind = dp ), intent ( in ) :: ac ( nkc , ncontr , ncontr ), bc ( nkc , ncontr , ncontr ) ! k fastest real ( kind = dp ), intent ( in ) :: ax ( nkx , ncontr , ncontr ), bx ( nkx , ncontr , ncontr ) real ( kind = dp ), intent ( in ) :: wc , wx , cutoffcentre , cutoffz , cutoffmd , screen_tol real ( kind = dp ), intent ( out ) :: tsi ( nq ) real ( kind = dp ), intent ( out ) :: stats ( 4 ) integer ( kind = ikind ), intent ( out ) :: ierr real ( kind = dp ), allocatable :: q (:) real ( kind = dp ), allocatable :: p0matrix (:, :, :, :) real ( kind = dp ), allocatable , target :: ddx (:, :, :, :, :), ddy (:, :, :, :, :), ddz (:, :, :, :, :) real ( kind = dp ), allocatable :: px (:, :), py (:, :), pz (:, :), e12 (:, :, :) real ( kind = dp ), allocatable :: xg (:), yg (:), zg (:), ag (:) integer ( kind = ikind ), allocatable :: lg (:), gstart (:), gcount (:) integer ( kind = ikind ), allocatable :: shell (:), shell_start (:), shell_end (:) integer ( kind = ikind ), allocatable :: tpi (:), tpj (:), order (:) real ( kind = dp ), allocatable :: wsh (:), psum (:), tsum (:), cost (:) integer ( kind = ikind ) :: npair , ip ! progress report on stderr (PYXSCAT_PROGRESS=1): cost-weighted share of the shell pairs started logical :: progress integer :: penv integer ( int64 ) :: clk0 , clk1 , clkrate real ( kind = dp ) :: costall , costdone , mydone , mycost , elapsed real ( kind = dp ), allocatable :: e12max (:, :), zpair (:, :), zs (:, :), e12s (:, :), cmaxg (:) ! thread-local work space real ( kind = dp ), allocatable :: zc (:, :, :, :), c1 (:), c2 (:), c3 (:), c4 (:), hpre (:, :, :, :), f (:) integer ( kind = ikind ), allocatable :: posI (:), posJ (:), posK (:), posR (:) real ( kind = dp ), pointer :: dx1 (:, :, :), dy1 (:, :, :), dz1 (:, :, :), dx2 (:, :, :), dy2 (:, :, :), dz2 (:, :, :) integer ( kind = ikind ) :: ng , maxl , max_gc , nshell , n4 integer ( kind = ikind ) :: i , j , k , r , ii , jj , a , b , c , d , g integer ( kind = ikind ) :: si , sj , sk , sr , sij , skr , srmax , gi0 , gj0 , gk0 , gr0 integer ( kind = ikind ) :: spi , spj , spk , spr , ij , kr real ( kind = dp ) :: pi , gap , hx , hy , hz , h , sym_factor , dmax , dmaxx real ( kind = dp ) :: bnd_ij , bnd , zblock , e12ij , maxe12s integer ( kind = int64 ) :: nshq_tot , nshq_done , nquart_tot , nquart_done logical :: same procedure ( dgemm_iface ), pointer :: dgemm => null () ierr = 0 tsi = 0.0_dp stats = 0.0_dp pi = acos ( - 1.0_dp ) ! ---- checks ---------------------------------------------------------------------- if ( nprim < 1 . or . ncontr < 1 . or . nq < 1 ) then ierr = 1 ; return end if if ( mode == 1 . and . . not . associated ( zbig )) then ierr = 2 ; return end if if ( mode /= 1 . and . mode /= 2 . and . mode /= 3 ) then ierr = 3 ; return end if if ( mode == 3 . and . nkc + nkx < 1 ) then ierr = 3 ; return end if ng = maxval ( group ) maxl = maxval ( l + m + n ) if ( lorder /= 0 . and . lorder /= 2 ) then ierr = 8 ; return end if if ( 4 * maxl + lorder + 1 > bdim ) then ierr = 4 ; return ! beyond the derivative orders of the Bessel module end if if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return ! groups must be contiguous and ascending end if end do if ( minval ( contr ) < 1 . or . maxval ( contr ) > ncontr ) then ierr = 6 ; return end if ! ---- primitive shells ------------------------------------------------------------ allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), xg ( ng ), yg ( ng ), zg ( ng ), ag ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) xg ( g ) = x ( i ); yg ( g ) = y ( i ); zg ( g ) = z ( i ); ag ( g ) = ga ( i ) else if ( l ( i ) + m ( i ) + n ( i ) /= lg ( g ) . or . ga ( i ) /= ag ( g ) . or . x ( i ) /= xg ( g ) & . or . y ( i ) /= yg ( g ) . or . z ( i ) /= zg ( g )) then ierr = 7 ; return ! members of a group must share centre, exponent and L end if end if gcount ( g ) = gcount ( g ) + 1 end do max_gc = maxval ( gcount ) ! ---- q grid, coincident-centre table, Hermite tables, pair prefactors ------------- allocate ( q ( nq )) q = qin n4 = 4 * maxl + lorder + 1 allocate ( p0matrix ( nq , n4 , n4 , n4 )) call p0_limits ( p0matrix , 4 * maxl + lorder , q ) allocate ( ddx ( 2 * maxl + 1 , maxl + 1 , maxl + 1 , ng , ng ), ddy ( 2 * maxl + 1 , maxl + 1 , maxl + 1 , ng , ng ), & ddz ( 2 * maxl + 1 , maxl + 1 , maxl + 1 , ng , ng )) call hermite_table ( ng , maxl , lg , xg , ag , ddx ) call hermite_table ( ng , maxl , lg , yg , ag , ddy ) call hermite_table ( ng , maxl , lg , zg , ag , ddz ) allocate ( px ( ng , ng ), py ( ng , ng ), pz ( ng , ng ), e12 ( nq , ng , ng )) do jj = 1 , ng do ii = 1 , ng gap = ag ( ii ) + ag ( jj ) px ( ii , jj ) = ( ag ( ii ) * xg ( ii ) + ag ( jj ) * xg ( jj )) / gap py ( ii , jj ) = ( ag ( ii ) * yg ( ii ) + ag ( jj ) * yg ( jj )) / gap pz ( ii , jj ) = ( ag ( ii ) * zg ( ii ) + ag ( jj ) * zg ( jj )) / gap e12 (:, ii , jj ) = ( pi / gap ) ** 1.5_dp * exp ( - q * q * 0.25_dp / gap ) & * exp ( - ag ( ii ) * ag ( jj ) / gap * (( xg ( ii ) - xg ( jj )) ** 2 + ( yg ( ii ) - yg ( jj )) ** 2 + ( zg ( ii ) - zg ( jj )) ** 2 )) end do end do ! ---- contracted shells: consecutive primitive shells addressing the same functions - allocate ( shell ( ng ), shell_start ( ng ), shell_end ( ng )) nshell = 0 do i = 1 , ng same = . false . if ( i > 1 ) then if ( gcount ( i ) == gcount ( i - 1 )) then same = all ( contr ( gstart ( i ): gstart ( i ) + gcount ( i ) - 1 ) == contr ( gstart ( i - 1 ): gstart ( i - 1 ) + gcount ( i - 1 ) - 1 )) end if end if if (. not . same ) then nshell = nshell + 1 shell_start ( nshell ) = i end if shell ( i ) = nshell shell_end ( nshell ) = i end do ! ---- screening tables --------------------------------------------------------------- !   |contribution(i,j,k,r)| <~ e12max(i,j) e12max(k,r) c_i c_j c_k c_r max|Z block| allocate ( e12max ( ng , ng ), cmaxg ( ng ), zs ( nshell , nshell ), e12s ( nshell , nshell )) e12max = maxval ( e12 , dim = 1 ) do i = 1 , ng cmaxg ( i ) = maxval ( abs ( coeff ( gstart ( i ): gstart ( i ) + gcount ( i ) - 1 ))) end do if ( mode == 1 ) then allocate ( zpair ( ncontr , ncontr )) zpair = 0.0_dp do jj = 1 , ncontr do ii = 1 , ncontr zpair = max ( zpair , abs ( zbig (:, :, ii , jj ))) end do end do else if ( mode == 2 ) then dmax = max ( maxval ( abs ( da )), maxval ( abs ( db ))) else ! sum_k max|A_k| max|B_k| bounds every element of the pair-density block dmax = 0.0_dp do k = 1 , nkc dmax = dmax + maxval ( abs ( ac ( k , :, :))) * maxval ( abs ( bc ( k , :, :))) end do dmaxx = 0.0_dp do k = 1 , nkx dmaxx = dmaxx + maxval ( abs ( ax ( k , :, :))) * maxval ( abs ( bx ( k , :, :))) end do if ( c_associated ( dgemm_ptr )) call c_f_procpointer ( dgemm_ptr , dgemm ) end if do sj = 1 , nshell do si = 1 , nshell ii = shell_start ( si ); jj = shell_start ( sj ) if ( mode == 1 ) then zs ( si , sj ) = 0.0_dp do r = gstart ( jj ), gstart ( jj ) + gcount ( jj ) - 1 do k = gstart ( ii ), gstart ( ii ) + gcount ( ii ) - 1 zs ( si , sj ) = max ( zs ( si , sj ), zpair ( contr ( k ), contr ( r ))) end do end do else if ( mode == 2 ) then zs ( si , sj ) = ( abs ( wc ) + 2.0_dp * abs ( wx )) * dmax * dmax ! rigorous, loose else zs ( si , sj ) = dmax end if e12s ( si , sj ) = 0.0_dp do j = shell_start ( sj ), shell_end ( sj ) do i = shell_start ( si ), shell_end ( si ) e12s ( si , sj ) = max ( e12s ( si , sj ), e12max ( i , j ) * cmaxg ( i ) * cmaxg ( j )) end do end do end do end do maxe12s = maxval ( e12s ) nshq_tot = 0 ; nshq_done = 0 ; nquart_tot = 0 ; nquart_done = 0 ! ---- tasks: one per shell pair (si <= sj), largest first ------------------------------- ! (one task per si left a few very large tasks: 15x at most on 32 threads for benzene) ! cost ~ w_i w_j sum_{(sk,sr) <= (si,sj)} w_k w_r, w = functions x primitives of a shell npair = merge ( 0_ikind , nshell * ( nshell + 1 ) / 2 , mode == 3 . and . nkc == 0 ) allocate ( tpi ( npair ), tpj ( npair ), order ( npair ), cost ( npair ), wsh ( nshell ), psum ( 0 : nshell ), tsum ( 0 : nshell )) do si = 1 , nshell wsh ( si ) = real (( shell_end ( si ) - shell_start ( si ) + 1 ) * gcount ( shell_start ( si )), dp ) end do psum ( 0 ) = 0.0_dp ; tsum ( 0 ) = 0.0_dp do si = 1 , nshell psum ( si ) = psum ( si - 1 ) + wsh ( si ) end do do si = 1 , nshell tsum ( si ) = tsum ( si - 1 ) + wsh ( si ) * ( psum ( nshell ) - psum ( si - 1 )) end do ip = 0 if ( npair > 0 ) then do si = 1 , nshell do sj = si , nshell ip = ip + 1 tpi ( ip ) = si ; tpj ( ip ) = sj cost ( ip ) = wsh ( si ) * wsh ( sj ) * ( tsum ( si - 1 ) + wsh ( si ) * ( psum ( sj ) - psum ( si - 1 ))) end do end do call sort_desc ( npair , cost , order ) end if call get_environment_variable ( \"PYXSCAT_PROGRESS\" , length = penv ) progress = penv > 0 . and . npair > 0 costall = 0.0_dp ; costdone = 0.0_dp if ( progress ) then costall = sum ( cost ) call system_clock ( clk0 , clkrate ) write ( 0 , '(a, i0, a)' ) \"  quartet kernel: \" , npair , \" shell pairs\" flush ( 0 ) end if ! ========================================================================================= ! CANONICAL LOOP OVER CONTRACTED-SHELL QUARTETS, PRIMITIVE QUARTETS INSIDE ! ========================================================================================= !$OMP PARALLEL default(shared) private(posI, posJ, posK, posR, spi, spj, spk, spr, zc, & !$OMP& f, h, hx, hy, hz, i, j, k, r, a, b, c, d, dx1, dx2, dy1, dy2, dz1, dz2, c1, c2, c3, c4, hpre, ij, kr, & !$OMP& sym_factor, si, sj, sk, sr, sij, skr, srmax, gi0, gj0, gk0, gr0, bnd_ij, bnd, zblock, e12ij, ip, & !$OMP& mydone, mycost, clk1, elapsed) & !$OMP& reduction(+:tsi, nshq_tot, nshq_done, nquart_tot, nquart_done) allocate ( zc ( max_gc , max_gc , max_gc , max_gc )) allocate ( c1 ( max_gc ), c2 ( max_gc ), c3 ( max_gc ), c4 ( max_gc )) allocate ( posI ( max_gc ), posJ ( max_gc ), posK ( max_gc ), posR ( max_gc )) allocate ( hpre ( bdim , n4 , n4 , n4 ), f ( nq )) !$OMP DO schedule(dynamic) do ip = 1 , npair si = tpi ( order ( ip )); sj = tpj ( order ( ip )) if ( progress ) then mycost = cost ( order ( ip )) !$OMP ATOMIC CAPTURE costdone = costdone + mycost mydone = costdone !$OMP END ATOMIC if ( floor ( 2 0.0_dp * mydone / costall ) > floor ( 2 0.0_dp * ( mydone - mycost ) / costall )) then call system_clock ( clk1 ) elapsed = real ( clk1 - clk0 , dp ) / real ( clkrate , dp ) !$OMP CRITICAL (xs_progress) write ( 0 , '(a, i3, a, f9.0, a, f9.0, a)' ) \"  quartet kernel: \" , nint ( 10 0.0_dp * mydone / costall ), & \"% started, \" , elapsed , \" s, about \" , & elapsed * ( costall - mydone ) / max ( mydone , 1.0e-300_dp ), \" s left\" flush ( 0 ) !$OMP END CRITICAL (xs_progress) end if end if sij = si * nshell + sj bnd_ij = e12s ( si , sj ) if ( bnd_ij * zs ( si , sj ) * maxe12s < screen_tol ) cycle gi0 = shell_start ( si ); gj0 = shell_start ( sj ) spi = gcount ( gi0 ); spj = gcount ( gj0 ) posI ( 1 : spi ) = contr ( gstart ( gi0 ): gstart ( gi0 ) + spi - 1 ) posJ ( 1 : spj ) = contr ( gstart ( gj0 ): gstart ( gj0 ) + spj - 1 ) do sk = 1 , si srmax = min ( nshell , sij - sk * nshell ) ! exactly (sk,sr) <= (si,sj) do sr = sk , srmax skr = sk * nshell + sr nshq_tot = nshq_tot + 1 bnd = bnd_ij * e12s ( sk , sr ) * min ( zs ( si , sj ), zs ( sk , sr )) if ( bnd < screen_tol ) cycle gk0 = shell_start ( sk ); gr0 = shell_start ( sr ) spk = gcount ( gk0 ); spr = gcount ( gr0 ) posK ( 1 : spk ) = contr ( gstart ( gk0 ): gstart ( gk0 ) + spk - 1 ) posR ( 1 : spr ) = contr ( gstart ( gr0 ): gstart ( gr0 ) + spr - 1 ) ! --- the pair-density block, once per shell quartet --------------------- if ( mode == 1 ) then ! explicit loops rather than a vector-subscripted section of a pointer ! array (the simplest form for every compiler) do d = 1 , spr do c = 1 , spk do b = 1 , spj do a = 1 , spi zc ( a , b , c , d ) = zbig ( posI ( a ), posJ ( b ), posK ( c ), posR ( d )) end do end do end do end do else if ( mode == 2 ) then do d = 1 , spr do c = 1 , spk do b = 1 , spj do a = 1 , spi zc ( a , b , c , d ) = & 0.5_dp * wc * ( da ( posI ( a ), posJ ( b )) * db ( posK ( c ), posR ( d )) & + db ( posI ( a ), posJ ( b )) * da ( posK ( c ), posR ( d ))) & + wx * ( da ( posI ( a ), posK ( c )) * da ( posJ ( b ), posR ( d )) & + da ( posI ( a ), posR ( d )) * da ( posJ ( b ), posK ( c ))) end do end do end do end do else ! factored density: the Coulomb-paired terms here (their block is 8-fold ! symmetric by itself), the exchange-paired ones in exchange_pass below call coulomb_block ( nkc , ncontr , ac , bc , posI , posJ , posK , posR , spi , spj , spk , spr , zc ) end if zblock = maxval ( abs ( zc ( 1 : spi , 1 : spj , 1 : spk , 1 : spr ))) if ( zblock * bnd_ij * e12s ( sk , sr ) < screen_tol ) cycle nshq_done = nshq_done + 1 ! --- primitive quartets of this shell quartet --------------------------- do i = shell_start ( si ), shell_end ( si ) c1 ( 1 : spi ) = coeff ( gstart ( i ): gstart ( i ) + spi - 1 ) do j = max ( i , shell_start ( sj )), shell_end ( sj ) ! i <= j ij = i * ng + j c2 ( 1 : spj ) = coeff ( gstart ( j ): gstart ( j ) + spj - 1 ) e12ij = e12max ( i , j ) * cmaxg ( i ) * cmaxg ( j ) * zblock do k = shell_start ( sk ), shell_end ( sk ) c3 ( 1 : spk ) = coeff ( gstart ( k ): gstart ( k ) + spk - 1 ) do r = max ( k , shell_start ( sr )), shell_end ( sr ) ! k <= r kr = k * ng + r if ( sij == skr . and . kr > ij ) cycle ! one representative per pair of pairs nquart_tot = nquart_tot + 1 if ( e12ij * e12max ( k , r ) * cmaxg ( k ) * cmaxg ( r ) < screen_tol ) cycle c4 ( 1 : spr ) = coeff ( gstart ( r ): gstart ( r ) + spr - 1 ) sym_factor = 1.0_dp if ( i /= j ) sym_factor = sym_factor * 2.0_dp if ( k /= r ) sym_factor = sym_factor * 2.0_dp if ( ij /= kr ) sym_factor = sym_factor * 2.0_dp hx = px ( k , r ) - px ( i , j ) hy = py ( k , r ) - py ( i , j ) hz = pz ( k , r ) - pz ( i , j ) h = sqrt ( hx * hx + hy * hy + hz * hz ) dx1 => ddx (:, :, :, j , i ) dy1 => ddy (:, :, :, j , i ) dz1 => ddz (:, :, :, j , i ) dx2 => ddx (:, :, :, r , k ) dy2 => ddy (:, :, :, r , k ) dz2 => ddz (:, :, :, r , k ) if ( h < cutoffcentre ) then call quartet_coincident ( nq , q , lorder , l , m , n , gstart , gcount , p0matrix , & dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , i , j , k , r , zc , c1 , c2 , c3 , c4 , & cutoffz , cutoffmd , f ) else call quartet_distant ( q , lorder , l , m , n , gstart , gcount , hx , hy , hz , h , & dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , i , j , k , r , zc , c1 , c2 , c3 , c4 , & cutoffz , cutoffmd , hpre , f ) end if nquart_done = nquart_done + 1 tsi = tsi + sym_factor * f * e12 (:, i , j ) * e12 (:, k , r ) end do end do end do end do end do end do end do !$OMP END DO deallocate ( zc , c1 , c2 , c3 , c4 , posI , posJ , posK , posR , hpre , f ) !$OMP END PARALLEL if ( mode == 3 . and . nkx > 0 ) then call exchange_pass ( nq , q , nkx , ncontr , ax , bx , dgemm , nshell , shell_start , shell_end , gstart , gcount , contr , & coeff , max_gc , n4 , lorder , l , m , n , p0matrix , ddx , ddy , ddz , px , py , pz , e12 , e12s , e12max , cmaxg , ng , & dmaxx , cutoffcentre , cutoffz , cutoffmd , screen_tol , tsi , nshq_tot , nshq_done , nquart_tot , nquart_done ) end if stats ( 1 ) = real ( nshq_tot , dp ) stats ( 2 ) = real ( nshq_done , dp ) stats ( 3 ) = real ( nquart_tot , dp ) stats ( 4 ) = real ( nquart_done , dp ) end subroutine two_electron_j0 ! --------------------------------------------------------------------------------- !> Exchange-paired factored terms, Z(a,b,c,d) = sum_k Ax_k(I_a, K_c) Bx_k(J_b, L_d), symmetrised !> over the 8 index permutations the canonical quartet loop assumes: !> !>      1/8 [A(I,K)B(J,L) + A(J,K)B(I,L) + A(I,L)B(J,K) + A(J,L)B(I,K) + the same with A, B transposed]. !> !> The shell quartets are the canonical ones (si <= sj, sk <= sr, (si,sj) >= (sk,sr)), visited !> with sk outside and a batch of si next, so that every factor block carries either batch !> indices (gathered once per batch or per sr) or inner indices (gathered once per sj and !> shared by the batch); each image is one matrix product over k (BLAS dgemm when given). ! --------------------------------------------------------------------------------- subroutine exchange_pass ( nq , q , nkx , ncontr , ax , bx , dgemm , nshell , shell_start , shell_end , gstart , gcount , contr , & coeff , max_gc , n4 , lorder , l , m , n , p0matrix , ddx , ddy , ddz , px , py , pz , e12 , e12s , e12max , cmaxg , ng , & dmaxx , cutoffcentre , cutoffz , cutoffmd , screen_tol , tsi , nshq_tot , nshq_done , nquart_tot , nquart_done ) integer ( kind = ikind ), intent ( in ) :: nq , nkx , ncontr , nshell , max_gc , n4 , lorder , ng real ( kind = dp ), intent ( in ), allocatable :: q (:) real ( kind = dp ), intent ( in ) :: ax ( nkx , ncontr , ncontr ), bx ( nkx , ncontr , ncontr ) procedure ( dgemm_iface ), pointer , intent ( in ) :: dgemm integer ( kind = ikind ), intent ( in ) :: shell_start (:), shell_end (:), gstart (:), gcount (:), contr (:), l (:), m (:), n (:) real ( kind = dp ), intent ( in ) :: coeff (:), p0matrix (:, :, :, :) real ( kind = dp ), intent ( in ), target :: ddx (:, :, :, :, :), ddy (:, :, :, :, :), ddz (:, :, :, :, :) real ( kind = dp ), intent ( in ) :: px (:, :), py (:, :), pz (:, :), e12 (:, :, :), e12s (:, :), e12max (:, :), cmaxg (:) real ( kind = dp ), intent ( in ) :: dmaxx , cutoffcentre , cutoffz , cutoffmd , screen_tol real ( kind = dp ), intent ( inout ) :: tsi (:) integer ( kind = int64 ), intent ( inout ) :: nshq_tot , nshq_done , nquart_tot , nquart_done integer ( kind = ikind ), parameter :: batch = 12 integer ( kind = ikind ) :: ntask , it , sk , s0 , s1 , si , sj , sr , nci , ci0 , spi , spj , spk , spr , mjl , mjk , mik , mil integer ( kind = ikind ) :: i , j , k , r , ij , kr , a , b , c , d , sij , skr , nb , t0 , t1 , ncj , cj0 integer ( kind = ikind ), allocatable :: tsk (:), ts0 (:), ts1 (:), cstart (:), posI (:), posJ (:), posK (:), posR (:), posB (:) integer ( kind = ikind ), allocatable :: jstart (:), posC (:) real ( kind = dp ), allocatable :: aik (:, :), bik (:, :), atik (:, :), btik (:, :) ! per batch (I, K) real ( kind = dp ), allocatable :: ail (:, :), bil (:, :), atil (:, :), btil (:, :) ! per sr    (I, L) real ( kind = dp ), allocatable :: ajk (:, :), bjk (:, :), ajl (:, :), bjl (:, :), atjk (:, :), btjk (:, :), atjl (:, :), btjl (:, :) real ( kind = dp ), allocatable :: y1 (:, :), y2 (:, :), y3 (:, :), y4 (:, :), y5 (:, :), y6 (:, :), y7 (:, :), y8 (:, :) real ( kind = dp ), allocatable :: zc (:, :, :, :), c1 (:), c2 (:), c3 (:), c4 (:), hpre (:, :, :, :), f (:) real ( kind = dp ) :: bnd , zblock , sym_factor , hx , hy , hz , h , e12ij real ( kind = dp ), pointer :: dx1 (:, :, :), dy1 (:, :, :), dz1 (:, :, :), dx2 (:, :, :), dy2 (:, :, :), dz2 (:, :, :) ! tasks: (sk, batch of si >= sk) ntask = 0 do sk = 1 , nshell ntask = ntask + ( nshell - sk + batch ) / batch end do allocate ( tsk ( ntask ), ts0 ( ntask ), ts1 ( ntask )) it = 0 do sk = 1 , nshell do s0 = sk , nshell , batch it = it + 1 tsk ( it ) = sk ; ts0 ( it ) = s0 ; ts1 ( it ) = min ( nshell , s0 + batch - 1 ) end do end do !$OMP PARALLEL default(shared) private(it, sk, s0, s1, si, sj, sr, nci, ci0, spi, spj, spk, spr, mjl, mjk, mik, mil, & !$OMP& i, j, k, r, ij, kr, a, b, c, d, sij, skr, nb, t0, t1, ncj, cj0, cstart, posI, posJ, posK, posR, posB, & !$OMP& jstart, posC, aik, bik, atik, btik, ail, bil, atil, btil, ajk, bjk, ajl, bjl, atjk, btjk, atjl, btjl, & !$OMP& y1, y2, y3, y4, y5, y6, y7, y8, zc, c1, c2, c3, c4, hpre, f, bnd, zblock, sym_factor, hx, hy, hz, h, e12ij, & !$OMP& dx1, dy1, dz1, dx2, dy2, dz2) reduction(+:tsi, nshq_tot, nshq_done, nquart_tot, nquart_done) nb = batch * max_gc allocate ( cstart ( batch + 1 ), jstart ( batch + 1 ), posI ( max_gc ), posJ ( max_gc ), posK ( max_gc ), posR ( max_gc ), posB ( nb ), posC ( nb )) allocate ( zc ( max_gc , max_gc , max_gc , max_gc ), c1 ( max_gc ), c2 ( max_gc ), c3 ( max_gc ), c4 ( max_gc )) allocate ( hpre ( bdim , n4 , n4 , n4 ), f ( nq )) allocate ( aik ( nkx , nb * max_gc ), bik ( nkx , nb * max_gc ), atik ( nkx , nb * max_gc ), btik ( nkx , nb * max_gc )) allocate ( ail ( nkx , nb * max_gc ), bil ( nkx , nb * max_gc ), atil ( nkx , nb * max_gc ), btil ( nkx , nb * max_gc )) allocate ( ajk ( nkx , nb * max_gc ), bjk ( nkx , nb * max_gc ), ajl ( nkx , nb * max_gc ), bjl ( nkx , nb * max_gc ), & atjk ( nkx , nb * max_gc ), btjk ( nkx , nb * max_gc ), atjl ( nkx , nb * max_gc ), btjl ( nkx , nb * max_gc )) allocate ( y1 ( nb * max_gc , nb * max_gc ), y2 ( nb * max_gc , nb * max_gc ), y3 ( nb * max_gc , nb * max_gc ), y4 ( nb * max_gc , nb * max_gc ), & y5 ( nb * max_gc , nb * max_gc ), y6 ( nb * max_gc , nb * max_gc ), y7 ( nb * max_gc , nb * max_gc ), y8 ( nb * max_gc , nb * max_gc )) !$OMP DO schedule(dynamic) do it = 1 , ntask sk = tsk ( it ); s0 = ts0 ( it ); s1 = ts1 ( it ) spk = gcount ( shell_start ( sk )) posK ( 1 : spk ) = contr ( gstart ( shell_start ( sk )): gstart ( shell_start ( sk )) + spk - 1 ) nci = 0 ! functions of the si batch, one list do si = s0 , s1 cstart ( si - s0 + 1 ) = nci + 1 spi = gcount ( shell_start ( si )) posB ( nci + 1 : nci + spi ) = contr ( gstart ( shell_start ( si )): gstart ( shell_start ( si )) + spi - 1 ) nci = nci + spi end do cstart ( s1 - s0 + 2 ) = nci + 1 if ( maxval ( e12s ( s0 : s1 , :)) * maxval ( e12s ( sk , :)) * dmaxx < screen_tol ) cycle mik = nci * spk do c = 1 , spk do a = 1 , nci aik (:, a + ( c - 1 ) * nci ) = ax (:, posB ( a ), posK ( c )) bik (:, a + ( c - 1 ) * nci ) = bx (:, posB ( a ), posK ( c )) atik (:, a + ( c - 1 ) * nci ) = ax (:, posK ( c ), posB ( a )) btik (:, a + ( c - 1 ) * nci ) = bx (:, posK ( c ), posB ( a )) end do end do do sr = sk , nshell spr = gcount ( shell_start ( sr )) skr = sk * nshell + sr if ( maxval ( e12s ( s0 : s1 , :)) * e12s ( sk , sr ) * dmaxx < screen_tol ) cycle posR ( 1 : spr ) = contr ( gstart ( shell_start ( sr )): gstart ( shell_start ( sr )) + spr - 1 ) mil = nci * spr do d = 1 , spr do a = 1 , nci ail (:, a + ( d - 1 ) * nci ) = ax (:, posB ( a ), posR ( d )) bil (:, a + ( d - 1 ) * nci ) = bx (:, posB ( a ), posR ( d )) atil (:, a + ( d - 1 ) * nci ) = ax (:, posR ( d ), posB ( a )) btil (:, a + ( d - 1 ) * nci ) = bx (:, posR ( d ), posB ( a )) end do end do do t0 = s0 , nshell , batch ! batches of sj (sj >= si for some si) t1 = min ( nshell , t0 + batch - 1 ) if ( maxval ( e12s ( s0 : s1 , t0 : t1 )) * e12s ( sk , sr ) * dmaxx < screen_tol ) cycle ncj = 0 do sj = t0 , t1 jstart ( sj - t0 + 1 ) = ncj + 1 spj = gcount ( shell_start ( sj )) posC ( ncj + 1 : ncj + spj ) = contr ( gstart ( shell_start ( sj )): gstart ( shell_start ( sj )) + spj - 1 ) ncj = ncj + spj end do jstart ( t1 - t0 + 2 ) = ncj + 1 mjl = ncj * spr ; mjk = ncj * spk do d = 1 , spr do b = 1 , ncj ajl (:, b + ( d - 1 ) * ncj ) = ax (:, posC ( b ), posR ( d )) bjl (:, b + ( d - 1 ) * ncj ) = bx (:, posC ( b ), posR ( d )) atjl (:, b + ( d - 1 ) * ncj ) = ax (:, posR ( d ), posC ( b )) btjl (:, b + ( d - 1 ) * ncj ) = bx (:, posR ( d ), posC ( b )) end do end do do c = 1 , spk do b = 1 , ncj ajk (:, b + ( c - 1 ) * ncj ) = ax (:, posC ( b ), posK ( c )) bjk (:, b + ( c - 1 ) * ncj ) = bx (:, posC ( b ), posK ( c )) atjk (:, b + ( c - 1 ) * ncj ) = ax (:, posK ( c ), posC ( b )) btjk (:, b + ( c - 1 ) * ncj ) = bx (:, posK ( c ), posC ( b )) end do end do ! the eight images for the whole (si batch) x (sj batch), one matrix product each call gemm_tn ( dgemm , nkx , mik , mjl , aik , bjl , y1 ) ! y1[(I,K),(J,L)] = A(I,K) B(J,L) call gemm_tn ( dgemm , nkx , mjk , mil , ajk , bil , y2 ) ! y2[(J,K),(I,L)] = A(J,K) B(I,L) call gemm_tn ( dgemm , nkx , mil , mjk , ail , bjk , y3 ) ! y3[(I,L),(J,K)] = A(I,L) B(J,K) call gemm_tn ( dgemm , nkx , mjl , mik , ajl , bik , y4 ) ! y4[(J,L),(I,K)] = A(J,L) B(I,K) call gemm_tn ( dgemm , nkx , mik , mjl , atik , btjl , y5 ) ! transposed factors call gemm_tn ( dgemm , nkx , mjk , mil , atjk , btil , y6 ) call gemm_tn ( dgemm , nkx , mil , mjk , atil , btjk , y7 ) call gemm_tn ( dgemm , nkx , mjl , mik , atjl , btik , y8 ) do sj = t0 , t1 spj = gcount ( shell_start ( sj )) cj0 = jstart ( sj - t0 + 1 ) - 1 posJ ( 1 : spj ) = posC ( cj0 + 1 : cj0 + spj ) do si = max ( s0 , sk ), min ( s1 , sj ) ! canonical: si <= sj, (si,sj) >= (sk,sr) sij = si * nshell + sj if ( sij < skr ) cycle nshq_tot = nshq_tot + 1 bnd = e12s ( si , sj ) * e12s ( sk , sr ) if ( bnd * dmaxx < screen_tol ) cycle spi = gcount ( shell_start ( si )) ci0 = cstart ( si - s0 + 1 ) - 1 posI ( 1 : spi ) = posB ( ci0 + 1 : ci0 + spi ) do d = 1 , spr do c = 1 , spk do b = 1 , spj do a = 1 , spi zc ( a , b , c , d ) = 0.125_dp * ( & y1 ( ci0 + a + ( c - 1 ) * nci , cj0 + b + ( d - 1 ) * ncj ) & + y5 ( ci0 + a + ( c - 1 ) * nci , cj0 + b + ( d - 1 ) * ncj ) & + y2 ( cj0 + b + ( c - 1 ) * ncj , ci0 + a + ( d - 1 ) * nci ) & + y6 ( cj0 + b + ( c - 1 ) * ncj , ci0 + a + ( d - 1 ) * nci ) & + y3 ( ci0 + a + ( d - 1 ) * nci , cj0 + b + ( c - 1 ) * ncj ) & + y7 ( ci0 + a + ( d - 1 ) * nci , cj0 + b + ( c - 1 ) * ncj ) & + y4 ( cj0 + b + ( d - 1 ) * ncj , ci0 + a + ( c - 1 ) * nci ) & + y8 ( cj0 + b + ( d - 1 ) * ncj , ci0 + a + ( c - 1 ) * nci )) end do end do end do end do zblock = maxval ( abs ( zc ( 1 : spi , 1 : spj , 1 : spk , 1 : spr ))) if ( zblock * bnd < screen_tol ) cycle nshq_done = nshq_done + 1 ! --- canonical primitive quartets, as in the main loop --- do i = shell_start ( si ), shell_end ( si ) c1 ( 1 : spi ) = coeff ( gstart ( i ): gstart ( i ) + spi - 1 ) do j = max ( i , shell_start ( sj )), shell_end ( sj ) ij = i * ng + j c2 ( 1 : spj ) = coeff ( gstart ( j ): gstart ( j ) + spj - 1 ) e12ij = e12max ( i , j ) * cmaxg ( i ) * cmaxg ( j ) * zblock do k = shell_start ( sk ), shell_end ( sk ) c3 ( 1 : spk ) = coeff ( gstart ( k ): gstart ( k ) + spk - 1 ) do r = max ( k , shell_start ( sr )), shell_end ( sr ) kr = k * ng + r if ( sij == skr . and . kr > ij ) cycle nquart_tot = nquart_tot + 1 if ( e12ij * e12max ( k , r ) * cmaxg ( k ) * cmaxg ( r ) < screen_tol ) cycle c4 ( 1 : spr ) = coeff ( gstart ( r ): gstart ( r ) + spr - 1 ) sym_factor = 1.0_dp if ( i /= j ) sym_factor = sym_factor * 2.0_dp if ( k /= r ) sym_factor = sym_factor * 2.0_dp if ( ij /= kr ) sym_factor = sym_factor * 2.0_dp hx = px ( k , r ) - px ( i , j ) hy = py ( k , r ) - py ( i , j ) hz = pz ( k , r ) - pz ( i , j ) h = sqrt ( hx * hx + hy * hy + hz * hz ) dx1 => ddx (:, :, :, j , i ); dy1 => ddy (:, :, :, j , i ); dz1 => ddz (:, :, :, j , i ) dx2 => ddx (:, :, :, r , k ); dy2 => ddy (:, :, :, r , k ); dz2 => ddz (:, :, :, r , k ) if ( h < cutoffcentre ) then call quartet_coincident ( nq , q , lorder , l , m , n , gstart , gcount , p0matrix , & dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , i , j , k , r , zc , c1 , c2 , c3 , c4 , & cutoffz , cutoffmd , f ) else call quartet_distant ( q , lorder , l , m , n , gstart , gcount , hx , hy , hz , h , & dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , i , j , k , r , zc , c1 , c2 , c3 , c4 , & cutoffz , cutoffmd , hpre , f ) end if nquart_done = nquart_done + 1 tsi = tsi + sym_factor * f * e12 (:, i , j ) * e12 (:, k , r ) end do end do end do end do end do end do end do end do end do !$OMP END DO deallocate ( cstart , jstart , posI , posJ , posK , posR , posB , posC , zc , c1 , c2 , c3 , c4 , hpre , f , aik , bik , atik , btik , & ail , bil , atil , btil , ajk , bjk , ajl , bjl , atjk , btjk , atjl , btjl , y1 , y2 , y3 , y4 , y5 , y6 , y7 , y8 ) !$OMP END PARALLEL deallocate ( tsk , ts0 , ts1 ) end subroutine exchange_pass !> idx = permutation that orders key descending (iterative merge sort, stable) subroutine sort_desc ( n , key , idx ) integer ( kind = ikind ), intent ( in ) :: n real ( kind = dp ), intent ( in ) :: key ( n ) integer ( kind = ikind ), intent ( out ) :: idx ( n ) integer ( kind = ikind ), allocatable :: tmp (:) integer ( kind = ikind ) :: width , lo , mid , hi , i , j , k allocate ( tmp ( n )) do i = 1 , n idx ( i ) = i end do width = 1 do while ( width < n ) lo = 1 do while ( lo <= n ) mid = min ( lo + width - 1 , n ); hi = min ( lo + 2 * width - 1 , n ) i = lo ; j = mid + 1 ; k = lo do while ( i <= mid . and . j <= hi ) if ( key ( idx ( i )) >= key ( idx ( j ))) then tmp ( k ) = idx ( i ); i = i + 1 else tmp ( k ) = idx ( j ); j = j + 1 end if k = k + 1 end do do while ( i <= mid ) tmp ( k ) = idx ( i ); i = i + 1 ; k = k + 1 end do do while ( j <= hi ) tmp ( k ) = idx ( j ); j = j + 1 ; k = k + 1 end do lo = lo + 2 * width end do idx = tmp width = 2 * width end do deallocate ( tmp ) end subroutine sort_desc !> z(1:ncol, 1:n) = a(1:nk, 1:ncol)&#94;T b(1:nk, 1:n), by BLAS dgemm when a pointer was given, else matmul subroutine gemm_tn ( dgemm , nk , ncol , n , a , b , z ) procedure ( dgemm_iface ), pointer , intent ( in ) :: dgemm integer ( kind = ikind ), intent ( in ) :: nk , ncol , n real ( kind = dp ), intent ( in ) :: a (:, :), b (:, :) real ( kind = dp ), intent ( inout ) :: z (:, :) integer ( c_int ) :: m_ , n_ , k_ , lda , ldb , ldc if ( associated ( dgemm )) then m_ = int ( ncol , c_int ); n_ = int ( n , c_int ); k_ = int ( nk , c_int ) lda = int ( size ( a , 1 ), c_int ); ldb = int ( size ( b , 1 ), c_int ); ldc = int ( size ( z , 1 ), c_int ) call dgemm ( 'T' , 'N' , m_ , n_ , k_ , 1.0_dp , a , lda , b , ldb , 0.0_dp , z , ldc ) else z ( 1 : ncol , 1 : n ) = matmul ( transpose ( a ( 1 : nk , 1 : ncol )), b ( 1 : nk , 1 : n )) end if end subroutine gemm_tn !> Pair-density block of a shell quartet from the Coulomb-paired factored terms, !> !>      sum_k 1/2 [Ac_k(I,J) Bc_k(K,L) + Bc_k(I,J) Ac_k(K,L)]     (Ac, Bc symmetric), !> !> which has the full 8-fold index symmetry of the canonical loop. subroutine coulomb_block ( nkc , ncontr , ac , bc , posI , posJ , posK , posR , spi , spj , spk , spr , zc ) integer ( kind = ikind ), intent ( in ) :: nkc , ncontr , spi , spj , spk , spr real ( kind = dp ), intent ( in ) :: ac ( nkc , ncontr , ncontr ), bc ( nkc , ncontr , ncontr ) integer ( kind = ikind ), intent ( in ) :: posI (:), posJ (:), posK (:), posR (:) real ( kind = dp ), intent ( inout ) :: zc (:, :, :, :) real ( kind = dp ) :: gij_a ( nkc , spi * spj ), gij_b ( nkc , spi * spj ), gkl_a ( nkc , spk * spr ), gkl_b ( nkc , spk * spr ) real ( kind = dp ) :: y ( spi * spj , spk * spr ) integer ( kind = ikind ) :: a , b , c , d do b = 1 , spj do a = 1 , spi gij_a (:, a + ( b - 1 ) * spi ) = ac (:, posI ( a ), posJ ( b )) gij_b (:, a + ( b - 1 ) * spi ) = bc (:, posI ( a ), posJ ( b )) end do end do do d = 1 , spr do c = 1 , spk gkl_a (:, c + ( d - 1 ) * spk ) = ac (:, posK ( c ), posR ( d )) gkl_b (:, c + ( d - 1 ) * spk ) = bc (:, posK ( c ), posR ( d )) end do end do y = matmul ( transpose ( gij_a ), gkl_b ) + matmul ( transpose ( gij_b ), gkl_a ) do d = 1 , spr do c = 1 , spk do b = 1 , spj do a = 1 , spi zc ( a , b , c , d ) = 0.5_dp * y ( a + ( b - 1 ) * spi , c + ( d - 1 ) * spk ) end do end do end do end do end subroutine coulomb_block ! ========================================================================= !> Pair centres coincide (h < cutoffcentre): tabulated limits ! ========================================================================= subroutine quartet_coincident ( nq , q , lorder , l , m , n , gs , gc , p0mat , dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , gi , gj , gk , gr , & zcontr , coeff1 , coeff2 , coeff3 , coeff4 , cutoff1 , cutoff2 , f ) integer ( kind = ikind ), intent ( in ) :: nq , gi , gj , gk , gr , lorder real ( kind = dp ), intent ( in ) :: q ( nq ) real ( kind = dp ), intent ( in ) :: cutoff1 , cutoff2 real ( kind = dp ), intent ( in ) :: p0mat (:, :, :, :) real ( kind = dp ), intent ( in ) :: dx1 (:, :, :), dy1 (:, :, :), dz1 (:, :, :), dx2 (:, :, :), dy2 (:, :, :), dz2 (:, :, :) real ( kind = dp ), intent ( in ) :: zcontr (:, :, :, :) real ( kind = dp ), intent ( in ) :: coeff1 (:), coeff2 (:), coeff3 (:), coeff4 (:) integer ( kind = ikind ), intent ( in ) :: gs (:), gc (:), l (:), m (:), n (:) real ( kind = dp ), intent ( out ) :: f ( nq ) integer ( kind = ikind ) :: ll , mm , nn , llp , mmp , nnp , i , j , k , r , posi , posj , posk , posr real ( kind = dp ) :: ztot , mdl , mdm , mdn , mdlp , mdmp , mdnp , prod6 , prod5 , prod4 , prod3 , prod2 , prod1 real ( kind = dp ) :: h1 , h1_base real ( kind = dp ) :: fzz ( nq ) f = 0.0_dp fzz = 0.0_dp posi = 1 do i = gs ( gi ), gs ( gi ) + gc ( gi ) - 1 posj = 1 do j = gs ( gj ), gs ( gj ) + gc ( gj ) - 1 posk = 1 do k = gs ( gk ), gs ( gk ) + gc ( gk ) - 1 posr = 1 do r = gs ( gr ), gs ( gr ) + gc ( gr ) - 1 ztot = zcontr ( posi , posj , posk , posr ) * coeff1 ( posi ) * coeff2 ( posj ) * coeff3 ( posk ) * coeff4 ( posr ) if ( abs ( ztot ) < cutoff1 ) then posr = posr + 1 cycle end if do ll = 0 , l ( i ) + l ( j ) mdl = dx1 ( ll + 1 , l ( i ) + 1 , l ( j ) + 1 ) if ( abs ( mdl ) < 1.0e-30_dp ) cycle prod1 = mdl * ztot do mm = 0 , m ( i ) + m ( j ) mdm = dy1 ( mm + 1 , m ( i ) + 1 , m ( j ) + 1 ) if ( abs ( mdm ) < 1.0e-30_dp ) cycle prod2 = mdm * prod1 if ( mod ( ll + mm , 2 ) == 0 ) then h1_base = 1.0_dp else h1_base = - 1.0_dp end if do nn = 0 , n ( i ) + n ( j ) if ( mod ( nn , 2 ) == 0 ) then h1 = h1_base else h1 = - h1_base end if mdn = dz1 ( nn + 1 , n ( i ) + 1 , n ( j ) + 1 ) if ( abs ( mdn ) < 1.0e-30_dp ) cycle prod3 = mdn * h1 * prod2 do llp = 0 , l ( k ) + l ( r ) mdlp = dx2 ( llp + 1 , l ( k ) + 1 , l ( r ) + 1 ) if ( abs ( mdlp ) < 1.0e-30_dp ) cycle prod4 = mdlp * prod3 do mmp = 0 , m ( k ) + m ( r ) mdmp = dy2 ( mmp + 1 , m ( k ) + 1 , m ( r ) + 1 ) if ( abs ( mdmp ) < 1.0e-30_dp ) cycle prod5 = mdmp * prod4 do nnp = 0 , n ( k ) + n ( r ) mdnp = dz2 ( nnp + 1 , n ( k ) + 1 , n ( r ) + 1 ) prod6 = mdnp * prod5 if ( abs ( prod6 ) > cutoff2 ) then f = f + prod6 * p0mat (:, ll + llp + 1 , mm + mmp + 1 , nn + nnp + 1 ) if ( lorder == 2 ) fzz = fzz & + prod6 * p0mat (:, ll + llp + 1 , mm + mmp + 1 , nn + nnp + 3 ) end if end do end do end do end do end do end do posr = posr + 1 end do posk = posk + 1 end do posj = posj + 1 end do posi = posi + 1 end do if ( lorder == 2 ) call combine_j2 ( q , f , fzz ) end subroutine quartet_coincident ! ========================================================================= !> Distinct pair centres: derivatives of j0(q h) through the Bessel module ! ========================================================================= subroutine quartet_distant ( mu , lorder , l , m , n , gs , gc , hx , hy , hz , h , dx1 , dy1 , dz1 , dx2 , dy2 , dz2 , gi , gj , gk , gr , & zcontr , coeff1 , coeff2 , coeff3 , coeff4 , cutoff1 , cutoff2 , hpre , f ) integer ( kind = ikind ), intent ( in ) :: gi , gj , gk , gr , lorder integer ( kind = ikind ), intent ( in ) :: l (:), m (:), n (:), gs (:), gc (:) real ( kind = dp ), intent ( in ) :: cutoff1 , cutoff2 , hx , hy , hz , h real ( kind = dp ), intent ( in ) :: zcontr (:, :, :, :) real ( kind = dp ), intent ( in ) :: coeff1 (:), coeff2 (:), coeff3 (:), coeff4 (:) real ( kind = dp ), intent ( in ), allocatable :: mu (:) real ( kind = dp ), intent ( in ) :: dx1 (:, :, :), dy1 (:, :, :), dz1 (:, :, :), dx2 (:, :, :), dy2 (:, :, :), dz2 (:, :, :) real ( kind = dp ), intent ( inout ) :: hpre (:, :, :, :) real ( kind = dp ), intent ( out ) :: f ( size ( mu )) integer ( kind = ikind ) :: posi , posj , posk , posr , i , j , k , r integer ( kind = ikind ) :: ll , mm , nn , llp , mmp , nnp , llmax real ( kind = dp ) :: ztot , mdn , mdl , mdm , mdlp , mdmp , mdnp real ( kind = dp ) :: prod1 , prod2 , prod3 , prod4 , prod5 , prod6 real ( kind = dp ) :: a ( bdim , bdim ), b ( bdim , bdim ), c ( bdim , bdim ) real ( kind = dp ) :: h_saved ( bdim ), h_saved2 ( bdim ), bd ( bdim ), fzz ( size ( mu )) integer ( kind = ikind ) :: lmx real ( kind = dp ) :: h1 , h1_base llmax = l ( gs ( gi )) + m ( gs ( gi )) + n ( gs ( gi )) + l ( gs ( gj )) + m ( gs ( gj )) + n ( gs ( gj )) + & l ( gs ( gk )) + m ( gs ( gk )) + n ( gs ( gk )) + l ( gs ( gr )) + m ( gs ( gr )) + n ( gs ( gr )) lmx = llmax + lorder call rrdj0 ( lmx , hx , a ) call rrdj0 ( lmx , hy , b ) call rrdj0 ( lmx , hz , c ) do k = 0 , lmx do j = 0 , lmx - k do i = 0 , lmx - k - j bd = 0.0_dp call BesselDeriv ( bd , k , j , i , a , b , c , lmx ) hpre (:, k + 1 , j + 1 , i + 1 ) = bd end do end do end do h_saved = 0.0_dp h_saved2 = 0.0_dp posi = 1 do i = gs ( gi ), gs ( gi ) + gc ( gi ) - 1 posj = 1 do j = gs ( gj ), gs ( gj ) + gc ( gj ) - 1 posk = 1 do k = gs ( gk ), gs ( gk ) + gc ( gk ) - 1 posr = 1 do r = gs ( gr ), gs ( gr ) + gc ( gr ) - 1 ztot = zcontr ( posi , posj , posk , posr ) * coeff1 ( posi ) * coeff2 ( posj ) * coeff3 ( posk ) * coeff4 ( posr ) if ( abs ( ztot ) < cutoff1 ) then posr = posr + 1 cycle end if do ll = 0 , l ( i ) + l ( j ) mdl = dx1 ( ll + 1 , l ( i ) + 1 , l ( j ) + 1 ) prod1 = mdl * ztot do mm = 0 , m ( i ) + m ( j ) mdm = dy1 ( mm + 1 , m ( i ) + 1 , m ( j ) + 1 ) prod2 = mdm * prod1 if ( mod ( ll + mm , 2 ) == 0 ) then h1_base = 1.0_dp else h1_base = - 1.0_dp end if do nn = 0 , n ( i ) + n ( j ) if ( mod ( nn , 2 ) == 0 ) then h1 = h1_base else h1 = - h1_base end if mdn = dz1 ( nn + 1 , n ( i ) + 1 , n ( j ) + 1 ) prod3 = mdn * h1 * prod2 do llp = 0 , l ( k ) + l ( r ) mdlp = dx2 ( llp + 1 , l ( k ) + 1 , l ( r ) + 1 ) prod4 = mdlp * prod3 do mmp = 0 , m ( k ) + m ( r ) mdmp = dy2 ( mmp + 1 , m ( k ) + 1 , m ( r ) + 1 ) prod5 = mdmp * prod4 do nnp = 0 , n ( k ) + n ( r ) mdnp = dz2 ( nnp + 1 , n ( k ) + 1 , n ( r ) + 1 ) prod6 = mdnp * prod5 if ( abs ( prod6 ) > cutoff2 ) then h_saved = h_saved + hpre (:, ll + llp + 1 , mm + mmp + 1 , nn + nnp + 1 ) * prod6 if ( lorder == 2 ) h_saved2 = h_saved2 & + hpre (:, ll + llp + 1 , mm + mmp + 1 , nn + nnp + 3 ) * prod6 end if end do end do end do end do end do end do posr = posr + 1 end do posk = posk + 1 end do posj = posj + 1 end do posi = posi + 1 end do ! sum_b h_saved(b+1) j_b(q h) (q/h)&#94;b, evaluated stably for every q h call radial_series ( size ( mu , kind = ikind ), mu , h , llmax , h_saved ( 1 : llmax + 1 ), f ) if ( lorder == 2 ) then call radial_series ( size ( mu , kind = ikind ), mu , h , lmx , h_saved2 ( 1 : lmx + 1 ), fzz ) call combine_j2 ( mu , f , fzz ) end if end subroutine quartet_distant ! ========================================================================= !> j2(q r) P2(cos theta) from j0 by the solid-harmonic (Hobson) theorem: !> !>      (3 d&#94;2/dz&#94;2 - Laplacian) j0(q r) = 2 q&#94;2 j2(q r) P2(cos theta),  Laplacian j0 = -q&#94;2 j0 !>      => j2 P2 = (3 d&#94;2/dz&#94;2 j0 + q&#94;2 j0) / (2 q&#94;2) !> !> f holds the j0 integral, fzz the same with two extra z derivatives. ! ========================================================================= subroutine combine_j2 ( q , f , fzz ) real ( kind = dp ), intent ( in ) :: q (:), fzz (:) real ( kind = dp ), intent ( inout ) :: f (:) where ( q > 1.0e-5_dp ) f = ( 3.0_dp * fzz + q * q * f ) / ( 2.0_dp * q * q ) elsewhere f = 0.0_dp end where end subroutine combine_j2 ! ========================================================================= !> Limits of the derivatives of j0(q h) at h = 0, any order: !> !>      d&#94;L/dx&#94;L d&#94;M/dy&#94;M d&#94;N/dz&#94;N j0(q|h|) at 0 = <(i q n_x)&#94;L (i q n_y)&#94;M (i q n_z)&#94;N>_n !>      = (-1)&#94;(S/2) q&#94;S (L-1)!! (M-1)!! (N-1)!! / (S+1)!!   (L, M, N even; S = L+M+N), else 0 ! ========================================================================= subroutine p0_limits ( p0 , smax , q ) real ( kind = dp ), intent ( out ) :: p0 (:, :, :, :) integer ( kind = ikind ), intent ( in ) :: smax real ( kind = dp ), intent ( in ) :: q (:) integer ( kind = ikind ) :: i , j , k , s real ( kind = dp ) :: c p0 = 0.0_dp do k = 0 , smax , 2 do j = 0 , smax , 2 do i = 0 , smax , 2 s = i + j + k c = dfact ( i - 1 ) * dfact ( j - 1 ) * dfact ( k - 1 ) / dfact ( s + 1 ) if ( mod ( s / 2 , 2 ) == 1 ) c = - c p0 (:, i + 1 , j + 1 , k + 1 ) = c * q ** s end do end do end do end subroutine p0_limits !> Double factorial n!! as a real (1 for n <= 1). pure real ( kind = dp ) function dfact ( n ) integer ( kind = ikind ), intent ( in ) :: n integer ( kind = ikind ) :: k dfact = 1.0_dp k = n do while ( k > 1 ) dfact = dfact * k k = k - 2 end do end function dfact end module xs_kernel_j0","tags":"","url":"sourcefile/xs_kernel_j0.f90.html"},{"title":"xs_rdm.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - spin-summed 1- and 2-RDMs of a determinant expansion, bitwise !> !> The determinant-pair (\"bitwise\") algorithm of the earlier code (twordm_jeremy.f90): !> every pair (I, J) is screened with popcnt(ieor(.)) and only pairs differing by at !> most two spin-orbitals contribute, through the Slater-Condon rules.  Cost ~ N_det&#94;2 !> for the screening (a few machine instructions per pair, OpenMP over I) plus the !> coupled pairs; independent of the size of the full CI space. !> !> Any number of orbitals: each spin string is nw = ceil(norb / 64) 64-bit words !> (orbital k in word k/64, bit mod(k, 64)).  The RDMs are accumulated in thread-private !> copies when nthreads x 8 norb&#94;4 bytes is small (< 2 GB), otherwise straight into the !> shared arrays with atomic updates (norb = 300: a 6.5 GB dm2, one copy). !> !> Conventions (as pyxscat.ci): determinant = alpha creators (ascending) then beta !> creators (ascending) on the vacuum; !> !>      dm1[p,q]     = sum_sigma <a+_{p sigma} a_{q sigma}> !>      dm2[p,q,r,s] = sum_{sigma tau} <a+_{p sigma} a+_{r tau} a_{s tau} a_{q sigma}> !> !> (C order on the Python side: here d1(q,p) and d2(s,r,q,p)). !----------------------------------------------------------------------- module xs_rdm use iso_fortran_env , only : int64 , real64 implicit none private public :: rdm12_bitwise , rdm12_bitwise_groups integer , parameter :: dp = real64 , i8 = int64 integer , parameter :: maxocc = 1024 ! occupied spin-orbitals of one determinant type :: accum logical :: atomic = . false . integer :: nint = - 1 ! >= 0: skip dm2 elements with all four orbitals >= nint real ( dp ), pointer :: a1 (:, :) => null () real ( dp ), pointer :: a2 (:, :, :, :) => null () end type accum contains !> number of set bits of w(1:nw) below spin-orbital k (0-based) pure integer function count_below ( w , nw , k ) integer , intent ( in ) :: nw , k integer ( i8 ), intent ( in ) :: w ( nw ) integer :: iw , kw iw = k / 64 + 1 kw = mod ( k , 64 ) count_below = popcnt ( iand ( w ( iw ), maskr ( kw , i8 ))) if ( iw > 1 ) count_below = count_below + sum ( popcnt ( w ( 1 : iw - 1 ))) end function count_below !> sign (-1)&#94;(number of occupied spin-orbitals before (k, spin)) in alpha-first order pure integer function before ( wa , wb , nw , k , spin ) integer , intent ( in ) :: nw , k , spin integer ( i8 ), intent ( in ) :: wa ( nw ), wb ( nw ) integer :: n if ( spin == 0 ) then n = count_below ( wa , nw , k ) else n = sum ( popcnt ( wa )) + count_below ( wb , nw , k ) end if before = 1 - 2 * modulo ( n , 2 ) end function before !> apply a_k (create = .false.) or a+_k (create = .true.) to (wa, wb); returns the sign integer function apply_op ( wa , wb , nw , k , spin , create ) integer , intent ( in ) :: nw , k , spin integer ( i8 ), intent ( inout ) :: wa ( nw ), wb ( nw ) logical , intent ( in ) :: create integer :: iw , kw apply_op = before ( wa , wb , nw , k , spin ) iw = k / 64 + 1 kw = mod ( k , 64 ) if ( spin == 0 ) then if ( create ) then wa ( iw ) = ibset ( wa ( iw ), kw ) else wa ( iw ) = ibclr ( wa ( iw ), kw ) end if else if ( create ) then wb ( iw ) = ibset ( wb ( iw ), kw ) else wb ( iw ) = ibclr ( wb ( iw ), kw ) end if end if end function apply_op !> the set spin-orbitals of the alpha and beta strings, as (orbital, spin) lists subroutine bits ( wa , wb , nw , orb , spn , n ) integer , intent ( in ) :: nw integer ( i8 ), intent ( in ) :: wa ( nw ), wb ( nw ) integer , intent ( out ) :: orb (:), spn (:), n integer ( i8 ) :: w integer :: iw n = 0 do iw = 1 , nw w = wa ( iw ) do while ( w /= 0_i8 ) n = n + 1 orb ( n ) = 64 * ( iw - 1 ) + trailz ( w ) spn ( n ) = 0 w = iand ( w , w - 1_i8 ) end do end do do iw = 1 , nw w = wb ( iw ) do while ( w /= 0_i8 ) n = n + 1 orb ( n ) = 64 * ( iw - 1 ) + trailz ( w ) spn ( n ) = 1 w = iand ( w , w - 1_i8 ) end do end do end subroutine bits !> first set bit of w(1:nw) (-1 if none) pure integer function first_bit ( w , nw ) integer , intent ( in ) :: nw integer ( i8 ), intent ( in ) :: w ( nw ) integer :: iw first_bit = - 1 do iw = 1 , nw if ( w ( iw ) /= 0_i8 ) then first_bit = 64 * ( iw - 1 ) + trailz ( w ( iw )) return end if end do end function first_bit !> Spin-summed d1 and d2 of the expansion with coefficients c over the determinants !> (wa(:, I), wb(:, I)), by the pair loop over all (I, J) on nthreads OpenMP threads. !> ierr = 1 when a determinant has more than maxocc occupied spin-orbitals. subroutine rdm12_bitwise ( ndet , norb , nw , wa , wb , c , d1 , d2 , nthreads , ierr ) integer , intent ( in ) :: ndet , norb , nw , nthreads integer ( i8 ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( dp ), intent ( in ) :: c ( ndet ) real ( dp ), intent ( out ), target :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer , intent ( out ) :: ierr real ( dp ), allocatable , target :: a1 (:, :), a2 (:, :, :, :) type ( accum ) :: acc integer :: i , j , nd , nthr , p , q , r , s , iw real ( dp ) :: bytes , tmp logical :: atomic ierr = 0 if ( norb < 1 . or . nw < ( norb + 63 ) / 64 ) then ierr = 1 return end if d1 = 0.0_dp d2 = 0.0_dp bytes = 8.0_dp * real ( norb , dp ) ** 4 atomic = bytes * real ( max ( 1 , nthreads ), dp ) > 2.0e9_dp nthr = max ( 1 , nthreads ) !$omp parallel num_threads(nthr) default(shared) private(a1, a2, acc, i, j, nd, iw) acc % atomic = atomic acc % nint = - 1 ! (private copies: do not rely on default initialisation) if ( atomic ) then acc % a1 => d1 acc % a2 => d2 else allocate ( a1 ( norb , norb ), a2 ( norb , norb , norb , norb )) a1 = 0.0_dp a2 = 0.0_dp acc % a1 => a1 acc % a2 => a2 end if !$omp do schedule(dynamic, 16) do i = 1 , ndet call diagonal ( wa (:, i ), wb (:, i ), nw , 0.5_dp * c ( i ) * c ( i ), acc ) do j = i + 1 , ndet nd = 0 do iw = 1 , nw nd = nd + popcnt ( ieor ( wa ( iw , i ), wa ( iw , j ))) + popcnt ( ieor ( wb ( iw , i ), wb ( iw , j ))) end do if ( nd > 4 ) cycle if ( nd == 2 ) then call single ( wa (:, i ), wb (:, i ), wa (:, j ), wb (:, j ), nw , c ( i ) * c ( j ), acc ) else if ( nd == 4 ) then call double ( wa (:, i ), wb (:, i ), wa (:, j ), wb (:, j ), nw , c ( i ) * c ( j ), acc ) end if end do end do !$omp end do if (. not . atomic ) then !$omp critical d1 = d1 + a1 d2 = d2 + a2 !$omp end critical deallocate ( a1 , a2 ) end if !$omp end parallel ! the pairs (J, I) are the Hermitian conjugates of (I, J): D + D&#94;T with ! dm1[p,q] <-> dm1[q,p] and dm2[p,q,r,s] <-> dm2[q,p,s,r] (diagonal entered with 1/2) d1 = d1 + transpose ( d1 ) !$omp parallel do default(shared) private(p, q, r, s, tmp) schedule(dynamic) do p = 1 , norb do q = 1 , norb do r = 1 , norb do s = 1 , norb if ( lower ( p , q , r , s )) then tmp = d2 ( s , r , q , p ) + d2 ( r , s , p , q ) d2 ( s , r , q , p ) = tmp d2 ( r , s , p , q ) = tmp else if ( p == q . and . r == s ) then d2 ( s , r , q , p ) = 2.0_dp * d2 ( s , r , q , p ) end if end do end do end do end do !$omp end parallel do contains !> (p,q,r,s) strictly before its partner (q,p,s,r) in lexicographic order pure logical function lower ( p , q , r , s ) integer , intent ( in ) :: p , q , r , s if ( p /= q ) then lower = p < q else lower = r < s end if end function lower end subroutine rdm12_bitwise !> The same pair loop restricted to candidate pairs: determinants are sorted into groups !> (contiguous, gstart(g):gstart(g+1)-1), and for group g only the groups !> nb(nbstart(g):nbstart(g+1)-1), all >= g, are paired with it (g itself first when it !> is to be included).  Elements of dm2 with all four orbitals >= nint are not accumulated !> (they are formed elsewhere); nint < 0 keeps them.  The (I, J) / (J, I) symmetrisation !> is applied as in rdm12_bitwise, so pairs must be listed once (g <= g'). subroutine rdm12_bitwise_groups ( ndet , norb , nw , wa , wb , c , nint , ng , gstart , grp , nnb , nbstart , nb , & d1 , d2 , nthreads , ierr ) integer , intent ( in ) :: ndet , norb , nw , nint , ng , nnb , nthreads integer ( i8 ), intent ( in ) :: wa ( nw , ndet ), wb ( nw , ndet ) real ( dp ), intent ( in ) :: c ( ndet ) integer , intent ( in ) :: gstart ( ng + 1 ), grp ( ndet ), nbstart ( ng + 1 ), nb ( nnb ) real ( dp ), intent ( out ), target :: d1 ( norb , norb ), d2 ( norb , norb , norb , norb ) integer , intent ( out ) :: ierr real ( dp ), allocatable , target :: a1 (:, :), a2 (:, :, :, :) type ( accum ) :: acc integer :: i , j , nd , nthr , p , q , r , s , iw , g , k , g2 , j0 , j1 real ( dp ) :: bytes , tmp logical :: atomic ierr = 0 if ( norb < 1 . or . nw < ( norb + 63 ) / 64 . or . ng < 1 ) then ierr = 1 return end if d1 = 0.0_dp d2 = 0.0_dp bytes = 8.0_dp * real ( norb , dp ) ** 4 atomic = bytes * real ( max ( 1 , nthreads ), dp ) > 2.0e9_dp nthr = max ( 1 , nthreads ) !$omp parallel num_threads(nthr) default(shared) private(a1, a2, acc, i, j, nd, iw, g, k, g2, j0, j1) acc % atomic = atomic acc % nint = nint if ( atomic ) then acc % a1 => d1 acc % a2 => d2 else allocate ( a1 ( norb , norb ), a2 ( norb , norb , norb , norb )) a1 = 0.0_dp a2 = 0.0_dp acc % a1 => a1 acc % a2 => a2 end if !$omp do schedule(dynamic, 16) do i = 1 , ndet call diagonal ( wa (:, i ), wb (:, i ), nw , 0.5_dp * c ( i ) * c ( i ), acc ) g = grp ( i ) do k = nbstart ( g ), nbstart ( g + 1 ) - 1 g2 = nb ( k ) j0 = gstart ( g2 ) if ( g2 == g ) j0 = i + 1 j1 = gstart ( g2 + 1 ) - 1 do j = j0 , j1 nd = 0 do iw = 1 , nw nd = nd + popcnt ( ieor ( wa ( iw , i ), wa ( iw , j ))) + popcnt ( ieor ( wb ( iw , i ), wb ( iw , j ))) end do if ( nd > 4 ) cycle if ( nd == 2 ) then call single ( wa (:, i ), wb (:, i ), wa (:, j ), wb (:, j ), nw , c ( i ) * c ( j ), acc ) else if ( nd == 4 ) then call double ( wa (:, i ), wb (:, i ), wa (:, j ), wb (:, j ), nw , c ( i ) * c ( j ), acc ) end if end do end do end do !$omp end do if (. not . atomic ) then !$omp critical d1 = d1 + a1 d2 = d2 + a2 !$omp end critical deallocate ( a1 , a2 ) end if !$omp end parallel d1 = d1 + transpose ( d1 ) !$omp parallel do default(shared) private(p, q, r, s, tmp) schedule(dynamic) do p = 1 , norb do q = 1 , norb do r = 1 , norb do s = 1 , norb if ( lower2 ( p , q , r , s )) then tmp = d2 ( s , r , q , p ) + d2 ( r , s , p , q ) d2 ( s , r , q , p ) = tmp d2 ( r , s , p , q ) = tmp else if ( p == q . and . r == s ) then d2 ( s , r , q , p ) = 2.0_dp * d2 ( s , r , q , p ) end if end do end do end do end do !$omp end parallel do contains !> (p,q,r,s) strictly before its partner (q,p,s,r) in lexicographic order pure logical function lower2 ( p , q , r , s ) integer , intent ( in ) :: p , q , r , s if ( p /= q ) then lower2 = p < q else lower2 = r < s end if end function lower2 end subroutine rdm12_bitwise_groups !> Diagonal pair `<I| ... |I>`: dm1[k,k] += w; dm2[u,u,v,v] += w over ordered pairs u /= v of occupied !> spin-orbitals, dm2[u,v,v,u] -= w when u and v have the same spin subroutine diagonal ( wa , wb , nw , w , acc ) integer , intent ( in ) :: nw integer ( i8 ), intent ( in ) :: wa ( nw ), wb ( nw ) real ( dp ), intent ( in ) :: w type ( accum ), intent ( inout ) :: acc integer :: orb ( maxocc ), spn ( maxocc ), n , u , v call bits ( wa , wb , nw , orb , spn , n ) do u = 1 , n call add1 ( acc , orb ( u ), orb ( u ), w ) do v = 1 , n if ( u == v ) cycle call add2 ( acc , orb ( u ), orb ( u ), orb ( v ), orb ( v ), w ) if ( spn ( u ) == spn ( v )) call add2 ( acc , orb ( u ), orb ( v ), orb ( v ), orb ( u ), - w ) end do end do end subroutine diagonal !> I = Phi a+_x a_h J (one spin-orbital differs); w = c_I c_J subroutine single ( ia , ib , ja , jb , nw , w , acc ) integer , intent ( in ) :: nw integer ( i8 ), intent ( in ) :: ia ( nw ), ib ( nw ), ja ( nw ), jb ( nw ) real ( dp ), intent ( in ) :: w type ( accum ), intent ( inout ) :: acc integer ( i8 ) :: ta ( nw ), tb ( nw ) integer :: orb ( maxocc ), spn ( maxocc ), n , x , h , sp , phi , k real ( dp ) :: v if ( any ( ia /= ja )) then sp = 0 x = first_bit ( iand ( ia , not ( ja )), nw ) h = first_bit ( iand ( ja , not ( ia )), nw ) else sp = 1 x = first_bit ( iand ( ib , not ( jb )), nw ) h = first_bit ( iand ( jb , not ( ib )), nw ) end if ta = ja tb = jb phi = apply_op ( ta , tb , nw , h , sp , . false .) phi = phi * apply_op ( ta , tb , nw , x , sp , . true .) v = real ( phi , dp ) * w call add1 ( acc , x , h , v ) ! dm1[x, h] call bits ( iand ( ia , ja ), iand ( ib , jb ), nw , orb , spn , n ) ! common spin-orbitals do k = 1 , n call add2 ( acc , x , h , orb ( k ), orb ( k ), v ) call add2 ( acc , orb ( k ), orb ( k ), x , h , v ) if ( spn ( k ) == sp ) then call add2 ( acc , x , orb ( k ), orb ( k ), h , - v ) call add2 ( acc , orb ( k ), h , x , orb ( k ), - v ) end if end do end subroutine single !> I = Phi a+_p1 a+_p2 a_h2 a_h1 J (two spin-orbitals differ); w = c_I c_J subroutine double ( ia , ib , ja , jb , nw , w , acc ) integer , intent ( in ) :: nw integer ( i8 ), intent ( in ) :: ia ( nw ), ib ( nw ), ja ( nw ), jb ( nw ) real ( dp ), intent ( in ) :: w type ( accum ), intent ( inout ) :: acc integer :: po ( 4 ), ps ( 4 ), np , ho ( 4 ), hs ( 4 ), nh , phi integer ( i8 ) :: ta ( nw ), tb ( nw ) real ( dp ) :: v call bits ( iand ( ia , not ( ja )), iand ( ib , not ( jb )), nw , po , ps , np ) ! particles (in I only) call bits ( iand ( ja , not ( ia )), iand ( jb , not ( ib )), nw , ho , hs , nh ) ! holes (in J only) ta = ja tb = jb phi = apply_op ( ta , tb , nw , ho ( 1 ), hs ( 1 ), . false .) phi = phi * apply_op ( ta , tb , nw , ho ( 2 ), hs ( 2 ), . false .) phi = phi * apply_op ( ta , tb , nw , po ( 2 ), ps ( 2 ), . true .) phi = phi * apply_op ( ta , tb , nw , po ( 1 ), ps ( 1 ), . true .) v = real ( phi , dp ) * w ! <I| a+_x a+_y a_z a_w |J>, {x,y} = {p1,p2}, {z,w} = {h1,h2}, spin(x)=spin(w), spin(y)=spin(z) if ( ps ( 1 ) == hs ( 1 ) . and . ps ( 2 ) == hs ( 2 )) then call add2 ( acc , po ( 1 ), ho ( 1 ), po ( 2 ), ho ( 2 ), v ) call add2 ( acc , po ( 2 ), ho ( 2 ), po ( 1 ), ho ( 1 ), v ) end if if ( ps ( 1 ) == hs ( 2 ) . and . ps ( 2 ) == hs ( 1 )) then call add2 ( acc , po ( 1 ), ho ( 2 ), po ( 2 ), ho ( 1 ), - v ) call add2 ( acc , po ( 2 ), ho ( 1 ), po ( 1 ), ho ( 2 ), - v ) end if end subroutine double !> dm1[p,q] (0-based, C order) += v subroutine add1 ( acc , p , q , v ) type ( accum ), intent ( inout ) :: acc integer , intent ( in ) :: p , q real ( dp ), intent ( in ) :: v if ( acc % atomic ) then !$omp atomic update acc % a1 ( q + 1 , p + 1 ) = acc % a1 ( q + 1 , p + 1 ) + v else acc % a1 ( q + 1 , p + 1 ) = acc % a1 ( q + 1 , p + 1 ) + v end if end subroutine add1 !> dm2[p,q,r,s] (0-based orbitals, C order) += v subroutine add2 ( acc , p , q , r , s , v ) type ( accum ), intent ( inout ) :: acc integer , intent ( in ) :: p , q , r , s real ( dp ), intent ( in ) :: v if ( acc % nint >= 0 ) then if ( min ( p , q , r , s ) >= acc % nint ) return end if if ( acc % atomic ) then !$omp atomic update acc % a2 ( s + 1 , r + 1 , q + 1 , p + 1 ) = acc % a2 ( s + 1 , r + 1 , q + 1 , p + 1 ) + v else acc % a2 ( s + 1 , r + 1 , q + 1 , p + 1 ) = acc % a2 ( s + 1 , r + 1 , q + 1 , p + 1 ) + v end if end subroutine add2 end module xs_rdm","tags":"","url":"sourcefile/xs_rdm.f90.html"},{"title":"xs_hermite.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - Hermite (McMurchie-Davidson) expansion coefficients !> !> For a pair of primitive shells A (centre xa, exponent a) and B (xb, b) !> the product of two 1D Cartesian Gaussians is expanded in Hermite !> Gaussians centred at P = (a xa + b xb)/(a + b): !> !>      (x-xa)&#94;i (x-xb)&#94;j exp(-a(x-xa)&#94;2 - b(x-xb)&#94;2) !>           = K_ab  sum_t E(t; i, j) Lambda_t(x - P) !> !> The Gaussian prefactor K_ab is NOT included here (it is carried by the !> pair prefactor of the kernel), so E(0; 0, 0) = 1. !> !> Two-term recurrences, valid for any angular momentum: !> !>      E(t; i+1, j) = E(t-1; i, j)/(2p) + (P-xa) E(t; i, j) + (t+1) E(t+1; i, j) !>      E(t; i, j+1) = E(t-1; i, j)/(2p) + (P-xb) E(t; i, j) + (t+1) E(t+1; i, j) !> !> This replaces the explicit tables of the original code (limited to g). !----------------------------------------------------------------------- module xs_hermite implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) contains !> dd(t+1, i+1, j+1, gb, ga): coefficients for the shell pair (ga, gb), !> i <= lg(ga), j <= lg(gb).  The index order (.., gb, ga) is the one the !> kernel expects. subroutine hermite_table ( ng , maxl , lg , xg , ag , dd ) integer ( kind = ikind ), intent ( in ) :: ng , maxl integer ( kind = ikind ), intent ( in ) :: lg ( ng ) real ( kind = dp ), intent ( in ) :: xg ( ng ), ag ( ng ) real ( kind = dp ), intent ( out ) :: dd ( 2 * maxl + 1 , maxl + 1 , maxl + 1 , ng , ng ) integer ( kind = ikind ) :: ga , gb , i , j , t real ( kind = dp ) :: p , pc , pa , pb , a2 ! The t index is padded on both sides (t = -1 and t = 2 maxl + 2 always hold zero), so ! the recurrence needs no guarded loads.  ifx 2026.1 at -O2/-O3 miscompiled the earlier ! form (with \"if (t > 0) lo = e(t-1, ...)\" inside an OpenMP loop over a private ! automatic array): the whole quartet kernel came out wrong.  The table is cheap ! (ng&#94;2 short recurrences), so it is also no longer threaded. real ( kind = dp ) :: e ( - 1 : 2 * maxl + 2 , 0 : maxl , 0 : maxl ) do ga = 1 , ng do gb = 1 , ng p = ag ( ga ) + ag ( gb ) pc = ( ag ( ga ) * xg ( ga ) + ag ( gb ) * xg ( gb )) / p pa = pc - xg ( ga ) pb = pc - xg ( gb ) a2 = 0.5_dp / p e = 0.0_dp e ( 0 , 0 , 0 ) = 1.0_dp ! raise i with j = 0 do i = 0 , lg ( ga ) - 1 do t = 0 , i + 1 e ( t , i + 1 , 0 ) = a2 * e ( t - 1 , i , 0 ) + pa * e ( t , i , 0 ) + real ( t + 1 , dp ) * e ( t + 1 , i , 0 ) end do end do ! raise j for every i do j = 0 , lg ( gb ) - 1 do i = 0 , lg ( ga ) do t = 0 , i + j + 1 e ( t , i , j + 1 ) = a2 * e ( t - 1 , i , j ) + pb * e ( t , i , j ) + real ( t + 1 , dp ) * e ( t + 1 , i , j ) end do end do end do dd (:, :, :, gb , ga ) = 0.0_dp do j = 0 , lg ( gb ) do i = 0 , lg ( ga ) do t = 0 , i + j dd ( t + 1 , i + 1 , j + 1 , gb , ga ) = e ( t , i , j ) end do end do end do end do end do end subroutine hermite_table end module xs_hermite","tags":"","url":"sourcefile/xs_hermite.f90.html"},{"title":"xs_elastic.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - rotationally averaged elastic scattering by density-weighted pairs !> !>      I(q) = sum_{mu nu la si} A_mu,nu B_la,si < chi_mu chi_nu | K_l(q r12) | chi_la chi_si > !> !> with K_0 = j0 (isotropic) or K_2 = j2 P2 (second Legendre moment about z).  A = B = D gives !> the elastic scattering <|F(q)|&#94;2>; A /= B the coherent mixed (transition) terms (symmetrised). !> !> The pair density of the elastic term is a product, D (x) D, so the density can be folded into !> each primitive-shell pair BEFORE the pairs are combined: every pair becomes one Hermite charge !> distribution W(tuv) at its centre P, !> !>      rho_P(r) = (pi/p)&#94;{3/2} K_ab sum_tuv W(tuv) Lambda_tuv(r - P), !> !> and the elastic term is a sum over pairs of pairs, !> !>      I(q) = sum_{P,Q} pref_P pref_Q exp(-q&#94;2/4p - q&#94;2/4p') sum_m S_m(P - Q) f_m(q, |P - Q|), !>      S_m  = sum_{TUV} U(TUV) sum_{ijk: T+U+V-i-j-k = m} a(T,i) a(U,j) a(V,k) hx&#94;(T-2i) hy&#94;(U-2j) hz&#94;(V-2k), !>      U(TUV) = sum_{tuv + t'u'v' = TUV} W_P(tuv) W_Q(t'u'v') (-1)&#94;(t'+u'+v'), !>      f_m  = (-q&#94;2)&#94;m j_m(qh)/(qh)&#94;m. !> !> Compared with the quartet kernel (which must loop over every Cartesian component of the four !> functions because a general 2RDM does not factorise), the work per pair of pairs is one !> convolution of two Hermite tables and one radial sum.  The radial functions j_m(x)/x&#94;m are !> evaluated stably at every x, so coincident and nearly coincident pair centres need no !> special treatment and lose no digits. !----------------------------------------------------------------------- module xs_elastic use xs_pairft , only : hermite_pair use xs_radial , only : jn_over_xn , hermite_radial_coeffs , upward_threshold use iso_fortran_env , only : int64 implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) contains !> I(q) at every q for the one-particle matrices da, db (elastic for da = db, coherent mixed !> otherwise), K_0 for lorder = 0 and K_2 for lorder = 2, by the pair-of-pairs algorithm of the !> module description.  Pairs whose bound is below screen are dropped; npairs_out returns the !> number of significant pairs and of pairs of pairs evaluated; ierr = 0 on success. subroutine elastic_pairs ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & da , db , lorder , screen , res , npairs_out , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq , lorder real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: da ( nao , nao ), db ( nao , nao ), screen real ( kind = dp ), intent ( out ) :: res ( nq ), npairs_out ( 2 ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , lp , ltot , t , u , v , k , ca , cb , np , ip , jp , iq integer ( kind = ikind ) :: ia , ib , ic , mm , la , lb , ntuv integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:), idx (:, :, :), lpair (:) integer ( kind = ikind ), allocatable :: it (:), iu (:), iv (:) real ( kind = dp ), allocatable :: cmax (:), ex (:, :, :), ey (:, :, :), ez (:, :, :) real ( kind = dp ), allocatable :: pc (:, :), pexp (:), ppref (:), wa (:, :), wb (:, :), wmax (:) real ( kind = dp ), allocatable :: uu (:), s0 (:), s3 (:), ax (:, :), ay (:, :), az (:, :), arad (:, :) real ( kind = dp ), allocatable :: fr (:), ga2 (:), gtab (:, :), qpow (:, :), xq (:), sx (:), cx (:), gm (:, :) real ( kind = dp ) :: rx , rx2 real ( kind = dp ), allocatable :: ub (:) integer ( kind = ikind ) :: nlast real ( kind = dp ), allocatable :: xup (:) integer ( kind = ikind ) :: kk real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc , dfa , dfb , hx , hy , hz , hh , sgn , bound , w , qq , sym real ( kind = dp ) :: val , cterm , eq2 integer ( kind = int64 ) :: npp , npp_done ierr = 0 res = 0.0_dp npairs_out = 0.0_dp if ( lorder /= 0 . and . lorder /= 2 ) then ierr = 8 ; return end if pi = acos ( - 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return end if end do allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), cmax ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) end if gcount ( g ) = gcount ( g ) + 1 end do do g = 1 , ng cmax ( g ) = maxval ( abs ( coeff ( gstart ( g ): gstart ( g ) + gcount ( g ) - 1 ))) end do lmax = maxval ( lg ) lp = 2 * lmax ! largest Hermite order of one pair ltot = 2 * lp + lorder ! largest order of a pair of pairs allocate ( idx ( 0 : ltot , 0 : ltot , 0 : ltot )) idx = 0 ntuv = 0 do k = 0 , ltot do t = 0 , k do u = 0 , k - t ntuv = ntuv + 1 idx ( t , u , k - t - u ) = ntuv end do end do end do allocate ( it ( ntuv ), iu ( ntuv ), iv ( ntuv )) do k = 0 , ltot do t = 0 , k do u = 0 , k - t it ( idx ( t , u , k - t - u )) = t ; iu ( idx ( t , u , k - t - u )) = u ; iv ( idx ( t , u , k - t - u )) = k - t - u end do end do end do ! ---- 1. density-weighted Hermite distributions of all significant pairs ---------------- np = ng * ( ng + 1 ) / 2 allocate ( pc ( 3 , np ), pexp ( np ), ppref ( np ), lpair ( np ), wmax ( np )) allocate ( wa ( ncum ( lp ), np ), wb ( ncum ( lp ), np )) allocate ( ex ( 0 : lp + 1 , 0 : lmax , 0 : lmax ), ey ( 0 : lp + 1 , 0 : lmax , 0 : lmax ), ez ( 0 : lp + 1 , 0 : lmax , 0 : lmax )) np = 0 do gi = 1 , ng do gj = gi , ng a = gstart ( gi ); b = gstart ( gj ) p = ga ( a ) + ga ( b ) kab = exp ( - ga ( a ) * ga ( b ) / p * (( x ( a ) - x ( b )) ** 2 + ( y ( a ) - y ( b )) ** 2 + ( z ( a ) - z ( b )) ** 2 )) pref = ( pi / p ) ** 1.5_dp * kab if ( pref * cmax ( gi ) * cmax ( gj ) < 1.0e-3_dp * screen ) cycle px = ( ga ( a ) * x ( a ) + ga ( b ) * x ( b )) / p py = ( ga ( a ) * y ( a ) + ga ( b ) * y ( b )) / p pz = ( ga ( a ) * z ( a ) + ga ( b ) * z ( b )) / p call hermite_pair ( lg ( gi ), lg ( gj ), px - x ( a ), px - x ( b ), p , ex ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), py - y ( a ), py - y ( b ), p , ey ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), pz - z ( a ), pz - z ( b ), p , ez ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) np = np + 1 wa (:, np ) = 0.0_dp wb (:, np ) = 0.0_dp do a = gstart ( gi ), gstart ( gi ) + gcount ( gi ) - 1 do b = gstart ( gj ), gstart ( gj ) + gcount ( gj ) - 1 ca = contr ( a ); cb = contr ( b ) dfa = da ( ca , cb ); dfb = db ( ca , cb ) if ( gi /= gj ) then dfa = dfa + da ( cb , ca ); dfb = dfb + db ( cb , ca ) end if cc = coeff ( a ) * coeff ( b ) if ( dfa == 0.0_dp . and . dfb == 0.0_dp ) cycle do t = 0 , l ( a ) + l ( b ) do u = 0 , m ( a ) + m ( b ) do v = 0 , n ( a ) + n ( b ) w = cc * ex ( t , l ( a ), l ( b )) * ey ( u , m ( a ), m ( b )) * ez ( v , n ( a ), n ( b )) wa ( idx ( t , u , v ), np ) = wa ( idx ( t , u , v ), np ) + dfa * w wb ( idx ( t , u , v ), np ) = wb ( idx ( t , u , v ), np ) + dfb * w end do end do end do end do end do wmax ( np ) = pref * max ( maxval ( abs ( wa (:, np ))), maxval ( abs ( wb (:, np )))) if ( wmax ( np ) == 0.0_dp ) then np = np - 1 ; cycle end if pc (:, np ) = [ px , py , pz ] pexp ( np ) = p ppref ( np ) = pref lpair ( np ) = lg ( gi ) + lg ( gj ) end do end do deallocate ( ex , ey , ez ) ! ---- 2. pairs of pairs --------------------------------------------------------------- ! q tables shared by all threads: pref_P exp(-q&#94;2/4p) and (-q&#94;2)&#94;m allocate ( gtab ( nq , np ), qpow ( 0 : ltot , nq )) do ip = 1 , np do iq = 1 , nq gtab ( iq , ip ) = ppref ( ip ) * exp ( - q ( iq ) ** 2 / ( 4.0_dp * pexp ( ip ))) end do end do do iq = 1 , nq qpow ( 0 , iq ) = 1.0_dp do mm = 1 , ltot qpow ( mm , iq ) = - qpow ( mm - 1 , iq ) * q ( iq ) ** 2 end do end do ! upward recurrence only where it is stable (see xs_radial: upward_threshold) allocate ( xup ( 0 : ltot )) do kk = 0 , ltot xup ( kk ) = upward_threshold ( kk ) end do npp = 0 ; npp_done = 0 !$OMP PARALLEL default(shared) private(ip, jp, la, lb, k, ia, ib, ic, mm, hx, hy, hz, & !$OMP& hh, sgn, bound, uu, s0, s3, ax, ay, az, arad, fr, ga2, iq, qq, val, sym, cterm, eq2, & !$OMP& xq, sx, cx, gm, rx, rx2, kk, ub, nlast) & !$OMP& reduction(+:res, npp, npp_done) allocate ( uu ( ntuv ), s0 ( 0 : ltot ), s3 ( 0 : ltot ), ax ( 0 : ltot , 0 : ltot / 2 ), ay ( 0 : ltot , 0 : ltot / 2 ), & az ( 0 : ltot , 0 : ltot / 2 ), arad ( 0 : ltot , 0 : ltot / 2 ), fr ( 0 : ltot ), ga2 ( nq ), xq ( nq ), sx ( nq ), cx ( nq ), & gm ( 0 : ltot , nq ), ub ( 0 : ltot )) call hermite_radial_coeffs ( ltot , arad ) !$OMP DO schedule(dynamic, 4) do ip = 1 , np do jp = ip , np npp = npp + 1 sym = 2.0_dp if ( ip == jp ) sym = 1.0_dp la = lpair ( ip ); lb = lpair ( jp ) ! U(TUV) = 1/2 sum [Wa_P Wb_Q + Wb_P Wa_Q](tuv, t'u'v') (-1)&#94;(t'+u'+v') k = la + lb uu ( 1 : ncum ( k )) = 0.0_dp do ia = 1 , ncum ( la ) if ( wa ( ia , ip ) == 0.0_dp . and . wb ( ia , ip ) == 0.0_dp ) cycle do ib = 1 , ncum ( lb ) sgn = 1.0_dp if ( mod ( it ( ib ) + iu ( ib ) + iv ( ib ), 2 ) == 1 ) sgn = - 1.0_dp ic = idx ( it ( ia ) + it ( ib ), iu ( ia ) + iu ( ib ), iv ( ia ) + iv ( ib )) uu ( ic ) = uu ( ic ) + 0.5_dp * sgn * ( wa ( ia , ip ) * wb ( ib , jp ) + wb ( ia , ip ) * wa ( ib , jp )) end do end do ! Screening.  |d&#94;tuv j0(q|h|)| <= q&#94;(t+u+v), so the contribution at q is bounded by ! sym pref_P pref_Q exp(-q&#94;2/4p - q&#94;2/4p') sum_m |U_m| q&#94;m (x 2 for j2 P2).  With q in ! ascending order, drop the tail of q points where the bound is below screen. do mm = 0 , k ub ( mm ) = sum ( abs ( uu ( ncum ( mm - 1 ) + 1 : ncum ( mm )))) end do nlast = nq do while ( nlast >= 1 ) qq = q ( nlast ) bound = 0.0_dp do mm = k , 0 , - 1 bound = bound * qq + ub ( mm ) end do bound = bound * sym * gtab ( nlast , ip ) * gtab ( nlast , jp ) * real ( 1 + lorder , dp ) if ( bound >= screen ) exit nlast = nlast - 1 end do if ( nlast == 0 ) cycle npp_done = npp_done + 1 hx = pc ( 1 , ip ) - pc ( 1 , jp ) hy = pc ( 2 , ip ) - pc ( 2 , jp ) hz = pc ( 3 , ip ) - pc ( 3 , jp ) hh = sqrt ( hx * hx + hy * hy + hz * hz ) ! per-direction tables a(T,i) h&#94;(T-2i) call powers ( ltot , hx , arad , ax ) call powers ( ltot , hy , arad , ay ) call powers ( ltot , hz , arad , az ) ! S_m for K_0 (and the shifted table for the 3 d&#94;2/dz&#94;2 of Hobson's theorem) call radial_sum ( k , uu , 0 , ax , ay , az , ltot , s0 ) if ( lorder == 2 ) call radial_sum ( k , uu , 2 , ax , ay , az , ltot , s3 ) ! q dependence: sum_m S_m (-q&#94;2)&#94;m j_m(qh)/(qh)&#94;m if ( lorder == 0 . and . k == 0 ) then ! s-type charge distributions (the most common case): S_0 j0(qh) do iq = 1 , nlast qq = q ( iq ) * hh if ( qq > 1.0e-3_dp ) then val = sin ( qq ) / qq else val = 1.0_dp - qq * qq / 6.0_dp * ( 1.0_dp - qq * qq / 2 0.0_dp ) end if res ( iq ) = res ( iq ) + sym * gtab ( iq , ip ) * gtab ( iq , jp ) * s0 ( 0 ) * val end do cycle end if ! general case, vectorised over q: upward recurrence where it is stable (x > K + 1), ! the careful scalar routine elsewhere kk = k + lorder do iq = 1 , nlast xq ( iq ) = q ( iq ) * hh end do do iq = 1 , nlast sx ( iq ) = sin ( xq ( iq )) cx ( iq ) = cos ( xq ( iq )) end do do iq = 1 , nlast if ( xq ( iq ) > xup ( kk )) then rx = 1.0_dp / xq ( iq ) rx2 = rx * rx gm ( 0 , iq ) = sx ( iq ) * rx if ( kk >= 1 ) gm ( 1 , iq ) = ( gm ( 0 , iq ) - cx ( iq )) * rx2 do mm = 1 , kk - 1 gm ( mm + 1 , iq ) = ( real ( 2 * mm + 1 , dp ) * gm ( mm , iq ) - gm ( mm - 1 , iq )) * rx2 end do else call jn_over_xn ( xq ( iq ), kk , gm ( 0 : kk , iq )) end if end do do iq = 1 , nlast val = 0.0_dp qq = q ( iq ) if ( lorder == 0 ) then do mm = 0 , k val = val + s0 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) end do else if ( qq > 0.0_dp ) then do mm = 0 , k + 2 if ( mm <= k ) val = val + qq * qq * s0 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) val = val + 3.0_dp * s3 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) end do val = val / ( 2.0_dp * qq * qq ) end if res ( iq ) = res ( iq ) + sym * gtab ( iq , ip ) * gtab ( iq , jp ) * val end do end do end do !$OMP END DO deallocate ( uu , s0 , s3 , ax , ay , az , arad , fr , ga2 , xq , sx , cx , gm , ub ) !$OMP END PARALLEL deallocate ( gtab , qpow , xup ) npairs_out ( 1 ) = real ( npp , dp ) npairs_out ( 2 ) = real ( npp_done , dp ) contains !> number of (t,u,v) with t+u+v <= kk (they are packed first by order) pure integer ( kind = ikind ) function ncum ( kk ) integer ( kind = ikind ), intent ( in ) :: kk ncum = ( kk + 1 ) * ( kk + 2 ) * ( kk + 3 ) / 6 ! 0 for kk = -1 end function ncum !> out(T, i) = a(T, i) hc&#94;(T-2i), the per-direction table of one pair of pairs pure subroutine powers ( lt , hc , ar , out ) integer ( kind = ikind ), intent ( in ) :: lt real ( kind = dp ), intent ( in ) :: hc , ar ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ), intent ( out ) :: out ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ) :: hp ( 0 : lt ) integer ( kind = ikind ) :: tt , ii hp ( 0 ) = 1.0_dp do tt = 1 , lt hp ( tt ) = hp ( tt - 1 ) * hc end do out = 0.0_dp do tt = 0 , lt do ii = 0 , tt / 2 out ( tt , ii ) = ar ( tt , ii ) * hp ( tt - 2 * ii ) end do end do end subroutine powers !> s(m) = sum_TUV U(TUV) sum_ijk ax(T',i) ay(U,j) az(V',k), m = T'+U+V'-i-j-k, with the z order !> shifted by dz (0, or 2 for d&#94;2/dz&#94;2) !> (the private work arrays of the OpenMP region are passed explicitly: a contained !> procedure would otherwise see the host's shared copies) subroutine radial_sum ( kk , uin , dz , bx , by , bz , lt , s ) integer ( kind = ikind ), intent ( in ) :: kk , lt integer , intent ( in ) :: dz real ( kind = dp ), intent ( in ) :: uin (:), bx ( 0 : lt , 0 : lt / 2 ), by ( 0 : lt , 0 : lt / 2 ), bz ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ), intent ( out ) :: s ( 0 :) integer ( kind = ikind ) :: c , tt , uv , vv , i1 , j1 , k1 , ord real ( kind = dp ) :: c1 , c2 s ( 0 : kk + dz ) = 0.0_dp do c = 1 , ncum ( kk ) if ( uin ( c ) == 0.0_dp ) cycle tt = it ( c ); uv = iu ( c ); vv = iv ( c ) + dz do i1 = 0 , tt / 2 c1 = uin ( c ) * bx ( tt , i1 ) if ( c1 == 0.0_dp ) cycle do j1 = 0 , uv / 2 c2 = c1 * by ( uv , j1 ) if ( c2 == 0.0_dp ) cycle do k1 = 0 , vv / 2 ord = tt + uv + vv - i1 - j1 - k1 s ( ord ) = s ( ord ) + c2 * bz ( vv , k1 ) end do end do end do end do end subroutine radial_sum end subroutine elastic_pairs end module xs_elastic","tags":"","url":"sourcefile/xs_elastic.f90.html"},{"title":"xs_nuclear.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !----------------------------------------------------------------------- !> PyXSCAT - electron-nucleus term of electron scattering !> !> In the first Born approximation a fast electron is scattered by the full !> charge distribution, nuclei and electrons: !> !>      dsigma/dOmega = 4 / (a0&#94;2 q&#94;4) < | sum_A Z_A exp(iq.R_A) - F(q) |&#94;2 >  + inelastic !> !> which, rotationally averaged, needs one quantity beyond X-ray scattering, !> the electron-nucleus cross term !> !>      I_ne(q) = sum_A Z_A sum_mu,nu D_mu,nu int chi_mu chi_nu K_l(q, r - R_A) dr !> !> with K_0 = j0(q|h|) (isotropic signal) or K_2 = j2(q|h|) P2(cos theta_h) !> (second Legendre moment about z, aligned molecules). !> !> Each primitive pair is expanded in Hermite Gaussians at the pair centre P: !> !>      int Lambda_tuv(r - P) j0(q|r - A|) dr = (pi/p)&#94;{3/2} exp(-q&#94;2/4p) d&#94;{t+u+v}/dh&#94;tuv j0(q|h|), !>      h = P - A, !> !> and the Cartesian derivatives of the radial function j0(q|h|) follow from !> the McMurchie-Davidson recursion with the auxiliary functions !> !>      f_n(h) = (1/h d/dh)&#94;n j0(q h) = (-q&#94;2)&#94;n j_n(qh) / (qh)&#94;n. !> !> j2 P2 follows from Hobson's theorem: j2(qh) P2(cos theta) = [3 d&#94;2/dhz&#94;2 + q&#94;2] j0(qh) / (2 q&#94;2). !> Nothing is singular when a nucleus sits on a pair centre (h = 0). !----------------------------------------------------------------------- module xs_nuclear use xs_pairft , only : hermite_pair use xs_radial , only : jn_over_xn implicit none integer , parameter , private :: dp = selected_real_kind ( 15 ) integer , parameter , private :: ikind = selected_int_kind ( 8 ) contains !> Hermite derivatives R(k) = d&#94;{t+u+v}/dh_x&#94;t dh_y&#94;u dh_z&#94;v j0(q|h|) for t+u+v <= lmax, !> packed by idx(t,u,v). pure subroutine j0_derivatives ( q , hx , hy , hz , lmax , ldim , idx , ntuv , r ) real ( kind = dp ), intent ( in ) :: q , hx , hy , hz integer ( kind = ikind ), intent ( in ) :: lmax , ldim , ntuv integer ( kind = ikind ), intent ( in ) :: idx ( 0 : ldim , 0 : ldim , 0 : ldim ) real ( kind = dp ), intent ( out ) :: r ( ntuv ) real ( kind = dp ) :: g ( 0 : lmax ), old ( ntuv ), fn , q2n integer ( kind = ikind ) :: n , t , u , v , k call jn_over_xn ( q * sqrt ( hx * hx + hy * hy + hz * hz ), lmax , g ) old = 0.0_dp r = 0.0_dp do n = lmax , 0 , - 1 q2n = ( - q * q ) ** n fn = q2n * g ( n ) r ( idx ( 0 , 0 , 0 )) = fn do k = 1 , lmax - n do t = 0 , k do u = 0 , k - t v = k - t - u if ( t > 0 ) then r ( idx ( t , u , v )) = hx * old ( idx ( t - 1 , u , v )) if ( t > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( t - 1 ) * old ( idx ( t - 2 , u , v )) else if ( u > 0 ) then r ( idx ( t , u , v )) = hy * old ( idx ( t , u - 1 , v )) if ( u > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( u - 1 ) * old ( idx ( t , u - 2 , v )) else r ( idx ( t , u , v )) = hz * old ( idx ( t , u , v - 1 )) if ( v > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( v - 1 ) * old ( idx ( t , u , v - 2 )) end if end do end do end do if ( n > 0 ) old = r end do end subroutine j0_derivatives !> I_ne(q) = sum_A zat(A) sum_mu,nu dm(mu,nu) int chi_mu chi_nu K_lorder(q, r - R_A) dr subroutine electron_nucleus ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & natom , zat , rat , dm , lorder , screen , res , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq , natom , lorder real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: zat ( natom ), rat ( 3 , natom ), dm ( nao , nao ), screen real ( kind = dp ), intent ( out ) :: res ( nq ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , lder , iq , t , u , v , ca , cb , iat , ntuv , k integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:), idx (:, :, :) real ( kind = dp ), allocatable :: cmax (:), ex (:, :, :), ey (:, :, :), ez (:, :, :), rr (:, :), w (:) real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc , dmax , dfac , s , gq ierr = 0 res = 0.0_dp if ( lorder /= 0 . and . lorder /= 2 ) then ierr = 8 ; return end if pi = acos ( - 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) .