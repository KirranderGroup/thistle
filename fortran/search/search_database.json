 ncum (kk) number of (t,u,v) with t+u+v <= kk (they are packed first by order) Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: kk Return Value integer(kind=ikind) Subroutines pure subroutine powers (lt, hc, ar, out) out(T, i) = a(T, i) hc&#94;(T-2i), the per-direction table of one pair of pairs Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: lt real(kind=dp), intent(in) :: hc real(kind=dp), intent(in) :: ar (0:lt,0:lt/2) real(kind=dp), intent(out) :: out (0:lt,0:lt/2) subroutine radial_sum (kk, uin, dz, bx, by, bz, lt, s) s(m) = sum_TUV U(TUV) sum_ijk ax(T',i) ay(U,j) az(V',k), m = T'+U+V'-i-j-k, with the z order\nshifted by dz (0, or 2 for d&#94;2/dz&#94;2)\n(the private work arrays of the OpenMP region are passed explicitly: a contained\nprocedure would otherwise see the host's shared copies) Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: kk real(kind=dp), intent(in) :: uin (:) integer, intent(in) :: dz real(kind=dp), intent(in) :: bx (0:lt,0:lt/2) real(kind=dp), intent(in) :: by (0:lt,0:lt/2) real(kind=dp), intent(in) :: bz (0:lt,0:lt/2) integer(kind=ikind), intent(in) :: lt real(kind=dp), intent(out) :: s (0:) Source Code subroutine elastic_pairs ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & da , db , lorder , screen , res , npairs_out , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq , lorder real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: da ( nao , nao ), db ( nao , nao ), screen real ( kind = dp ), intent ( out ) :: res ( nq ), npairs_out ( 2 ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , lp , ltot , t , u , v , k , ca , cb , np , ip , jp , iq integer ( kind = ikind ) :: ia , ib , ic , mm , la , lb , ntuv integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:), idx (:, :, :), lpair (:) integer ( kind = ikind ), allocatable :: it (:), iu (:), iv (:) real ( kind = dp ), allocatable :: cmax (:), ex (:, :, :), ey (:, :, :), ez (:, :, :) real ( kind = dp ), allocatable :: pc (:, :), pexp (:), ppref (:), wa (:, :), wb (:, :), wmax (:) real ( kind = dp ), allocatable :: uu (:), s0 (:), s3 (:), ax (:, :), ay (:, :), az (:, :), arad (:, :) real ( kind = dp ), allocatable :: fr (:), ga2 (:), gtab (:, :), qpow (:, :), xq (:), sx (:), cx (:), gm (:, :) real ( kind = dp ) :: rx , rx2 real ( kind = dp ), allocatable :: ub (:) integer ( kind = ikind ) :: nlast real ( kind = dp ), allocatable :: xup (:) integer ( kind = ikind ) :: kk real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc , dfa , dfb , hx , hy , hz , hh , sgn , bound , w , qq , sym real ( kind = dp ) :: val , cterm , eq2 integer ( kind = int64 ) :: npp , npp_done ierr = 0 res = 0.0_dp npairs_out = 0.0_dp if ( lorder /= 0 . and . lorder /= 2 ) then ierr = 8 ; return end if pi = acos ( - 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return end if end do allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), cmax ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) end if gcount ( g ) = gcount ( g ) + 1 end do do g = 1 , ng cmax ( g ) = maxval ( abs ( coeff ( gstart ( g ): gstart ( g ) + gcount ( g ) - 1 ))) end do lmax = maxval ( lg ) lp = 2 * lmax ! largest Hermite order of one pair ltot = 2 * lp + lorder ! largest order of a pair of pairs allocate ( idx ( 0 : ltot , 0 : ltot , 0 : ltot )) idx = 0 ntuv = 0 do k = 0 , ltot do t = 0 , k do u = 0 , k - t ntuv = ntuv + 1 idx ( t , u , k - t - u ) = ntuv end do end do end do allocate ( it ( ntuv ), iu ( ntuv ), iv ( ntuv )) do k = 0 , ltot do t = 0 , k do u = 0 , k - t it ( idx ( t , u , k - t - u )) = t ; iu ( idx ( t , u , k - t - u )) = u ; iv ( idx ( t , u , k - t - u )) = k - t - u end do end do end do ! ---- 1. density-weighted Hermite distributions of all significant pairs ---------------- np = ng * ( ng + 1 ) / 2 allocate ( pc ( 3 , np ), pexp ( np ), ppref ( np ), lpair ( np ), wmax ( np )) allocate ( wa ( ncum ( lp ), np ), wb ( ncum ( lp ), np )) allocate ( ex ( 0 : lp + 1 , 0 : lmax , 0 : lmax ), ey ( 0 : lp + 1 , 0 : lmax , 0 : lmax ), ez ( 0 : lp + 1 , 0 : lmax , 0 : lmax )) np = 0 do gi = 1 , ng do gj = gi , ng a = gstart ( gi ); b = gstart ( gj ) p = ga ( a ) + ga ( b ) kab = exp ( - ga ( a ) * ga ( b ) / p * (( x ( a ) - x ( b )) ** 2 + ( y ( a ) - y ( b )) ** 2 + ( z ( a ) - z ( b )) ** 2 )) pref = ( pi / p ) ** 1.5_dp * kab if ( pref * cmax ( gi ) * cmax ( gj ) < 1.0e-3_dp * screen ) cycle px = ( ga ( a ) * x ( a ) + ga ( b ) * x ( b )) / p py = ( ga ( a ) * y ( a ) + ga ( b ) * y ( b )) / p pz = ( ga ( a ) * z ( a ) + ga ( b ) * z ( b )) / p call hermite_pair ( lg ( gi ), lg ( gj ), px - x ( a ), px - x ( b ), p , ex ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), py - y ( a ), py - y ( b ), p , ey ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), pz - z ( a ), pz - z ( b ), p , ez ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) np = np + 1 wa (:, np ) = 0.0_dp wb (:, np ) = 0.0_dp do a = gstart ( gi ), gstart ( gi ) + gcount ( gi ) - 1 do b = gstart ( gj ), gstart ( gj ) + gcount ( gj ) - 1 ca = contr ( a ); cb = contr ( b ) dfa = da ( ca , cb ); dfb = db ( ca , cb ) if ( gi /= gj ) then dfa = dfa + da ( cb , ca ); dfb = dfb + db ( cb , ca ) end if cc = coeff ( a ) * coeff ( b ) if ( dfa == 0.0_dp . and . dfb == 0.0_dp ) cycle do t = 0 , l ( a ) + l ( b ) do u = 0 , m ( a ) + m ( b ) do v = 0 , n ( a ) + n ( b ) w = cc * ex ( t , l ( a ), l ( b )) * ey ( u , m ( a ), m ( b )) * ez ( v , n ( a ), n ( b )) wa ( idx ( t , u , v ), np ) = wa ( idx ( t , u , v ), np ) + dfa * w wb ( idx ( t , u , v ), np ) = wb ( idx ( t , u , v ), np ) + dfb * w end do end do end do end do end do wmax ( np ) = pref * max ( maxval ( abs ( wa (:, np ))), maxval ( abs ( wb (:, np )))) if ( wmax ( np ) == 0.0_dp ) then np = np - 1 ; cycle end if pc (:, np ) = [ px , py , pz ] pexp ( np ) = p ppref ( np ) = pref lpair ( np ) = lg ( gi ) + lg ( gj ) end do end do deallocate ( ex , ey , ez ) ! ---- 2. pairs of pairs --------------------------------------------------------------- ! q tables shared by all threads: pref_P exp(-q&#94;2/4p) and (-q&#94;2)&#94;m allocate ( gtab ( nq , np ), qpow ( 0 : ltot , nq )) do ip = 1 , np do iq = 1 , nq gtab ( iq , ip ) = ppref ( ip ) * exp ( - q ( iq ) ** 2 / ( 4.0_dp * pexp ( ip ))) end do end do do iq = 1 , nq qpow ( 0 , iq ) = 1.0_dp do mm = 1 , ltot qpow ( mm , iq ) = - qpow ( mm - 1 , iq ) * q ( iq ) ** 2 end do end do ! upward recurrence only where it is stable (see xs_radial: upward_threshold) allocate ( xup ( 0 : ltot )) do kk = 0 , ltot xup ( kk ) = upward_threshold ( kk ) end do npp = 0 ; npp_done = 0 !$OMP PARALLEL default(shared) private(ip, jp, la, lb, k, ia, ib, ic, mm, hx, hy, hz, & !$OMP& hh, sgn, bound, uu, s0, s3, ax, ay, az, arad, fr, ga2, iq, qq, val, sym, cterm, eq2, & !$OMP& xq, sx, cx, gm, rx, rx2, kk, ub, nlast) & !$OMP& reduction(+:res, npp, npp_done) allocate ( uu ( ntuv ), s0 ( 0 : ltot ), s3 ( 0 : ltot ), ax ( 0 : ltot , 0 : ltot / 2 ), ay ( 0 : ltot , 0 : ltot / 2 ), & az ( 0 : ltot , 0 : ltot / 2 ), arad ( 0 : ltot , 0 : ltot / 2 ), fr ( 0 : ltot ), ga2 ( nq ), xq ( nq ), sx ( nq ), cx ( nq ), & gm ( 0 : ltot , nq ), ub ( 0 : ltot )) call hermite_radial_coeffs ( ltot , arad ) !$OMP DO schedule(dynamic, 4) do ip = 1 , np do jp = ip , np npp = npp + 1 sym = 2.0_dp if ( ip == jp ) sym = 1.0_dp la = lpair ( ip ); lb = lpair ( jp ) ! U(TUV) = 1/2 sum [Wa_P Wb_Q + Wb_P Wa_Q](tuv, t'u'v') (-1)&#94;(t'+u'+v') k = la + lb uu ( 1 : ncum ( k )) = 0.0_dp do ia = 1 , ncum ( la ) if ( wa ( ia , ip ) == 0.0_dp . and . wb ( ia , ip ) == 0.0_dp ) cycle do ib = 1 , ncum ( lb ) sgn = 1.0_dp if ( mod ( it ( ib ) + iu ( ib ) + iv ( ib ), 2 ) == 1 ) sgn = - 1.0_dp ic = idx ( it ( ia ) + it ( ib ), iu ( ia ) + iu ( ib ), iv ( ia ) + iv ( ib )) uu ( ic ) = uu ( ic ) + 0.5_dp * sgn * ( wa ( ia , ip ) * wb ( ib , jp ) + wb ( ia , ip ) * wa ( ib , jp )) end do end do ! Screening.  |d&#94;tuv j0(q|h|)| <= q&#94;(t+u+v), so the contribution at q is bounded by ! sym pref_P pref_Q exp(-q&#94;2/4p - q&#94;2/4p') sum_m |U_m| q&#94;m (x 2 for j2 P2).  With q in ! ascending order, drop the tail of q points where the bound is below screen. do mm = 0 , k ub ( mm ) = sum ( abs ( uu ( ncum ( mm - 1 ) + 1 : ncum ( mm )))) end do nlast = nq do while ( nlast >= 1 ) qq = q ( nlast ) bound = 0.0_dp do mm = k , 0 , - 1 bound = bound * qq + ub ( mm ) end do bound = bound * sym * gtab ( nlast , ip ) * gtab ( nlast , jp ) * real ( 1 + lorder , dp ) if ( bound >= screen ) exit nlast = nlast - 1 end do if ( nlast == 0 ) cycle npp_done = npp_done + 1 hx = pc ( 1 , ip ) - pc ( 1 , jp ) hy = pc ( 2 , ip ) - pc ( 2 , jp ) hz = pc ( 3 , ip ) - pc ( 3 , jp ) hh = sqrt ( hx * hx + hy * hy + hz * hz ) ! per-direction tables a(T,i) h&#94;(T-2i) call powers ( ltot , hx , arad , ax ) call powers ( ltot , hy , arad , ay ) call powers ( ltot , hz , arad , az ) ! S_m for K_0 (and the shifted table for the 3 d&#94;2/dz&#94;2 of Hobson's theorem) call radial_sum ( k , uu , 0 , ax , ay , az , ltot , s0 ) if ( lorder == 2 ) call radial_sum ( k , uu , 2 , ax , ay , az , ltot , s3 ) ! q dependence: sum_m S_m (-q&#94;2)&#94;m j_m(qh)/(qh)&#94;m if ( lorder == 0 . and . k == 0 ) then ! s-type charge distributions (the most common case): S_0 j0(qh) do iq = 1 , nlast qq = q ( iq ) * hh if ( qq > 1.0e-3_dp ) then val = sin ( qq ) / qq else val = 1.0_dp - qq * qq / 6.0_dp * ( 1.0_dp - qq * qq / 2 0.0_dp ) end if res ( iq ) = res ( iq ) + sym * gtab ( iq , ip ) * gtab ( iq , jp ) * s0 ( 0 ) * val end do cycle end if ! general case, vectorised over q: upward recurrence where it is stable (x > K + 1), ! the careful scalar routine elsewhere kk = k + lorder do iq = 1 , nlast xq ( iq ) = q ( iq ) * hh end do do iq = 1 , nlast sx ( iq ) = sin ( xq ( iq )) cx ( iq ) = cos ( xq ( iq )) end do do iq = 1 , nlast if ( xq ( iq ) > xup ( kk )) then rx = 1.0_dp / xq ( iq ) rx2 = rx * rx gm ( 0 , iq ) = sx ( iq ) * rx if ( kk >= 1 ) gm ( 1 , iq ) = ( gm ( 0 , iq ) - cx ( iq )) * rx2 do mm = 1 , kk - 1 gm ( mm + 1 , iq ) = ( real ( 2 * mm + 1 , dp ) * gm ( mm , iq ) - gm ( mm - 1 , iq )) * rx2 end do else call jn_over_xn ( xq ( iq ), kk , gm ( 0 : kk , iq )) end if end do do iq = 1 , nlast val = 0.0_dp qq = q ( iq ) if ( lorder == 0 ) then do mm = 0 , k val = val + s0 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) end do else if ( qq > 0.0_dp ) then do mm = 0 , k + 2 if ( mm <= k ) val = val + qq * qq * s0 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) val = val + 3.0_dp * s3 ( mm ) * qpow ( mm , iq ) * gm ( mm , iq ) end do val = val / ( 2.0_dp * qq * qq ) end if res ( iq ) = res ( iq ) + sym * gtab ( iq , ip ) * gtab ( iq , jp ) * val end do end do end do !$OMP END DO deallocate ( uu , s0 , s3 , ax , ay , az , arad , fr , ga2 , xq , sx , cx , gm , ub ) !$OMP END PARALLEL deallocate ( gtab , qpow , xup ) npairs_out ( 1 ) = real ( npp , dp ) npairs_out ( 2 ) = real ( npp_done , dp ) contains !> number of (t,u,v) with t+u+v <= kk (they are packed first by order) pure integer ( kind = ikind ) function ncum ( kk ) integer ( kind = ikind ), intent ( in ) :: kk ncum = ( kk + 1 ) * ( kk + 2 ) * ( kk + 3 ) / 6 ! 0 for kk = -1 end function ncum !> out(T, i) = a(T, i) hc&#94;(T-2i), the per-direction table of one pair of pairs pure subroutine powers ( lt , hc , ar , out ) integer ( kind = ikind ), intent ( in ) :: lt real ( kind = dp ), intent ( in ) :: hc , ar ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ), intent ( out ) :: out ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ) :: hp ( 0 : lt ) integer ( kind = ikind ) :: tt , ii hp ( 0 ) = 1.0_dp do tt = 1 , lt hp ( tt ) = hp ( tt - 1 ) * hc end do out = 0.0_dp do tt = 0 , lt do ii = 0 , tt / 2 out ( tt , ii ) = ar ( tt , ii ) * hp ( tt - 2 * ii ) end do end do end subroutine powers !> s(m) = sum_TUV U(TUV) sum_ijk ax(T',i) ay(U,j) az(V',k), m = T'+U+V'-i-j-k, with the z order !> shifted by dz (0, or 2 for d&#94;2/dz&#94;2) !> (the private work arrays of the OpenMP region are passed explicitly: a contained !> procedure would otherwise see the host's shared copies) subroutine radial_sum ( kk , uin , dz , bx , by , bz , lt , s ) integer ( kind = ikind ), intent ( in ) :: kk , lt integer , intent ( in ) :: dz real ( kind = dp ), intent ( in ) :: uin (:), bx ( 0 : lt , 0 : lt / 2 ), by ( 0 : lt , 0 : lt / 2 ), bz ( 0 : lt , 0 : lt / 2 ) real ( kind = dp ), intent ( out ) :: s ( 0 :) integer ( kind = ikind ) :: c , tt , uv , vv , i1 , j1 , k1 , ord real ( kind = dp ) :: c1 , c2 s ( 0 : kk + dz ) = 0.0_dp do c = 1 , ncum ( kk ) if ( uin ( c ) == 0.0_dp ) cycle tt = it ( c ); uv = iu ( c ); vv = iv ( c ) + dz do i1 = 0 , tt / 2 c1 = uin ( c ) * bx ( tt , i1 ) if ( c1 == 0.0_dp ) cycle do j1 = 0 , uv / 2 c2 = c1 * by ( uv , j1 ) if ( c2 == 0.0_dp ) cycle do k1 = 0 , vv / 2 ord = tt + uv + vv - i1 - j1 - k1 s ( ord ) = s ( ord ) + c2 * bz ( vv , k1 ) end do end do end do end do end subroutine radial_sum end subroutine elastic_pairs","tags":"","url":"proc/elastic_pairs.html"},{"title":"j0_derivatives – PyXSCAT kernels","text":"public pure subroutine j0_derivatives(q, hx, hy, hz, lmax, ldim, idx, ntuv, r) Hermite derivatives R(k) = d&#94;{t+u+v}/dh_x&#94;t dh_y&#94;u dh_z&#94;v j0(q|h|) for t+u+v <= lmax,\npacked by idx(t,u,v). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: q real(kind=dp), intent(in) :: hx real(kind=dp), intent(in) :: hy real(kind=dp), intent(in) :: hz integer(kind=ikind), intent(in) :: lmax integer(kind=ikind), intent(in) :: ldim integer(kind=ikind), intent(in) :: idx (0:ldim,0:ldim,0:ldim) integer(kind=ikind), intent(in) :: ntuv real(kind=dp), intent(out) :: r (ntuv) Variables Type Visibility Attributes Name Initial real(kind=dp), public :: g (0:lmax) real(kind=dp), public :: old (ntuv) real(kind=dp), public :: fn real(kind=dp), public :: q2n integer(kind=ikind), public :: n integer(kind=ikind), public :: t integer(kind=ikind), public :: u integer(kind=ikind), public :: v integer(kind=ikind), public :: k Source Code pure subroutine j0_derivatives ( q , hx , hy , hz , lmax , ldim , idx , ntuv , r ) real ( kind = dp ), intent ( in ) :: q , hx , hy , hz integer ( kind = ikind ), intent ( in ) :: lmax , ldim , ntuv integer ( kind = ikind ), intent ( in ) :: idx ( 0 : ldim , 0 : ldim , 0 : ldim ) real ( kind = dp ), intent ( out ) :: r ( ntuv ) real ( kind = dp ) :: g ( 0 : lmax ), old ( ntuv ), fn , q2n integer ( kind = ikind ) :: n , t , u , v , k call jn_over_xn ( q * sqrt ( hx * hx + hy * hy + hz * hz ), lmax , g ) old = 0.0_dp r = 0.0_dp do n = lmax , 0 , - 1 q2n = ( - q * q ) ** n fn = q2n * g ( n ) r ( idx ( 0 , 0 , 0 )) = fn do k = 1 , lmax - n do t = 0 , k do u = 0 , k - t v = k - t - u if ( t > 0 ) then r ( idx ( t , u , v )) = hx * old ( idx ( t - 1 , u , v )) if ( t > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( t - 1 ) * old ( idx ( t - 2 , u , v )) else if ( u > 0 ) then r ( idx ( t , u , v )) = hy * old ( idx ( t , u - 1 , v )) if ( u > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( u - 1 ) * old ( idx ( t , u - 2 , v )) else r ( idx ( t , u , v )) = hz * old ( idx ( t , u , v - 1 )) if ( v > 1 ) r ( idx ( t , u , v )) = r ( idx ( t , u , v )) + ( v - 1 ) * old ( idx ( t , u , v - 2 )) end if end do end do end do if ( n > 0 ) old = r end do end subroutine j0_derivatives","tags":"","url":"proc/j0_derivatives.html"},{"title":"electron_nucleus – PyXSCAT kernels","text":"public  subroutine electron_nucleus(nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, natom, zat, rat, dm, lorder, screen, res, ierr) I_ne(q) = sum_A zat(A) sum_mu,nu dm(mu,nu) int chi_mu chi_nu K_lorder(q, r - R_A) dr Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: nao integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: q (nq) integer(kind=ikind), intent(in) :: natom real(kind=dp), intent(in) :: zat (natom) real(kind=dp), intent(in) :: rat (3,natom) real(kind=dp), intent(in) :: dm (nao,nao) integer(kind=ikind), intent(in) :: lorder real(kind=dp), intent(in) :: screen real(kind=dp), intent(out) :: res (nq) integer(kind=ikind), intent(out) :: ierr Variables Type Visibility Attributes Name Initial integer(kind=ikind), public :: ng integer(kind=ikind), public :: g integer(kind=ikind), public :: i integer(kind=ikind), public :: a integer(kind=ikind), public :: b integer(kind=ikind), public :: gi integer(kind=ikind), public :: gj integer(kind=ikind), public :: lmax integer(kind=ikind), public :: lder integer(kind=ikind), public :: iq integer(kind=ikind), public :: t integer(kind=ikind), public :: u integer(kind=ikind), public :: v integer(kind=ikind), public :: ca integer(kind=ikind), public :: cb integer(kind=ikind), public :: iat integer(kind=ikind), public :: ntuv integer(kind=ikind), public :: k integer(kind=ikind), public, allocatable :: gstart (:) integer(kind=ikind), public, allocatable :: gcount (:) integer(kind=ikind), public, allocatable :: lg (:) integer(kind=ikind), public, allocatable :: idx (:,:,:) real(kind=dp), public, allocatable :: cmax (:) real(kind=dp), public, allocatable :: ex (:,:,:) real(kind=dp), public, allocatable :: ey (:,:,:) real(kind=dp), public, allocatable :: ez (:,:,:) real(kind=dp), public, allocatable :: rr (:,:) real(kind=dp), public, allocatable :: w (:) real(kind=dp), public :: pi real(kind=dp), public :: p real(kind=dp), public :: px real(kind=dp), public :: py real(kind=dp), public :: pz real(kind=dp), public :: kab real(kind=dp), public :: pref real(kind=dp), public :: cc real(kind=dp), public :: dmax real(kind=dp), public :: dfac real(kind=dp), public :: s real(kind=dp), public :: gq Source Code subroutine electron_nucleus ( nprim , nao , nq , x , y , z , ga , l , m , n , group , contr , coeff , q , & natom , zat , rat , dm , lorder , screen , res , ierr ) integer ( kind = ikind ), intent ( in ) :: nprim , nao , nq , natom , lorder real ( kind = dp ), intent ( in ) :: x ( nprim ), y ( nprim ), z ( nprim ), ga ( nprim ), coeff ( nprim ), q ( nq ) integer ( kind = ikind ), intent ( in ) :: l ( nprim ), m ( nprim ), n ( nprim ), group ( nprim ), contr ( nprim ) real ( kind = dp ), intent ( in ) :: zat ( natom ), rat ( 3 , natom ), dm ( nao , nao ), screen real ( kind = dp ), intent ( out ) :: res ( nq ) integer ( kind = ikind ), intent ( out ) :: ierr integer ( kind = ikind ) :: ng , g , i , a , b , gi , gj , lmax , lder , iq , t , u , v , ca , cb , iat , ntuv , k integer ( kind = ikind ), allocatable :: gstart (:), gcount (:), lg (:), idx (:, :, :) real ( kind = dp ), allocatable :: cmax (:), ex (:, :, :), ey (:, :, :), ez (:, :, :), rr (:, :), w (:) real ( kind = dp ) :: pi , p , px , py , pz , kab , pref , cc , dmax , dfac , s , gq ierr = 0 res = 0.0_dp if ( lorder /= 0 . and . lorder /= 2 ) then ierr = 8 ; return end if pi = acos ( - 1.0_dp ) ng = maxval ( group ) if ( group ( 1 ) /= 1 ) then ierr = 5 ; return end if do i = 2 , nprim if ( group ( i ) /= group ( i - 1 ) . and . group ( i ) /= group ( i - 1 ) + 1 ) then ierr = 5 ; return end if end do allocate ( gstart ( ng ), gcount ( ng ), lg ( ng ), cmax ( ng )) gcount = 0 do i = 1 , nprim g = group ( i ) if ( gcount ( g ) == 0 ) then gstart ( g ) = i lg ( g ) = l ( i ) + m ( i ) + n ( i ) end if gcount ( g ) = gcount ( g ) + 1 end do do g = 1 , ng cmax ( g ) = maxval ( abs ( coeff ( gstart ( g ): gstart ( g ) + gcount ( g ) - 1 ))) end do lmax = maxval ( lg ) lder = 2 * lmax + lorder allocate ( idx ( 0 : lder , 0 : lder , 0 : lder )) idx = 0 ntuv = 0 do k = 0 , lder do t = 0 , k do u = 0 , k - t ntuv = ntuv + 1 idx ( t , u , k - t - u ) = ntuv end do end do end do dmax = maxval ( abs ( dm )) !$OMP PARALLEL default(shared) private(gi, gj, a, b, p, px, py, pz, kab, pref, ex, ey, ez, & !$OMP& rr, w, t, u, v, ca, cb, cc, iq, iat, dfac, s, gq) reduction(+:res) allocate ( ex ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ey ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax ), ez ( 0 : 2 * lmax + 1 , 0 : lmax , 0 : lmax )) allocate ( rr ( ntuv , nq ), w ( ntuv )) !$OMP DO schedule(dynamic) do gi = 1 , ng do gj = gi , ng a = gstart ( gi ); b = gstart ( gj ) p = ga ( a ) + ga ( b ) kab = exp ( - ga ( a ) * ga ( b ) / p * (( x ( a ) - x ( b )) ** 2 + ( y ( a ) - y ( b )) ** 2 + ( z ( a ) - z ( b )) ** 2 )) pref = ( pi / p ) ** 1.5_dp * kab if ( pref * cmax ( gi ) * cmax ( gj ) * dmax * ( 1.0_dp + real ( lg ( gi ) + lg ( gj ), dp )) < screen ) cycle px = ( ga ( a ) * x ( a ) + ga ( b ) * x ( b )) / p py = ( ga ( a ) * y ( a ) + ga ( b ) * y ( b )) / p pz = ( ga ( a ) * z ( a ) + ga ( b ) * z ( b )) / p call hermite_pair ( lg ( gi ), lg ( gj ), px - x ( a ), px - x ( b ), p , ex ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), py - y ( a ), py - y ( b ), p , ey ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) call hermite_pair ( lg ( gi ), lg ( gj ), pz - z ( a ), pz - z ( b ), p , ez ( 0 : lg ( gi ) + lg ( gj ) + 1 , 0 : lg ( gi ), 0 : lg ( gj ))) ! density-weighted Hermite coefficients of this shell pair: w(tuv) w = 0.0_dp do a = gstart ( gi ), gstart ( gi ) + gcount ( gi ) - 1 do b = gstart ( gj ), gstart ( gj ) + gcount ( gj ) - 1 ca = contr ( a ); cb = contr ( b ) dfac = dm ( ca , cb ) if ( gi /= gj ) dfac = dfac + dm ( cb , ca ) cc = coeff ( a ) * coeff ( b ) * dfac if ( cc == 0.0_dp ) cycle do t = 0 , l ( a ) + l ( b ) do u = 0 , m ( a ) + m ( b ) do v = 0 , n ( a ) + n ( b ) w ( idx ( t , u , v )) = w ( idx ( t , u , v )) + & cc * ex ( t , l ( a ), l ( b )) * ey ( u , m ( a ), m ( b )) * ez ( v , n ( a ), n ( b )) end do end do end do end do end do if ( maxval ( abs ( w )) * pref < screen ) cycle do iat = 1 , natom do iq = 1 , nq call j0_derivatives ( q ( iq ), px - rat ( 1 , iat ), py - rat ( 2 , iat ), pz - rat ( 3 , iat ), & lg ( gi ) + lg ( gj ) + lorder , lder , idx , ntuv , rr (:, iq )) end do do iq = 1 , nq gq = zat ( iat ) * pref * exp ( - q ( iq ) ** 2 / ( 4.0_dp * p )) s = 0.0_dp do t = 0 , lg ( gi ) + lg ( gj ) do u = 0 , lg ( gi ) + lg ( gj ) - t do v = 0 , lg ( gi ) + lg ( gj ) - t - u if ( w ( idx ( t , u , v )) == 0.0_dp ) cycle if ( lorder == 0 ) then s = s + w ( idx ( t , u , v )) * rr ( idx ( t , u , v ), iq ) else if ( q ( iq ) > 0.0_dp ) then s = s + w ( idx ( t , u , v )) * ( 3.0_dp * rr ( idx ( t , u , v + 2 ), iq ) & + q ( iq ) ** 2 * rr ( idx ( t , u , v ), iq )) / ( 2.0_dp * q ( iq ) ** 2 ) end if end do end do end do res ( iq ) = res ( iq ) + gq * s end do end do end do end do !$OMP END DO deallocate ( ex , ey , ez , rr , w ) !$OMP END PARALLEL end subroutine electron_nucleus","tags":"","url":"proc/electron_nucleus.html"},{"title":"p0_cases – PyXSCAT kernels","text":"Closed forms of the rotational averages <qx&#94;L qy&#94;M qz&#94;N> (the h = 0 limits of the quartet\nkernel) for the Legendre terms j0, j1 and j2, and the constructors of the P0 tables. Subroutines public  subroutine set_P0 (P0, lmax4, q) Fills P0(:, L+1, M+1, N+1) = <qx&#94;L qy&#94;M qz&#94;N> (j0 case) for all L, M, N <= lmax4 with L+M+N <= 16. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:), allocatable :: q public  subroutine set_P0_j2 (P0, lmax4, q) The same table for the j2 P2 term, scaled by sqrt(5/pi). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:) :: q public  subroutine set_P0_j1 (P0, lmax4, q) The same table for the j1 term, scaled by sqrt(3/pi). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: lmax4 real(kind=dp), intent(in), DIMENSION(:), allocatable :: q public  subroutine P_LMN (P0, L, M, N, q) One entry (L, M, N) of the j0 table at every q: the closed-form cases. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(inout), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: L integer(kind=ikind), intent(in) :: M integer(kind=ikind), intent(in) :: N real(kind=dp), intent(in), DIMENSION(:), allocatable :: q public  subroutine P_LMN_j1 (P0, L, M, N, q) One entry (L, M, N) of the j1 table at every q. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(inout), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: L integer(kind=ikind), intent(in) :: M integer(kind=ikind), intent(in) :: N real(kind=dp), intent(in), DIMENSION(:), allocatable :: q public  subroutine P_LMN_j2 (P0, L, M, N, q) One entry (L, M, N) of the j2 table at every q. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(inout), DIMENSION(:,:,:,:) :: P0 integer(kind=ikind), intent(in) :: L integer(kind=ikind), intent(in) :: M integer(kind=ikind), intent(in) :: N real(kind=dp), intent(in), DIMENSION(:) :: q public  subroutine Bubble_Sort (a) Sorts the integer array a in ascending order (bubble sort, early exit when already sorted). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(inout), DIMENSION(:) :: a","tags":"","url":"module/p0_cases.html"},{"title":"xs_pairft – PyXSCAT kernels","text":"PyXSCAT - Fourier transforms of basis-function products at fixed q F(q, mu, nu) = int chi_mu(r) chi_nu(r) exp(+i q.r) dr for an arbitrary list of scattering vectors (no orientational average).\nEverything that depends on the molecular orientation (aligned or\noriented molecules, detector images) follows from these by contraction\nwith density matrices, because the plane wave factorises: elastic      F(q)  = sum D_mu,nu F_mu,nu(q)\n two-electron I2(q) = sum Gamma_{mu nu, la si} F_mu,nu(q) F_la,si(q)&#94;* Each primitive pair is expanded in Hermite Gaussians at the pair centre P;\nthe transform of a Hermite Gaussian is analytic: int Lambda_tuv(r-P) exp(iq.r) = (pi/p)&#94;{3/2} exp(-q&#94;2/4p) exp(iq.P)\n                                 (i qx)&#94;t (i qy)&#94;u (i qz)&#94;v so there is no Bessel expansion and no special treatment of coincident\ncentres. Uses iso_fortran_env Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) Subroutines public pure subroutine hermite_pair (la, lb, pa, pb, p, e) Hermite coefficients E(t; i, j) for one primitive pair and one direction (Gaussian\nprefactor excluded, E(0;0,0) = 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: la integer(kind=ikind), intent(in) :: lb real(kind=dp), intent(in) :: pa real(kind=dp), intent(in) :: pb real(kind=dp), intent(in) :: p real(kind=dp), intent(out) :: e (0:la+lb+1,0:la,0:lb) public  subroutine pair_transform (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, qv, screen, f, ierr) F(q, mu, nu) for every scattering vector qv(:, iq) and every pair of contracted functions,\ninto the complex array f(nq, nao, nao).  Primitive-shell pairs whose Gaussian prefactor\n(times the largest coefficients) is below screen are skipped; ierr = 0 on success. Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: nao integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: qv (3,nq) real(kind=dp), intent(in) :: screen complex(kind=dp), intent(out) :: f (nq,nao,nao) integer(kind=ikind), intent(out) :: ierr","tags":"","url":"module/xs_pairft.html"},{"title":"xs_radial – PyXSCAT kernels","text":"PyXSCAT - radial functions shared by the one- and two-centre j0 kernels g_n(x) = j_n(x) / x&#94;n                       (stable for every x >= 0)\n a(T, i) = T! / (i! (T-2i)! 2&#94;i)               (Cartesian derivatives of a function of h&#94;2/2) For any radial function f(|h|) with f_n = (1/h d/dh)&#94;n f, d&#94;T/dhx&#94;T d&#94;U/dhy&#94;U d&#94;V/dhz&#94;V f = sum_ijk a(T,i) a(U,j) a(V,k) hx&#94;(T-2i) hy&#94;(U-2j) hz&#94;(V-2k)\n                                   f_(T+U+V-i-j-k), and for f = j0(q h):  f_n = (-q&#94;2)&#94;n g_n(q h). Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) integer, private, parameter :: NJJ = 128 Functions public pure function upward_threshold (kk) The upward recurrence g(m+1) = [(2m+1) g(m) - g(m-1)] / x&#94;2 is stable only while the\norder stays below x (above it the irregular solution y_m takes over, and rounding errors\ngrow like (2m-1)!! (2m+1)!! / x&#94;(2m+1)).  It is therefore used only when x > kk + 1, for\nall orders at once; below that, jn_over_xn propagates downward (series + downward\nrecurrence for x < 1, Miller's normalised backward recurrence for 1 <= x <= kk + 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: kk Return Value real(kind=dp) Subroutines public pure subroutine jn_over_xn (x, nmax, g) g(n) = j_n(x) / x&#94;n, n = 0..nmax, accurate for every x >= 0. Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: x integer(kind=ikind), intent(in) :: nmax real(kind=dp), intent(out) :: g (0:nmax) public pure subroutine hermite_radial_coeffs (lmax, a) a(T, i) for T <= lmax, i <= T/2 Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: lmax real(kind=dp), intent(out) :: a (0:lmax,0:lmax/2) public  subroutine radial_series (nq, q, h, order, coef, out) The radial sum of the quartet kernel, Read more… Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: q (nq) real(kind=dp), intent(in) :: h integer(kind=ikind), intent(in) :: order real(kind=dp), intent(in) :: coef (order+1) real(kind=dp), intent(out) :: out (nq)","tags":"","url":"module/xs_radial.html"},{"title":"xs_capi – PyXSCAT kernels","text":"PyXSCAT - C-compatible entry points (called from Python through ctypes) One bind(C) wrapper per kernel; the ctypes signatures on the Python side are declared in\npython/pyxscat/_lib.py.  Scalars are passed by value, arrays by reference in Fortran order,\noptional arrays as NULL pointers; nthreads > 0 sets the OpenMP thread count for the call. Uses xs_pairft xs_rdm xs_nuclear xs_elastic omp_lib iso_c_binding iso_fortran_env xs_kernel_j0 xs_radial Functions public  function pyxscat_max_threads () bind(C, name='pyxscat_max_threads') Number of OpenMP threads the library uses when nthreads <= 0 is passed (omp_get_max_threads). Arguments None Return Value integer(kind=c_int) Subroutines public  subroutine pyxscat_two_electron_j0 (nprim, ncontr, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, mode, dm2, da, db, wc, wx, nkc, fac, fbc, nkx, fax, fbx, dgemm_ptr, cutoffcentre, cutoffz, cutoffmd, screen_tol, lorder, nthreads, res, stats, ierr) bind(C, name='pyxscat_two_electron_j0') Rotationally averaged two-electron scattering. Read more… Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nprim integer(kind=c_int), intent(in), value :: ncontr integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: x (nprim) real(kind=c_double), intent(in) :: y (nprim) real(kind=c_double), intent(in) :: z (nprim) real(kind=c_double), intent(in) :: ga (nprim) integer(kind=c_int), intent(in) :: l (nprim) integer(kind=c_int), intent(in) :: m (nprim) integer(kind=c_int), intent(in) :: n (nprim) integer(kind=c_int), intent(in) :: group (nprim) integer(kind=c_int), intent(in) :: contr (nprim) real(kind=c_double), intent(in) :: coeff (nprim) real(kind=c_double), intent(in) :: q (nq) integer(kind=c_int), intent(in), value :: mode type(c_ptr), intent(in), value :: dm2 real(kind=c_double), intent(in) :: da (ncontr,ncontr) real(kind=c_double), intent(in) :: db (ncontr,ncontr) real(kind=c_double), intent(in), value :: wc real(kind=c_double), intent(in), value :: wx integer(kind=c_int), intent(in), value :: nkc type(c_ptr), intent(in), value :: fac type(c_ptr), intent(in), value :: fbc integer(kind=c_int), intent(in), value :: nkx type(c_ptr), intent(in), value :: fax type(c_ptr), intent(in), value :: fbx type(c_funptr), intent(in), value :: dgemm_ptr real(kind=c_double), intent(in), value :: cutoffcentre real(kind=c_double), intent(in), value :: cutoffz real(kind=c_double), intent(in), value :: cutoffmd real(kind=c_double), intent(in), value :: screen_tol integer(kind=c_int), intent(in), value :: lorder integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: res (nq) real(kind=c_double), intent(out) :: stats (4) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_hermite_table (ng, maxl, lg, xg, ag, dd) bind(C, name='pyxscat_hermite_table') Hermite coefficients for one Cartesian direction (exposed for unit tests). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: ng integer(kind=c_int), intent(in), value :: maxl integer(kind=c_int), intent(in) :: lg (ng) real(kind=c_double), intent(in) :: xg (ng) real(kind=c_double), intent(in) :: ag (ng) real(kind=c_double), intent(out) :: dd (2*maxl+1,maxl+1,maxl+1,ng,ng) public  subroutine pyxscat_pair_transform (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, qv, screen, nthreads, f, ierr) bind(C, name='pyxscat_pair_transform') Fourier transforms of basis-function products, F(q, mu, nu), at fixed scattering vectors. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nprim integer(kind=c_int), intent(in), value :: nao integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: x (nprim) real(kind=c_double), intent(in) :: y (nprim) real(kind=c_double), intent(in) :: z (nprim) real(kind=c_double), intent(in) :: ga (nprim) integer(kind=c_int), intent(in) :: l (nprim) integer(kind=c_int), intent(in) :: m (nprim) integer(kind=c_int), intent(in) :: n (nprim) integer(kind=c_int), intent(in) :: group (nprim) integer(kind=c_int), intent(in) :: contr (nprim) real(kind=c_double), intent(in) :: coeff (nprim) real(kind=c_double), intent(in) :: qv (3,nq) real(kind=c_double), intent(in), value :: screen integer(kind=c_int), intent(in), value :: nthreads complex(kind=c_double_complex), intent(out) :: f (nq,nao,nao) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_electron_nucleus (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, natom, zat, rat, dm, lorder, screen, nthreads, res, ierr) bind(C, name='pyxscat_electron_nucleus') Electron-nucleus term of electron scattering (rotational average, l = 0 or 2). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nprim integer(kind=c_int), intent(in), value :: nao integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: x (nprim) real(kind=c_double), intent(in) :: y (nprim) real(kind=c_double), intent(in) :: z (nprim) real(kind=c_double), intent(in) :: ga (nprim) integer(kind=c_int), intent(in) :: l (nprim) integer(kind=c_int), intent(in) :: m (nprim) integer(kind=c_int), intent(in) :: n (nprim) integer(kind=c_int), intent(in) :: group (nprim) integer(kind=c_int), intent(in) :: contr (nprim) real(kind=c_double), intent(in) :: coeff (nprim) real(kind=c_double), intent(in) :: q (nq) integer(kind=c_int), intent(in), value :: natom real(kind=c_double), intent(in) :: zat (natom) real(kind=c_double), intent(in) :: rat (3,natom) real(kind=c_double), intent(in) :: dm (nao,nao) integer(kind=c_int), intent(in), value :: lorder real(kind=c_double), intent(in), value :: screen integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: res (nq) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_elastic_pairs (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, da, db, lorder, screen, nthreads, res, stats, ierr) bind(C, name='pyxscat_elastic_pairs') Elastic (and coherent mixed) scattering by density-weighted pairs (l = 0 or 2). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nprim integer(kind=c_int), intent(in), value :: nao integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: x (nprim) real(kind=c_double), intent(in) :: y (nprim) real(kind=c_double), intent(in) :: z (nprim) real(kind=c_double), intent(in) :: ga (nprim) integer(kind=c_int), intent(in) :: l (nprim) integer(kind=c_int), intent(in) :: m (nprim) integer(kind=c_int), intent(in) :: n (nprim) integer(kind=c_int), intent(in) :: group (nprim) integer(kind=c_int), intent(in) :: contr (nprim) real(kind=c_double), intent(in) :: coeff (nprim) real(kind=c_double), intent(in) :: q (nq) real(kind=c_double), intent(in) :: da (nao,nao) real(kind=c_double), intent(in) :: db (nao,nao) integer(kind=c_int), intent(in), value :: lorder real(kind=c_double), intent(in), value :: screen integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: res (nq) real(kind=c_double), intent(out) :: stats (2) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_radial_series (nq, q, h, order, coef, res) bind(C, name='pyxscat_radial_series') sum_b coef(b+1) j_b(q h) (q/h)&#94;b for a list of q (exposed for unit tests). Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: nq real(kind=c_double), intent(in) :: q (nq) real(kind=c_double), intent(in), value :: h integer(kind=c_int), intent(in), value :: order real(kind=c_double), intent(in) :: coef (order+1) real(kind=c_double), intent(out) :: res (nq) public  subroutine pyxscat_rdm12_bitwise (ndet, norb, nw, wa, wb, c, nthreads, d1, d2, ierr) bind(C, name='pyxscat_rdm12_bitwise') Spin-summed 1- and 2-RDMs of a determinant expansion by the bitwise determinant-pair\nalgorithm (one 64-bit word per spin).  d1, d2 are C-ordered [p,q] and [p,q,r,s]. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: ndet integer(kind=c_int), intent(in), value :: norb integer(kind=c_int), intent(in), value :: nw integer(kind=c_int64_t), intent(in) :: wa (nw,ndet) integer(kind=c_int64_t), intent(in) :: wb (nw,ndet) real(kind=c_double), intent(in) :: c (ndet) integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: d1 (norb,norb) real(kind=c_double), intent(out) :: d2 (norb,norb,norb,norb) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_rdm12_bitwise_groups (ndet, norb, nw, wa, wb, c, nint, ng, gstart, grp, nnb, nbstart, nb, nthreads, d1, d2, ierr) bind(C, name='pyxscat_rdm12_bitwise_groups') rdm12_bitwise restricted to candidate pairs: determinants sorted into ng groups with the\nneighbour lists nb (see xs_rdm); dm2 elements with all four orbitals >= nint are skipped. Arguments Type Intent Optional Attributes Name integer(kind=c_int), intent(in), value :: ndet integer(kind=c_int), intent(in), value :: norb integer(kind=c_int), intent(in), value :: nw integer(kind=c_int64_t), intent(in) :: wa (nw,ndet) integer(kind=c_int64_t), intent(in) :: wb (nw,ndet) real(kind=c_double), intent(in) :: c (ndet) integer(kind=c_int), intent(in), value :: nint integer(kind=c_int), intent(in), value :: ng integer(kind=c_int), intent(in) :: gstart (ng+1) integer(kind=c_int), intent(in) :: grp (ndet) integer(kind=c_int), intent(in), value :: nnb integer(kind=c_int), intent(in) :: nbstart (ng+1) integer(kind=c_int), intent(in) :: nb (nnb) integer(kind=c_int), intent(in), value :: nthreads real(kind=c_double), intent(out) :: d1 (norb,norb) real(kind=c_double), intent(out) :: d2 (norb,norb,norb,norb) integer(kind=c_int), intent(out) :: ierr public  subroutine pyxscat_build_info (buf, n) bind(C, name='pyxscat_build_info') Compiler and options the library was built with (for bug reports): copied into buf. Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(out) :: buf (n) integer(kind=c_int), intent(in), value :: n","tags":"","url":"module/xs_capi.html"},{"title":"Bessels_j0 – PyXSCAT kernels","text":"Bessels_j0_opt.f90 Optimised version of the Bessel module for X-ray scattering. Changes vs original: MATH: 1. dphrec_opt: backward recurrence starts from order + 15 instead of hardcoded 100. For order = 4 this is 5 x less work . For order = 8 still 4 x less . Numerically identical ( Miller ' s algorithm is stable regardless of starting point , provided sufficient buffer ). 2. bessels0rr: final summation restructured as DGEMV when order >= 4 , with invpmu &#94; beta scaling pre - absorbed . Eliminates the explicit beta loop with element - wise operations . 3. Pmu = 0 guard: if any q - point gives | Pmu |< 1e-15 , use the Taylor expansion j_0 ( x ) = 1 , j_l ( x ) ~ x &#94; l / ( 2 l + 1 ) !! instead of dividing by zero . CODING: 4. rrdj0 : early exit when lmax = 0 ( s - shell quartets , very common ) . Avoids filling the full 20 x20 matrix . 5. BesselDeriv : screening on products C1 , C2 moved to reduce multiplications ( already present in original , kept here ) . 6. allbessels array right - sized to ( order + 16 , nq ) instead of ( 100 , nq ), reducing stack usage from 160 KB to ~ 25 KB typical . 7. bessels0rr_dim : new variant that takes h_saved as dim - length vector ( matching the caller 's usage) to avoid assumed-shape overhead . Link with: -lblas (for DGEMV) Variables Type Visibility Attributes Name Initial integer, public, parameter :: BDIM_MAX = 32 largest derivative order + 1 of the j0 expansions: 4 l_max + 2 (j2) + 1 = 23 for h functions Subroutines public  subroutine bessels0rr (h_sum, order, mu, H, h_saved) Radial sum of the quartet kernel for one pair distance H and every q in mu: Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), dimension(size(mu)) :: h_sum integer(kind=ikind), intent(in) :: order real(kind=dp), intent(in), dimension(:), allocatable :: mu real(kind=dp), intent(in) :: H real(kind=dp), intent(in), dimension(:) :: h_saved public  subroutine dphrec_opt (x, rbes, leps1, lmax1, nq) Right-sized backward recurrence for spherical Bessel functions Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in), dimension(nq) :: x real(kind=dp), intent(out), dimension(leps1, nq) :: rbes integer, intent(in) :: leps1 integer, intent(in) :: lmax1 integer, intent(in) :: nq public  subroutine rrdj0 (lmax, x, a) Expansion coefficients for one Cartesian coordinate. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: lmax real(kind=dp), intent(in) :: x real(kind=dp), intent(out), dimension(BDIM_MAX, BDIM_MAX) :: a public  subroutine BesselDeriv (BD, LL, MM, NN, a, b, c, LLmax) Combines the three coordinate expansions. Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(LLmax + 1) :: BD integer(kind=ikind), intent(in) :: LL integer(kind=ikind), intent(in) :: MM integer(kind=ikind), intent(in) :: NN real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: a real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: b real(kind=dp), intent(in), DIMENSION(BDIM_MAX, BDIM_MAX) :: c integer(kind=ikind), intent(in) :: LLmax public  subroutine BesselSum (h_sum, mu, H, LLmax, h_saved) Forward recurrence variant of bessels0rr (kept for compatibility). Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out), DIMENSION(size(mu)) :: h_sum real(kind=dp), intent(in), DIMENSION(:), allocatable :: mu real(kind=dp), intent(in) :: H integer(kind=ikind), intent(in) :: LLmax real(kind=dp), intent(in), DIMENSION(LLmax + 1) :: h_saved","tags":"","url":"module/bessels_j0.html"},{"title":"xs_kernel_j0 – PyXSCAT kernels","text":"PyXSCAT - rotationally averaged (j0) two-electron scattering kernel I2(q) = sum_{ijkr} Z(ij,kr) < chi_i chi_j | j0(q r12) | chi_k chi_r > chi are contracted Cartesian Gaussians and Z is a pair density in that\nbasis.  The routine knows nothing about how Z was obtained: it is\nsupplied by a \"density provider\" mode 1 : explicit four - index array Z ( 8 - fold symmetric ) mode 2 : built on the fly from two symmetric one - particle matrices mode 3 : a sum of products of one - particle matrices ( factored densities , e . g . CCSD ) : Z ( a , b , c , d ) = sum_k Ac_k ( a , b ) Bc_k ( c , d ) [ Coulomb pairing , Ac / Bc symmetric ] + sum_k Ax_k ( a , c ) Bx_k ( b , d ) [ exchange pairing , any matrices ], symmetrised over the 8 index permutations inside the kernel Z ( ij , kr ) = wc / 2 [ A_ij B_kr + B_ij A_kr ] + wx [ A_ik A_jr + A_ir A_jk ] wc = 1 , wx = 0 -> elastic ( A = B = D ) or coherent mixed wc = 0 , wx = - 1 / 4 -> closed - shell exchange wc = 1 , wx = - 1 / 4 -> closed - shell mean field ( Hartree - Fock ) Algorithm: canonical loop over contracted-shell quartets with primitive\nquartets inside, shell-pair screening, thread-local buffers.  It is the\n\"one loop\" kernel of Moreno Carrascosa and co-workers, taking its input\nin memory instead of from files. Basis description (all arrays over primitive Cartesian functions): x, y, z, ga   centre and exponent\n l, m, n       Cartesian powers\n group         primitive shell (same centre, exponent and l+m+n);\n               numbered 1..ng, members contiguous\n contr         index of the contracted function the primitive belongs to\n coeff         contraction coefficient times normalisation Uses xs_hermite iso_c_binding iso_fortran_env xs_radial p0_cases Bessels_j0 Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) integer(kind=ikind), private, parameter :: bdim = BDIM_MAX Abstract Interfaces abstract interface public  subroutine dgemm_iface(transa, transb, m, n, k, alpha, a, lda, b, ldb, beta, c, ldc) bind(C) BLAS dgemm in its Fortran calling convention (everything by reference) Arguments Type Intent Optional Attributes Name character(kind=c_char, len=1), intent(in) :: transa character(kind=c_char, len=1), intent(in) :: transb integer(kind=c_int), intent(in) :: m integer(kind=c_int), intent(in) :: n integer(kind=c_int), intent(in) :: k real(kind=c_double), intent(in) :: alpha real(kind=c_double), intent(in) :: a (*) integer(kind=c_int), intent(in) :: lda real(kind=c_double), intent(in) :: b (*) integer(kind=c_int), intent(in) :: ldb real(kind=c_double), intent(in) :: beta real(kind=c_double), intent(inout) :: c (*) integer(kind=c_int), intent(in) :: ldc Functions public pure function dfact (n) Double factorial n!! as a real (1 for n <= 1). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: n Return Value real(kind=dp) Subroutines public  subroutine two_electron_j0 (nprim, ncontr, nq, x, y, z, ga, l, m, n, group, contr, coeff, qin, mode, zbig, da, db, wc, wx, nkc, ac, bc, nkx, ax, bx, dgemm_ptr, cutoffcentre, cutoffz, cutoffmd, screen_tol, lorder, tsi, stats, ierr) The two-electron term I2(q) at every q of qin (lorder = 0), or its j2 P2 moment (lorder = 2),\nfor the density provider selected by mode (see the module description).  tsi receives the\nresult, stats the screening counts (shell quartets total/kept, primitive quartets total/kept);\nierr = 0 on success, 1-8 for an inconsistent input (sizes, modes, l beyond the Bessel tables,\nnon-contiguous groups). Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: ncontr integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: qin (nq) integer(kind=ikind), intent(in) :: mode real(kind=dp), intent(in), pointer :: zbig (:,:,:,:) real(kind=dp), intent(in) :: da (ncontr,ncontr) real(kind=dp), intent(in) :: db (ncontr,ncontr) real(kind=dp), intent(in) :: wc real(kind=dp), intent(in) :: wx integer(kind=ikind), intent(in) :: nkc real(kind=dp), intent(in) :: ac (nkc,ncontr,ncontr) real(kind=dp), intent(in) :: bc (nkc,ncontr,ncontr) integer(kind=ikind), intent(in) :: nkx real(kind=dp), intent(in) :: ax (nkx,ncontr,ncontr) real(kind=dp), intent(in) :: bx (nkx,ncontr,ncontr) type(c_funptr), intent(in) :: dgemm_ptr real(kind=dp), intent(in) :: cutoffcentre real(kind=dp), intent(in) :: cutoffz real(kind=dp), intent(in) :: cutoffmd real(kind=dp), intent(in) :: screen_tol integer(kind=ikind), intent(in) :: lorder real(kind=dp), intent(out) :: tsi (nq) real(kind=dp), intent(out) :: stats (4) integer(kind=ikind), intent(out) :: ierr public  subroutine exchange_pass (nq, q, nkx, ncontr, ax, bx, dgemm, nshell, shell_start, shell_end, gstart, gcount, contr, coeff, max_gc, n4, lorder, l, m, n, p0matrix, ddx, ddy, ddz, px, py, pz, e12, e12s, e12max, cmaxg, ng, dmaxx, cutoffcentre, cutoffz, cutoffmd, screen_tol, tsi, nshq_tot, nshq_done, nquart_tot, nquart_done) Exchange-paired factored terms, Z(a,b,c,d) = sum_k Ax_k(I_a, K_c) Bx_k(J_b, L_d), symmetrised\nover the 8 index permutations the canonical quartet loop assumes: Read more… Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in), allocatable :: q (:) integer(kind=ikind), intent(in) :: nkx integer(kind=ikind), intent(in) :: ncontr real(kind=dp), intent(in) :: ax (nkx,ncontr,ncontr) real(kind=dp), intent(in) :: bx (nkx,ncontr,ncontr) procedure( dgemm_iface ), intent(in), pointer :: dgemm integer(kind=ikind), intent(in) :: nshell integer(kind=ikind), intent(in) :: shell_start (:) integer(kind=ikind), intent(in) :: shell_end (:) integer(kind=ikind), intent(in) :: gstart (:) integer(kind=ikind), intent(in) :: gcount (:) integer(kind=ikind), intent(in) :: contr (:) real(kind=dp), intent(in) :: coeff (:) integer(kind=ikind), intent(in) :: max_gc integer(kind=ikind), intent(in) :: n4 integer(kind=ikind), intent(in) :: lorder integer(kind=ikind), intent(in) :: l (:) integer(kind=ikind), intent(in) :: m (:) integer(kind=ikind), intent(in) :: n (:) real(kind=dp), intent(in) :: p0matrix (:,:,:,:) real(kind=dp), intent(in), target :: ddx (:,:,:,:,:) real(kind=dp), intent(in), target :: ddy (:,:,:,:,:) real(kind=dp), intent(in), target :: ddz (:,:,:,:,:) real(kind=dp), intent(in) :: px (:,:) real(kind=dp), intent(in) :: py (:,:) real(kind=dp), intent(in) :: pz (:,:) real(kind=dp), intent(in) :: e12 (:,:,:) real(kind=dp), intent(in) :: e12s (:,:) real(kind=dp), intent(in) :: e12max (:,:) real(kind=dp), intent(in) :: cmaxg (:) integer(kind=ikind), intent(in) :: ng real(kind=dp), intent(in) :: dmaxx real(kind=dp), intent(in) :: cutoffcentre real(kind=dp), intent(in) :: cutoffz real(kind=dp), intent(in) :: cutoffmd real(kind=dp), intent(in) :: screen_tol real(kind=dp), intent(inout) :: tsi (:) integer(kind=int64), intent(inout) :: nshq_tot integer(kind=int64), intent(inout) :: nshq_done integer(kind=int64), intent(inout) :: nquart_tot integer(kind=int64), intent(inout) :: nquart_done public  subroutine sort_desc (n, key, idx) idx = permutation that orders key descending (iterative merge sort, stable) Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: n real(kind=dp), intent(in) :: key (n) integer(kind=ikind), intent(out) :: idx (n) public  subroutine gemm_tn (dgemm, nk, ncol, n, a, b, z) z(1:ncol, 1:n) = a(1:nk, 1:ncol)&#94;T b(1:nk, 1:n), by BLAS dgemm when a pointer was given, else matmul Arguments Type Intent Optional Attributes Name procedure( dgemm_iface ), intent(in), pointer :: dgemm integer(kind=ikind), intent(in) :: nk integer(kind=ikind), intent(in) :: ncol integer(kind=ikind), intent(in) :: n real(kind=dp), intent(in) :: a (:,:) real(kind=dp), intent(in) :: b (:,:) real(kind=dp), intent(inout) :: z (:,:) public  subroutine coulomb_block (nkc, ncontr, ac, bc, posI, posJ, posK, posR, spi, spj, spk, spr, zc) Pair-density block of a shell quartet from the Coulomb-paired factored terms, Read more… Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nkc integer(kind=ikind), intent(in) :: ncontr real(kind=dp), intent(in) :: ac (nkc,ncontr,ncontr) real(kind=dp), intent(in) :: bc (nkc,ncontr,ncontr) integer(kind=ikind), intent(in) :: posI (:) integer(kind=ikind), intent(in) :: posJ (:) integer(kind=ikind), intent(in) :: posK (:) integer(kind=ikind), intent(in) :: posR (:) integer(kind=ikind), intent(in) :: spi integer(kind=ikind), intent(in) :: spj integer(kind=ikind), intent(in) :: spk integer(kind=ikind), intent(in) :: spr real(kind=dp), intent(inout) :: zc (:,:,:,:) public  subroutine quartet_coincident (nq, q, lorder, l, m, n, gs, gc, p0mat, dx1, dy1, dz1, dx2, dy2, dz2, gi, gj, gk, gr, zcontr, coeff1, coeff2, coeff3, coeff4, cutoff1, cutoff2, f) Pair centres coincide (h < cutoffcentre): tabulated limits Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: q (nq) integer(kind=ikind), intent(in) :: lorder integer(kind=ikind), intent(in) :: l (:) integer(kind=ikind), intent(in) :: m (:) integer(kind=ikind), intent(in) :: n (:) integer(kind=ikind), intent(in) :: gs (:) integer(kind=ikind), intent(in) :: gc (:) real(kind=dp), intent(in) :: p0mat (:,:,:,:) real(kind=dp), intent(in) :: dx1 (:,:,:) real(kind=dp), intent(in) :: dy1 (:,:,:) real(kind=dp), intent(in) :: dz1 (:,:,:) real(kind=dp), intent(in) :: dx2 (:,:,:) real(kind=dp), intent(in) :: dy2 (:,:,:) real(kind=dp), intent(in) :: dz2 (:,:,:) integer(kind=ikind), intent(in) :: gi integer(kind=ikind), intent(in) :: gj integer(kind=ikind), intent(in) :: gk integer(kind=ikind), intent(in) :: gr real(kind=dp), intent(in) :: zcontr (:,:,:,:) real(kind=dp), intent(in) :: coeff1 (:) real(kind=dp), intent(in) :: coeff2 (:) real(kind=dp), intent(in) :: coeff3 (:) real(kind=dp), intent(in) :: coeff4 (:) real(kind=dp), intent(in) :: cutoff1 real(kind=dp), intent(in) :: cutoff2 real(kind=dp), intent(out) :: f (nq) public  subroutine quartet_distant (mu, lorder, l, m, n, gs, gc, hx, hy, hz, h, dx1, dy1, dz1, dx2, dy2, dz2, gi, gj, gk, gr, zcontr, coeff1, coeff2, coeff3, coeff4, cutoff1, cutoff2, hpre, f) Distinct pair centres: derivatives of j0(q h) through the Bessel module Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in), allocatable :: mu (:) integer(kind=ikind), intent(in) :: lorder integer(kind=ikind), intent(in) :: l (:) integer(kind=ikind), intent(in) :: m (:) integer(kind=ikind), intent(in) :: n (:) integer(kind=ikind), intent(in) :: gs (:) integer(kind=ikind), intent(in) :: gc (:) real(kind=dp), intent(in) :: hx real(kind=dp), intent(in) :: hy real(kind=dp), intent(in) :: hz real(kind=dp), intent(in) :: h real(kind=dp), intent(in) :: dx1 (:,:,:) real(kind=dp), intent(in) :: dy1 (:,:,:) real(kind=dp), intent(in) :: dz1 (:,:,:) real(kind=dp), intent(in) :: dx2 (:,:,:) real(kind=dp), intent(in) :: dy2 (:,:,:) real(kind=dp), intent(in) :: dz2 (:,:,:) integer(kind=ikind), intent(in) :: gi integer(kind=ikind), intent(in) :: gj integer(kind=ikind), intent(in) :: gk integer(kind=ikind), intent(in) :: gr real(kind=dp), intent(in) :: zcontr (:,:,:,:) real(kind=dp), intent(in) :: coeff1 (:) real(kind=dp), intent(in) :: coeff2 (:) real(kind=dp), intent(in) :: coeff3 (:) real(kind=dp), intent(in) :: coeff4 (:) real(kind=dp), intent(in) :: cutoff1 real(kind=dp), intent(in) :: cutoff2 real(kind=dp), intent(inout) :: hpre (:,:,:,:) real(kind=dp), intent(out) :: f (size(mu)) public  subroutine combine_j2 (q, f, fzz) j2(q r) P2(cos theta) from j0 by the solid-harmonic (Hobson) theorem: Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: q (:) real(kind=dp), intent(inout) :: f (:) real(kind=dp), intent(in) :: fzz (:) public  subroutine p0_limits (p0, smax, q) Limits of the derivatives of j0(q h) at h = 0, any order: Read more… Arguments Type Intent Optional Attributes Name real(kind=dp), intent(out) :: p0 (:,:,:,:) integer(kind=ikind), intent(in) :: smax real(kind=dp), intent(in) :: q (:)","tags":"","url":"module/xs_kernel_j0.html"},{"title":"xs_rdm – PyXSCAT kernels","text":"PyXSCAT - spin-summed 1- and 2-RDMs of a determinant expansion, bitwise The determinant-pair (\"bitwise\") algorithm of the earlier code (twordm_jeremy.f90):\nevery pair (I, J) is screened with popcnt(ieor(.)) and only pairs differing by at\nmost two spin-orbitals contribute, through the Slater-Condon rules.  Cost ~ N_det&#94;2\nfor the screening (a few machine instructions per pair, OpenMP over I) plus the\ncoupled pairs; independent of the size of the full CI space. Any number of orbitals: each spin string is nw = ceil(norb / 64) 64-bit words\n(orbital k in word k/64, bit mod(k, 64)).  The RDMs are accumulated in thread-private\ncopies when nthreads x 8 norb&#94;4 bytes is small (< 2 GB), otherwise straight into the\nshared arrays with atomic updates (norb = 300: a 6.5 GB dm2, one copy). Conventions (as pyxscat.ci): determinant = alpha creators (ascending) then beta\ncreators (ascending) on the vacuum; dm1[p,q]     = sum_sigma <a+_{p sigma} a_{q sigma}>\n dm2[p,q,r,s] = sum_{sigma tau} <a+_{p sigma} a+_{r tau} a_{s tau} a_{q sigma}> (C order on the Python side: here d1(q,p) and d2(s,r,q,p)). Uses iso_fortran_env Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = real64 integer, private, parameter :: i8 = int64 integer, private, parameter :: maxocc = 1024 Derived Types type, private :: accum Components Type Visibility Attributes Name Initial logical, public :: atomic = .false. integer, public :: nint = -1 real(kind=dp), public, pointer :: a1 (:,:) => null() real(kind=dp), public, pointer :: a2 (:,:,:,:) => null() Functions private pure function count_below (w, nw, k) number of set bits of w(1:nw) below spin-orbital k (0-based) Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: w (nw) integer, intent(in) :: nw integer, intent(in) :: k Return Value integer private pure function before (wa, wb, nw, k, spin) sign (-1)&#94;(number of occupied spin-orbitals before (k, spin)) in alpha-first order Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: wa (nw) integer(kind=i8), intent(in) :: wb (nw) integer, intent(in) :: nw integer, intent(in) :: k integer, intent(in) :: spin Return Value integer private  function apply_op (wa, wb, nw, k, spin, create) apply a_k (create = .false.) or a+_k (create = .true.) to (wa, wb); returns the sign Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(inout) :: wa (nw) integer(kind=i8), intent(inout) :: wb (nw) integer, intent(in) :: nw integer, intent(in) :: k integer, intent(in) :: spin logical, intent(in) :: create Return Value integer private pure function first_bit (w, nw) first set bit of w(1:nw) (-1 if none) Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: w (nw) integer, intent(in) :: nw Return Value integer Subroutines private  subroutine bits (wa, wb, nw, orb, spn, n) the set spin-orbitals of the alpha and beta strings, as (orbital, spin) lists Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: wa (nw) integer(kind=i8), intent(in) :: wb (nw) integer, intent(in) :: nw integer, intent(out) :: orb (:) integer, intent(out) :: spn (:) integer, intent(out) :: n public  subroutine rdm12_bitwise (ndet, norb, nw, wa, wb, c, d1, d2, nthreads, ierr) Spin-summed d1 and d2 of the expansion with coefficients c over the determinants\n(wa(:, I), wb(:, I)), by the pair loop over all (I, J) on nthreads OpenMP threads.\nierr = 1 when a determinant has more than maxocc occupied spin-orbitals. Arguments Type Intent Optional Attributes Name integer, intent(in) :: ndet integer, intent(in) :: norb integer, intent(in) :: nw integer(kind=i8), intent(in) :: wa (nw,ndet) integer(kind=i8), intent(in) :: wb (nw,ndet) real(kind=dp), intent(in) :: c (ndet) real(kind=dp), intent(out), target :: d1 (norb,norb) real(kind=dp), intent(out), target :: d2 (norb,norb,norb,norb) integer, intent(in) :: nthreads integer, intent(out) :: ierr public  subroutine rdm12_bitwise_groups (ndet, norb, nw, wa, wb, c, nint, ng, gstart, grp, nnb, nbstart, nb, d1, d2, nthreads, ierr) The same pair loop restricted to candidate pairs: determinants are sorted into groups\n(contiguous, gstart(g):gstart(g+1)-1), and for group g only the groups\nnb(nbstart(g):nbstart(g+1)-1), all >= g, are paired with it (g itself first when it\nis to be included).  Elements of dm2 with all four orbitals >= nint are not accumulated\n(they are formed elsewhere); nint < 0 keeps them.  The (I, J) / (J, I) symmetrisation\nis applied as in rdm12_bitwise, so pairs must be listed once (g <= g'). Arguments Type Intent Optional Attributes Name integer, intent(in) :: ndet integer, intent(in) :: norb integer, intent(in) :: nw integer(kind=i8), intent(in) :: wa (nw,ndet) integer(kind=i8), intent(in) :: wb (nw,ndet) real(kind=dp), intent(in) :: c (ndet) integer, intent(in) :: nint integer, intent(in) :: ng integer, intent(in) :: gstart (ng+1) integer, intent(in) :: grp (ndet) integer, intent(in) :: nnb integer, intent(in) :: nbstart (ng+1) integer, intent(in) :: nb (nnb) real(kind=dp), intent(out), target :: d1 (norb,norb) real(kind=dp), intent(out), target :: d2 (norb,norb,norb,norb) integer, intent(in) :: nthreads integer, intent(out) :: ierr private  subroutine diagonal (wa, wb, nw, w, acc) Diagonal pair <I| ... |I> : dm1[k,k] += w; dm2[u,u,v,v] += w over ordered pairs u /= v of occupied\nspin-orbitals, dm2[u,v,v,u] -= w when u and v have the same spin Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: wa (nw) integer(kind=i8), intent(in) :: wb (nw) integer, intent(in) :: nw real(kind=dp), intent(in) :: w type( accum ), intent(inout) :: acc private  subroutine single (ia, ib, ja, jb, nw, w, acc) I = Phi a+_x a_h J (one spin-orbital differs); w = c_I c_J Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: ia (nw) integer(kind=i8), intent(in) :: ib (nw) integer(kind=i8), intent(in) :: ja (nw) integer(kind=i8), intent(in) :: jb (nw) integer, intent(in) :: nw real(kind=dp), intent(in) :: w type( accum ), intent(inout) :: acc private  subroutine double (ia, ib, ja, jb, nw, w, acc) I = Phi a+_p1 a+_p2 a_h2 a_h1 J (two spin-orbitals differ); w = c_I c_J Arguments Type Intent Optional Attributes Name integer(kind=i8), intent(in) :: ia (nw) integer(kind=i8), intent(in) :: ib (nw) integer(kind=i8), intent(in) :: ja (nw) integer(kind=i8), intent(in) :: jb (nw) integer, intent(in) :: nw real(kind=dp), intent(in) :: w type( accum ), intent(inout) :: acc private  subroutine add1 (acc, p, q, v) dm1[p,q] (0-based, C order) += v Arguments Type Intent Optional Attributes Name type( accum ), intent(inout) :: acc integer, intent(in) :: p integer, intent(in) :: q real(kind=dp), intent(in) :: v private  subroutine add2 (acc, p, q, r, s, v) dm2[p,q,r,s] (0-based orbitals, C order) += v Arguments Type Intent Optional Attributes Name type( accum ), intent(inout) :: acc integer, intent(in) :: p integer, intent(in) :: q integer, intent(in) :: r integer, intent(in) :: s real(kind=dp), intent(in) :: v","tags":"","url":"module/xs_rdm.html"},{"title":"xs_hermite – PyXSCAT kernels","text":"PyXSCAT - Hermite (McMurchie-Davidson) expansion coefficients For a pair of primitive shells A (centre xa, exponent a) and B (xb, b)\nthe product of two 1D Cartesian Gaussians is expanded in Hermite\nGaussians centred at P = (a xa + b xb)/(a + b): (x-xa)&#94;i (x-xb)&#94;j exp(-a(x-xa)&#94;2 - b(x-xb)&#94;2)\n      = K_ab  sum_t E(t; i, j) Lambda_t(x - P) The Gaussian prefactor K_ab is NOT included here (it is carried by the\npair prefactor of the kernel), so E(0; 0, 0) = 1. Two-term recurrences, valid for any angular momentum: E(t; i+1, j) = E(t-1; i, j)/(2p) + (P-xa) E(t; i, j) + (t+1) E(t+1; i, j)\n E(t; i, j+1) = E(t-1; i, j)/(2p) + (P-xb) E(t; i, j) + (t+1) E(t+1; i, j) This replaces the explicit tables of the original code (limited to g). Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) Subroutines public  subroutine hermite_table (ng, maxl, lg, xg, ag, dd) dd(t+1, i+1, j+1, gb, ga): coefficients for the shell pair (ga, gb),\ni <= lg(ga), j <= lg(gb).  The index order (.., gb, ga) is the one the\nkernel expects. Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: ng integer(kind=ikind), intent(in) :: maxl integer(kind=ikind), intent(in) :: lg (ng) real(kind=dp), intent(in) :: xg (ng) real(kind=dp), intent(in) :: ag (ng) real(kind=dp), intent(out) :: dd (2*maxl+1,maxl+1,maxl+1,ng,ng)","tags":"","url":"module/xs_hermite.html"},{"title":"xs_elastic – PyXSCAT kernels","text":"PyXSCAT - rotationally averaged elastic scattering by density-weighted pairs I(q) = sum_{mu nu la si} A_mu,nu B_la,si < chi_mu chi_nu | K_l(q r12) | chi_la chi_si > with K_0 = j0 (isotropic) or K_2 = j2 P2 (second Legendre moment about z).  A = B = D gives\nthe elastic scattering <|F(q)|&#94;2>; A /= B the coherent mixed (transition) terms (symmetrised). The pair density of the elastic term is a product, D (x) D, so the density can be folded into\neach primitive-shell pair BEFORE the pairs are combined: every pair becomes one Hermite charge\ndistribution W(tuv) at its centre P, rho_P(r) = (pi/p)&#94;{3/2} K_ab sum_tuv W(tuv) Lambda_tuv(r - P), and the elastic term is a sum over pairs of pairs, I(q) = sum_{P,Q} pref_P pref_Q exp(-q&#94;2/4p - q&#94;2/4p') sum_m S_m(P - Q) f_m(q, |P - Q|),\n S_m  = sum_{TUV} U(TUV) sum_{ijk: T+U+V-i-j-k = m} a(T,i) a(U,j) a(V,k) hx&#94;(T-2i) hy&#94;(U-2j) hz&#94;(V-2k),\n U(TUV) = sum_{tuv + t'u'v' = TUV} W_P(tuv) W_Q(t'u'v') (-1)&#94;(t'+u'+v'),\n f_m  = (-q&#94;2)&#94;m j_m(qh)/(qh)&#94;m. Compared with the quartet kernel (which must loop over every Cartesian component of the four\nfunctions because a general 2RDM does not factorise), the work per pair of pairs is one\nconvolution of two Hermite tables and one radial sum.  The radial functions j_m(x)/x&#94;m are\nevaluated stably at every x, so coincident and nearly coincident pair centres need no\nspecial treatment and lose no digits. Uses xs_radial iso_fortran_env xs_pairft Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) Subroutines public  subroutine elastic_pairs (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, da, db, lorder, screen, res, npairs_out, ierr) I(q) at every q for the one-particle matrices da, db (elastic for da = db, coherent mixed\notherwise), K_0 for lorder = 0 and K_2 for lorder = 2, by the pair-of-pairs algorithm of the\nmodule description.  Pairs whose bound is below screen are dropped; npairs_out returns the\nnumber of significant pairs and of pairs of pairs evaluated; ierr = 0 on success. Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: nao integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: q (nq) real(kind=dp), intent(in) :: da (nao,nao) real(kind=dp), intent(in) :: db (nao,nao) integer(kind=ikind), intent(in) :: lorder real(kind=dp), intent(in) :: screen real(kind=dp), intent(out) :: res (nq) real(kind=dp), intent(out) :: npairs_out (2) integer(kind=ikind), intent(out) :: ierr","tags":"","url":"module/xs_elastic.html"},{"title":"xs_nuclear – PyXSCAT kernels","text":"PyXSCAT - electron-nucleus term of electron scattering In the first Born approximation a fast electron is scattered by the full\ncharge distribution, nuclei and electrons: dsigma/dOmega = 4 / (a0&#94;2 q&#94;4) < | sum_A Z_A exp(iq.R_A) - F(q) |&#94;2 >  + inelastic which, rotationally averaged, needs one quantity beyond X-ray scattering,\nthe electron-nucleus cross term I_ne(q) = sum_A Z_A sum_mu,nu D_mu,nu int chi_mu chi_nu K_l(q, r - R_A) dr with K_0 = j0(q|h|) (isotropic signal) or K_2 = j2(q|h|) P2(cos theta_h)\n(second Legendre moment about z, aligned molecules). Each primitive pair is expanded in Hermite Gaussians at the pair centre P: int Lambda_tuv(r - P) j0(q|r - A|) dr = (pi/p)&#94;{3/2} exp(-q&#94;2/4p) d&#94;{t+u+v}/dh&#94;tuv j0(q|h|),\n h = P - A, and the Cartesian derivatives of the radial function j0(q|h|) follow from\nthe McMurchie-Davidson recursion with the auxiliary functions f_n(h) = (1/h d/dh)&#94;n j0(q h) = (-q&#94;2)&#94;n j_n(qh) / (qh)&#94;n. j2 P2 follows from Hobson's theorem: j2(qh) P2(cos theta) = [3 d&#94;2/dhz&#94;2 + q&#94;2] j0(qh) / (2 q&#94;2).\nNothing is singular when a nucleus sits on a pair centre (h = 0). Uses xs_radial xs_pairft Variables Type Visibility Attributes Name Initial integer, private, parameter :: dp = selected_real_kind(15) integer, private, parameter :: ikind = selected_int_kind(8) Subroutines public pure subroutine j0_derivatives (q, hx, hy, hz, lmax, ldim, idx, ntuv, r) Hermite derivatives R(k) = d&#94;{t+u+v}/dh_x&#94;t dh_y&#94;u dh_z&#94;v j0(q|h|) for t+u+v <= lmax,\npacked by idx(t,u,v). Arguments Type Intent Optional Attributes Name real(kind=dp), intent(in) :: q real(kind=dp), intent(in) :: hx real(kind=dp), intent(in) :: hy real(kind=dp), intent(in) :: hz integer(kind=ikind), intent(in) :: lmax integer(kind=ikind), intent(in) :: ldim integer(kind=ikind), intent(in) :: idx (0:ldim,0:ldim,0:ldim) integer(kind=ikind), intent(in) :: ntuv real(kind=dp), intent(out) :: r (ntuv) public  subroutine electron_nucleus (nprim, nao, nq, x, y, z, ga, l, m, n, group, contr, coeff, q, natom, zat, rat, dm, lorder, screen, res, ierr) I_ne(q) = sum_A zat(A) sum_mu,nu dm(mu,nu) int chi_mu chi_nu K_lorder(q, r - R_A) dr Arguments Type Intent Optional Attributes Name integer(kind=ikind), intent(in) :: nprim integer(kind=ikind), intent(in) :: nao integer(kind=ikind), intent(in) :: nq real(kind=dp), intent(in) :: x (nprim) real(kind=dp), intent(in) :: y (nprim) real(kind=dp), intent(in) :: z (nprim) real(kind=dp), intent(in) :: ga (nprim) integer(kind=ikind), intent(in) :: l (nprim) integer(kind=ikind), intent(in) :: m (nprim) integer(kind=ikind), intent(in) :: n (nprim) integer(kind=ikind), intent(in) :: group (nprim) integer(kind=ikind), intent(in) :: contr (nprim) real(kind=dp), intent(in) :: coeff (nprim) real(kind=dp), intent(in) :: q (nq) integer(kind=ikind), intent(in) :: natom real(kind=dp), intent(in) :: zat (natom) real(kind=dp), intent(in) :: rat (3,natom) real(kind=dp), intent(in) :: dm (nao,nao) integer(kind=ikind), intent(in) :: lorder real(kind=dp), intent(in) :: screen real(kind=dp), intent(out) :: res (nq) integer(kind=ikind), intent(out) :: ierr","tags":"","url":"module/xs_nuclear.html"},{"title":"xs_p0.f90 – PyXSCAT kernels","text":"Source Code ! Part of THISTLE (kernel library pyxscat). ! SPDX-License-Identifier: Apache-2.0 ! Copyright 2026 Andres Moreno Carrascosa ! Authors: A. Moreno Carrascosa, M. Simmermacher, P. Y. Wang, E. Moen Liane, J. Cooper, N. Zotev, T. Northey, A. Kirrander !> Closed forms of the rotational averages `<qx&#94;L qy&#94;M qz&#94;N>` (the h = 0 limits of the quartet !> kernel) for the Legendre terms j0, j1 and j2, and the constructors of the P0 tables. Module p0_cases implicit none contains !> Fills P0(:, L+1, M+1, N+1) = `<qx&#94;L qy&#94;M qz&#94;N>` (j0 case) for all L, M, N <= lmax4 with L+M+N <= 16. SUBROUTINE set_P0 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 ! Fill the current LMN if (( i + j + k ) <= 16 ) then CALL P_LMN ( P0 , i , j , k , q ) endif end do end do end do END SUBROUTINE set_P0 !> The same table for the j2 P2 term, scaled by sqrt(5/pi). SUBROUTINE set_P0_j2 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:) :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k p0 = 0.0_dp ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 if (( i + j + k ) < 16 ) then ! Fill the current LMN CALL P_LMN_j2 ( P0 , k , j , i , q ) end if end do end do end do P0 = P0 * sqrt ( 5.0_dp / dacos ( - 1.0_dp )) END SUBROUTINE set_P0_j2 !> The same table for the j1 term, scaled by sqrt(3/pi). SUBROUTINE set_P0_j1 ( P0 , lmax4 , q ) ! P0    (Nq,4lmax+1,4lmax+1,4lmax+1) will store the values of <qx&#94;L*qy&#94;M*qz&#94;N> !   for all possible combinations of angular momenta of the 4 GTOs (L,M,N) INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) REAL ( KIND = dp ), INTENT ( OUT ), DIMENSION (:,:,:,:) :: P0 ! the maximum value of the orbital angular momentum of any GTO times 4 INTEGER ( KIND = ikind ), INTENT ( IN ) :: lmax4 ! the radial component of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! loop variables INTEGER ( KIND = ikind ) :: i , j , k p0 = 0.0_dp ! loop for all combinations of angular momenta do k = 0 , lmax4 do j = 0 , lmax4 do i = 0 , lmax4 if (( i + j + k ) <= 16 ) then ! Fill the current LMN CALL P_LMN_j1 ( P0 , k , j , i , q ) end if end do end do end do P0 = P0 * sqrt ( 3.0_dp / dacos ( - 1.0_dp )) END SUBROUTINE set_P0_j1 !> One entry (L, M, N) of the j0 table at every q: the closed-form cases. SUBROUTINE P_LMN ( P0 , L , M , N , q ) ! the three values of the angular momentum INTEGER , PARAMETER :: dp = SELECTED_REAL_KIND ( 15 ) INTEGER , PARAMETER :: ikind = SELECTED_INT_KIND ( 8 ) INTEGER ( KIND = ikind ), INTENT ( IN ) :: L , M , N ! The value of <qx&#94;L*qy&#94;M*qz&#94;N> REAL ( KIND = dp ), INTENT ( INOUT ), DIMENSION (:,:,:,:) :: P0 ! The radial part of the scattering vector REAL ( KIND = dp ), INTENT ( IN ), DIMENSION (:), allocatable :: q ! For ordering INTEGER ( KIND = ikind ), DIMENSION ( 1 : 3 ) :: A ! helper variable !INTEGER(KIND=ikind) :: i ! Order L, M and N A ( 1 ) = L A ( 2 ) = M A ( 3 ) = N CALL Bubble_Sort ( A ) ! These are analytical solutions to the limits of the derivatives of j_0. ! They were generated in Wolfram Mathematica 13.1 by Mats Simmermacher in July 2023. if ( mod ( L , 2 ) /= 0 . or . mod ( M , 2 ) /= 0 . or . mod ( N , 2 ) /= 0 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = 0.0_dp elseif ( sum ( A ) == 0 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = 1.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 2 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( - 1.0_dp / 3.0_dp ) * q ** 2.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 2 . and . A ( 3 ) == 2 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = ( 1.0_dp / 1 5.0_dp ) * q ** 4.0_dp elseif ( A ( 1 ) == 0 . and . A ( 2 ) == 0 . and . A ( 3 ) == 4 ) then P0 (:, L + 1 , M + 1 , N + 1 ) = 